<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Disabled State -->
    <item android:state_enabled="false" android:color="?attr/colorOnSurface" android:alpha="0.12" />
    <!-- Pressed / Focused State -->
    <item android:state_pressed="true" android:color="?attr/colorPrimary" android:alpha="0.8" />
    <item android:state_focused="true" android:color="?attr/colorPrimary" android:alpha="0.8" />
    <!-- Normal State -->
    <item android:color="?attr/colorPrimary" />
</selector>