<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- LỚP 1: Nền Surface dưới cùng -->
    <item>
        <color android:color="?attr/colorSurfaceVariant" />
    </item>

    <!-- LỚP 2: Nền Gradient chính (Góc 135 độ tương đương chéo từ trên xuống) -->
    <item>
        <shape android:shape="rectangle">
            <gradient
                android:angle="135"
                android:startColor="?attr/colorPrimary"
                android:endColor="?attr/colorSecondary"
                android:type="linear" />
        </shape>
    </item>

    <!-- LỚP 3: Dải đường nghiêng gradient nhẹ ở góc phải trên -->
    <item
        android:top="-60dp"
        android:right="-100dp"
        android:width="400dp"
        android:height="200dp">
        <rotate
            android:fromDegrees="-22"
            android:pivotX="50%"
            android:pivotY="50%">
            <shape android:shape="rectangle">
                <gradient
                    android:angle="90"
                    android:startColor="#33FFFFFF"
                    android:endColor="#00FFFFFF"
                    android:type="linear" />
            </shape>
        </rotate>
    </item>

    <!-- LỚP 4: Dải đường nghiêng giữa màn hình -->
    <item
        android:left="-120dp"
        android:top="40dp"
        android:width="500dp"
        android:height="150dp">
        <rotate
            android:fromDegrees="-12"
            android:pivotX="50%"
            android:pivotY="50%">
            <shape android:shape="rectangle">
                <gradient
                    android:angle="45"
                    android:startColor="#20FFFFFF"
                    android:endColor="#00FFFFFF"
                    android:type="linear" />
            </shape>
        </rotate>
    </item>

</layer-list>