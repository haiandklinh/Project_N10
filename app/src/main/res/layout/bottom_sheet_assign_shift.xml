<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_bottom_sheet"
    android:orientation="vertical"
    android:paddingHorizontal="@dimen/spacing_xl"
    android:paddingBottom="@dimen/spacing_2xl">

    <!-- Drag handle -->
    <View
        android:layout_width="30dp"
        android:layout_height="4dp"
        android:layout_gravity="center_horizontal"
        android:layout_marginTop="@dimen/spacing_s"
        android:background="@drawable/bg_handle" />

    <TextView
        android:id="@+id/tv_title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center_horizontal"
        android:layout_marginTop="@dimen/spacing_xl"
        android:text="Xếp ca cho nhân viên"
        android:textSize="@dimen/text_size_title_medium"
        android:textStyle="bold"
        tools:text="Xếp ca cho Trần Thị Bình" />

    <TextView
        android:id="@+id/tv_subtitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center_horizontal"
        android:layout_marginTop="@dimen/spacing_3xs"
        android:textColor="?attr/colorOnSurfaceVariant"
        android:textSize="@dimen/text_size_body_medium"
        tools:text="Thứ Năm, 24/09/2026" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/spacing_xl"
        android:text="Chọn ca làm cố định"
        android:textStyle="bold"
        android:textSize="@dimen/text_size_label_large" />

    <!-- CA SÁNG -->
    <com.google.android.material.card.MaterialCardView
        android:id="@+id/card_shift_morning"
        style="@style/ItemCard"
        app:strokeWidth="@dimen/border_width_m"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/spacing_m">

        <include layout="@layout/layout_shift_option_row"
            android:id="@+id/row_morning" />
    </com.google.android.material.card.MaterialCardView>

    <!-- CA CHIỀU -->
    <com.google.android.material.card.MaterialCardView
        android:id="@+id/card_shift_afternoon"
        style="@style/ItemCard"
        app:strokeWidth="@dimen/border_width_m"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/spacing_s">

        <include layout="@layout/layout_shift_option_row"
            android:id="@+id/row_afternoon" />
    </com.google.android.material.card.MaterialCardView>

    <!-- CA TỐI -->
    <com.google.android.material.card.MaterialCardView
        android:id="@+id/card_shift_night"
        style="@style/ItemCard"
        app:strokeWidth="@dimen/border_width_m"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/spacing_s">

        <include layout="@layout/layout_shift_option_row"
            android:id="@+id/row_night" />
    </com.google.android.material.card.MaterialCardView>

    <!-- KHÔNG XẾP CA -->
    <com.google.android.material.card.MaterialCardView
        android:id="@+id/card_shift_none"
        style="@style/ItemCard"
        app:strokeWidth="@dimen/border_width_m"
        app:cardBackgroundColor="?attr/colorSurfaceVariant"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/spacing_s">

        <include layout="@layout/layout_shift_option_row"
            android:id="@+id/row_none" />
    </com.google.android.material.card.MaterialCardView>

    <!-- Buttons -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/spacing_2xl"
        android:orientation="horizontal">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_cancel"
            style="@style/ButtonOutlinedSmallStyle"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginEnd="@dimen/spacing_s"
            android:text="Hủy" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_confirm"
            style="@style/ButtonFilledSmallStyle"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Xác nhận xếp ca" />
    </LinearLayout>

</LinearLayout>
