<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?android:attr/colorBackground">

    <com.example.attendanceapp.core.utils.ToolbarApp
        android:id="@+id/layout_toolbar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <androidx.core.widget.NestedScrollView
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:fillViewport="true"
        android:overScrollMode="never"
        app:layout_constraintTop_toBottomOf="@id/layout_toolbar"
        app:layout_constraintBottom_toTopOf="@id/layout_bottom_actions"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="@dimen/spacing_l">

            <!-- NHÓM 1: TỔ CHỨC & CHỨC DẠNH -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Tổ chức &amp; Chức danh"
                android:textStyle="bold"
                android:textColor="?attr/colorPrimary"
                android:layout_marginBottom="@dimen/spacing_s"/>

            <com.google.android.material.textfield.TextInputLayout
                style="@style/AppTextInputLayout"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="Chức danh / Vị trí công việc"
                app:endIconMode="custom"
                app:endIconDrawable="@drawable/ic_lock"
                android:layout_marginBottom="@dimen/spacing_m">
                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/et_job_title"
                    style="@style/AppTextInputEditText"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:enabled="false"
                    android:text="Lập trình viên Android" />
            </com.google.android.material.textfield.TextInputLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:baselineAligned="false"
                android:layout_marginBottom="@dimen/spacing_m">

                <com.google.android.material.textfield.TextInputLayout
                    style="@style/AppTextInputLayout"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:hint="Phòng ban / Bộ phận"
                    app:endIconMode="custom"
                    app:endIconDrawable="@drawable/ic_lock"
                    android:layout_marginEnd="@dimen/spacing_s">
                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/et_department"
                        style="@style/AppTextInputEditText"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:enabled="false"
                        android:text="Phát triển Phần mềm" />
                </com.google.android.material.textfield.TextInputLayout>

                <com.google.android.material.textfield.TextInputLayout
                    style="@style/AppTextInputLayout"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:hint="Quản lý trực tiếp"
                    app:endIconMode="custom"
                    app:endIconDrawable="@drawable/ic_lock">
                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/et_manager"
                        style="@style/AppTextInputEditText"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:enabled="false"
                        android:text="Trần Văn B" />
                </com.google.android.material.textfield.TextInputLayout>
            </LinearLayout>

            <!-- NHÓM 2: CHẾ ĐỘ LÀM VIỆC & QUY TẮC CHẤM CÔNG -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Chế độ làm việc &amp; Chấm công"
                android:textStyle="bold"
                android:textColor="?attr/colorPrimary"
                android:layout_marginTop="@dimen/spacing_m"
                android:layout_marginBottom="@dimen/spacing_s"/>

            <com.google.android.material.textfield.TextInputLayout
                style="@style/AppTextInputLayout"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="Loại hợp đồng"
                app:endIconMode="custom"
                app:endIconDrawable="@drawable/ic_lock"
                android:layout_marginBottom="@dimen/spacing_m">
                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/et_contract_type"
                    style="@style/AppTextInputEditText"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:enabled="false"
                    android:text="Hợp đồng chính thức" />
            </com.google.android.material.textfield.TextInputLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:baselineAligned="false"
                android:layout_marginBottom="@dimen/spacing_m">

                <com.google.android.material.textfield.TextInputLayout
                    style="@style/AppTextInputLayout"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:hint="Ca làm việc áp dụng"
                    app:endIconMode="custom"
                    app:endIconDrawable="@drawable/ic_lock"
                    android:layout_marginEnd="@dimen/spacing_s">
                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/et_work_shift"
                        style="@style/AppTextInputEditText"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:enabled="false"
                        android:text="Hành chính (08:00 - 17:30)" />
                </com.google.android.material.textfield.TextInputLayout>

                <com.google.android.material.textfield.TextInputLayout
                    style="@style/AppTextInputLayout"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:hint="Địa điểm chấm công"
                    app:endIconMode="custom"
                    app:endIconDrawable="@drawable/ic_lock">
                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/et_work_location"
                        style="@style/AppTextInputEditText"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:enabled="false"
                        android:text="Trụ sở chính" />
                </com.google.android.material.textfield.TextInputLayout>
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:baselineAligned="false"
                android:layout_marginBottom="@dimen/spacing_l">

                <com.google.android.material.textfield.TextInputLayout
                    style="@style/AppTextInputLayout"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:hint="Ngày bắt đầu làm"
                    app:endIconMode="custom"
                    app:endIconDrawable="@drawable/ic_lock"
                    android:layout_marginEnd="@dimen/spacing_s">
                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/et_start_date"
                        style="@style/AppTextInputEditText"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:enabled="false"
                        android:text="01/06/2024" />
                </com.google.android.material.textfield.TextInputLayout>

                <com.google.android.material.textfield.TextInputLayout
                    style="@style/AppTextInputLayout"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:hint="Ngày hết hạn HĐ"
                    app:endIconMode="custom"
                    app:endIconDrawable="@drawable/ic_lock">
                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/et_end_date"
                        style="@style/AppTextInputEditText"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:enabled="false"
                        android:text="01/06/2026" />
                </com.google.android.material.textfield.TextInputLayout>
            </LinearLayout>

            <!-- Nút gửi yêu cầu thay đổi dành cho Nhân viên (nếu thấy HR nhập sai) -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_request_change"
                style="@style/Widget.Material3.Button.TextButton"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Báo sai sót / Yêu cầu HR cập nhật thông tin"
                app:icon="@drawable/ic_form" />

            <!-- Nút xóa (chỉ dành cho Admin / Quản lý) -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_delete_job_info"
                style="@style/Widget.Material3.Button.TextButton"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Xóa hồ sơ công việc này"
                android:textColor="?attr/colorError"
                android:visibility="gone"
                app:icon="@drawable/ic_delete"
                app:iconTint="?attr/colorError"
                tools:visibility="visible" />

        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

    <!-- CONTAINER NÚT LƯU CHO ADMIN / HR (Mặc định GONE đối với nhân viên) -->
    <com.google.android.material.card.MaterialCardView
        android:id="@+id/layout_bottom_actions"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:visibility="gone"
        app:cardElevation="0dp"
        app:cardCornerRadius="0dp"
        app:layout_constraintBottom_toBottomOf="parent"
        tools:visibility="visible">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_save_job_info"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:layout_margin="@dimen/spacing_m"
            android:text="Lưu thay đổi (Admin/HR)" />
    </com.google.android.material.card.MaterialCardView>

</androidx.constraintlayout.widget.ConstraintLayout>