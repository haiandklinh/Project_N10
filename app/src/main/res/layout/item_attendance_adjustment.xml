<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginHorizontal="@dimen/spacing_m"
    android:layout_marginBottom="@dimen/spacing_m"
    style="@style/ItemCard">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="@dimen/spacing_l">

        <!-- Badge Loại điều chỉnh (Ví dụ: Thiếu check-in) -->
        <com.google.android.material.chip.Chip
            android:id="@+id/tv_reason_type"
            style="@style/ChipStatusStyle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="?attr/colorPrimary"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            tools:text="Thiếu check-in" />

        <!-- Badge Trạng thái (Ví dụ: Chờ duyệt) -->
        <com.google.android.material.chip.Chip
            android:id="@+id/tv_status"
            style="@style/ChipStatusStyle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textSize="@dimen/text_size_label_small"
            android:textStyle="bold"
            app:layout_constraintBottom_toBottomOf="@+id/tv_reason_type"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            tools:text="Chờ duyệt" />

        <!-- Ngày cần điều chỉnh -->
        <TextView
            android:id="@+id/tv_request_date"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/spacing_m"
            android:textColor="?attr/colorOnSurface"
            style="@style/BodyTextLargeStyle"
            android:textStyle="bold"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/tv_reason_type"
            tools:text="Thứ Năm, 10/09/2026" />

        <!-- Layout Giờ Check-in / Check-out -->
        <LinearLayout
            android:id="@+id/layout_times"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/spacing_s"
            android:orientation="horizontal"
            app:layout_constraintTop_toBottomOf="@id/tv_request_date">

            <!-- Check-in Block -->
            <!-- Check-in Block Card -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/container_check_in"
                style="@style/Widget.Material3.CardView.Filled"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginEnd="@dimen/spacing_s"
                app:cardBackgroundColor="@color/attendance_present_container"
                app:cardCornerRadius="@dimen/radius_m"
                app:cardElevation="0dp"
                app:strokeWidth="0dp">

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:gravity="center"
                    android:orientation="vertical"
                    android:paddingHorizontal="@dimen/spacing_m"
                    android:paddingVertical="@dimen/spacing_2xs">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Check-in"
                        android:textColor="@color/attendance_present"
                        android:textSize="@dimen/text_size_label_small" />

                    <TextView
                        android:id="@+id/tv_check_in_time"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textColor="@color/attendance_present"
                        android:textSize="@dimen/text_size_body_medium"
                        android:textStyle="bold"
                        tools:text="08:05" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Check-out Block Card -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/container_check_out"
                style="@style/Widget.Material3.CardView.Filled"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:visibility="gone"
                app:cardBackgroundColor="@color/attendance_early_leave_container"
                app:cardCornerRadius="@dimen/radius_m"
                app:cardElevation="0dp"
                app:strokeWidth="0dp"
                tools:visibility="visible">

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:gravity="center"
                    android:orientation="vertical"
                    android:paddingHorizontal="@dimen/spacing_m"
                    android:paddingVertical="@dimen/spacing_2xs">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Check-out"
                        android:textColor="@color/attendance_early_leave"
                        android:textSize="@dimen/text_size_label_small" />

                    <TextView
                        android:id="@+id/tv_check_out_time"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textColor="@color/attendance_early_leave"
                        android:textSize="@dimen/text_size_body_medium"
                        android:textStyle="bold"
                        tools:text="17:30" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

        </LinearLayout>

        <!-- Lý do chi tiết -->
        <TextView
            android:id="@+id/tv_reason_detail"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/spacing_m"
            android:textColor="?attr/colorOnSurfaceVariant"
            android:background="@drawable/bg_otp_box"
            android:padding="@dimen/spacing_s"
            style="@style/BodyTextMediumStyle"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/layout_times"
            tools:text="Quên chấm công vào do họp khách hàng ngay đầu giờ sáng, có thể xác nhận qua lịch Google Meet." />

        <!-- Ngày gửi -->
        <TextView
            android:id="@+id/tv_send"
            style="@style/BodyTextSmallStyle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/spacing_s"
            android:text="Ngày gửi: "
            android:textColor="?attr/colorOnSurfaceVariant"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/tv_reason_detail" />

        <TextView
            android:id="@+id/tv_created_date"
            style="@style/BodyTextSmallStyle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="?attr/colorOnSurfaceVariant"
            app:layout_constraintBaseline_toBaselineOf="@id/tv_send"
            app:layout_constraintStart_toEndOf="@id/tv_send"
            tools:text="11/9/2026" />

    </androidx.constraintlayout.widget.ConstraintLayout>
</com.google.android.material.card.MaterialCardView>