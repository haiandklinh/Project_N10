<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/card_upcoming_shift"
    style="@style/ItemCard"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="@dimen/spacing_s"
    android:checkable="true"
    android:clickable="true"
    android:focusable="true"
    android:foreground="?attr/selectableItemBackground">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="@dimen/spacing_m">

        <!-- ICON CONTAINER -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/card_shift_icon"
            style="@style/IconViewCard"
            android:layout_width="@dimen/icon_container_l"
            android:layout_height="@dimen/icon_container_l"
            app:cardBackgroundColor="?attr/colorPrimaryContainer"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent">

            <ImageView
                android:layout_width="@dimen/icon_size_l"
                android:layout_height="@dimen/icon_size_l"
                android:layout_gravity="center"
                android:contentDescription="@null"
                android:src="@drawable/ic_schedule"
                app:tint="?attr/colorPrimary" />

        </com.google.android.material.card.MaterialCardView>

        <!-- 1. TÊN CA (Hàng 1) -->
        <TextView
            android:id="@+id/tv_shift_name"
            style="@style/BodyTextMediumStyle"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/spacing_m"
            android:ellipsize="end"
            android:maxLines="1"
            android:textStyle="bold"
            app:layout_constraintEnd_toStartOf="@id/tv_shift_time"
            app:layout_constraintStart_toEndOf="@id/card_shift_icon"
            app:layout_constraintTop_toTopOf="parent"
            tools:text="Ca Sáng" />

        <!-- 2. NGÀY THÁNG (Hàng 2) -->
        <TextView
            android:id="@+id/tv_shift_date"
            style="@style/BodyTextSmallStyle"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/spacing_m"
            android:layout_marginTop="2dp"
            android:ellipsize="end"
            android:maxLines="1"
            app:layout_constraintEnd_toStartOf="@id/tv_shift_time"
            app:layout_constraintStart_toEndOf="@id/card_shift_icon"
            app:layout_constraintTop_toBottomOf="@id/tv_shift_name"
            tools:text="Thứ 4, 02/09" />

        <!-- 3. ĐỊA ĐIỂM (Hàng 3) -->
        <TextView
            android:id="@+id/tv_shift_location"
            style="@style/BodyTextSmallStyle"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/spacing_m"
            android:layout_marginTop="2dp"
            android:ellipsize="end"
            android:maxLines="1"
            app:layout_constraintEnd_toStartOf="@id/tv_shift_time"
            app:layout_constraintStart_toEndOf="@id/card_shift_icon"
            app:layout_constraintTop_toBottomOf="@id/tv_shift_date"
            tools:text="Văn phòng chính · Tầng 3" />

        <!-- 4. THỜI GIAN (Cột bên phải) -->
        <TextView
            android:id="@+id/tv_shift_time"
            style="@style/TitleTextSmallStyle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="?attr/colorPrimary"
            android:textStyle="bold"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            tools:text="08:00 - 17:30" />

    </androidx.constraintlayout.widget.ConstraintLayout>

</com.google.android.material.card.MaterialCardView>