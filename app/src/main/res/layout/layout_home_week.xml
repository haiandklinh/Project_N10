<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">

    <!-- ==================== TỔNG QUAN TUẦN ==================== -->
    <TextView
        android:id="@+id/tv_week_label"
        style="@style/TitleTextMediumStyle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Lịch tuần này"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rv_week_days"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:clipToPadding="false"
        android:nestedScrollingEnabled="false"
        android:layout_marginTop="@dimen/spacing_s"
        app:layout_constraintTop_toBottomOf="@id/tv_week_label"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        tools:itemCount="7"
        tools:listitem="@layout/item_home_week_day"
        tools:layoutManager="androidx.recyclerview.widget.GridLayoutManager"
        tools:spanCount="7" />

</androidx.constraintlayout.widget.ConstraintLayout>
