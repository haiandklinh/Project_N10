<?xml version="1.0" encoding="utf-8"?>
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">

    <!-- Màu nền đỏ -->
    <solid android:color="?attr/colorAttendanceAbsent" />

    <!-- Viền trắng/nền xung quanh dày 2dp -->
    <stroke
        android:width="2dp"
        android:color="?attr/colorSurface" />

    <!-- Bo tròn dạng hình con nhộng/tròn -->
    <corners android:radius="@dimen/radius_full" />
</shape>