<?xml version="1.0" encoding="utf-8"?>
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">

    <!-- Màu nền của Dialog (Tự điều chỉnh theo Theme sáng/tối) -->
    <solid android:color="?attr/colorSurface" />

    <!-- Bo tròn các góc của Dialog -->
    <corners android:radius="@dimen/radius_xl" />

    <!-- Viền nhẹ quanh Dialog để tách biệt khỏi lớp mờ phía sau -->
    <stroke
        android:width="1dp"
        android:color="?attr/colorOutlineVariant" />

    <!-- Padding an toàn cho nội dung bên trong -->
    <padding
        android:bottom="@dimen/spacing_s"
        android:left="@dimen/spacing_s"
        android:right="@dimen/spacing_s"
        android:top="@dimen/spacing_s" />
</shape>