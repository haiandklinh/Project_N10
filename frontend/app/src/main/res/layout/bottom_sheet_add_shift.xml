<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_bottom_sheet"
    android:padding="@dimen/spacing_m">

    <!-- Drag handle -->
    <View
        android:id="@+id/drag_handle"
        android:layout_width="32dp"
        android:layout_height="4dp"
        android:background="@drawable/bg_handle"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- Header -->
    <TextView
        android:id="@+id/tv_title"
        style="@style/TitleTextMediumStyle"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/spacing_m"
        android:text="Tạo ca làm việc"
        android:textColor="?attr/colorOnSurface"
        android:textStyle="bold"
        app:layout_constraintTop_toBottomOf="@id/drag_handle"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <TextView
        android:id="@+id/tv_subtitle"
        style="@style/BodyTextSmallStyle"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/spacing_xs"
        android:text="Thiết lập thời gian và điều kiện chấm công"
        android:textColor="?attr/colorOnSurfaceVariant"
        app:layout_constraintTop_toBottomOf="@id/tv_title"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- 1. Tên ca -->
    <com.google.android.material.textfield.TextInputLayout
        android:id="@+id/til_shift_name"
        style="@style/AppTextInputLayout"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/spacing_l"
        android:hint="Tên ca làm việc"
        app:startIconDrawable="@drawable/ic_schedule"
        app:layout_constraintTop_toBottomOf="@id/tv_subtitle"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <com.google.android.material.textfield.TextInputEditText
            android:id="@+id/edt_shift_name"
            style="@style/AppTextInputEditText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:inputType="textCapSentences"
            android:maxLines="1"
            android:imeOptions="actionNext"
            tools:text="Ca sáng" />
    </com.google.android.material.textfield.TextInputLayout>

    <!-- 2. Thời gian làm việc -->
    <TextView
        android:id="@+id/tv_time_section"
        style="@style/BodyTextMediumStyle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/spacing_l"
        android:text="Thời gian làm việc"
        android:textColor="?attr/colorOnSurface"
        android:textStyle="bold"
        app:layout_constraintTop_toBottomOf="@id/til_shift_name"
        app:layout_constraintStart_toStartOf="parent" />

    <!-- Giờ bắt đầu -->
    <com.google.android.material.textfield.TextInputLayout
        android:id="@+id/til_start_time"
        style="@style/AppTextInputLayout"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/spacing_s"
        android:layout_marginEnd="@dimen/spacing_xs"
        android:hint="Giờ bắt đầu"
        app:endIconDrawable="@drawable/ic_history"
        app:endIconMode="custom"
        app:layout_constraintTop_toBottomOf="@id/tv_time_section"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toStartOf="@id/til_end_time">

        <com.google.android.material.textfield.TextInputEditText
            android:id="@+id/edt_start_time"
            style="@style/AppTextInputEditText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:focusable="false"
            android:clickable="true"
            android:cursorVisible="false"
            android:inputType="none"
            tools:text="08:00" />
    </com.google.android.material.textfield.TextInputLayout>

    <!-- Giờ kết thúc -->
    <com.google.android.material.textfield.TextInputLayout
        android:id="@+id/til_end_time"
        style="@style/AppTextInputLayout"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/spacing_s"
        android:layout_marginStart="@dimen/spacing_xs"
        android:hint="Giờ kết thúc"
        app:endIconDrawable="@drawable/ic_history"
        app:endIconMode="custom"
        app:layout_constraintTop_toBottomOf="@id/tv_time_section"
        app:layout_constraintStart_toEndOf="@id/til_start_time"
        app:layout_constraintEnd_toEndOf="parent">

        <com.google.android.material.textfield.TextInputEditText
            android:id="@+id/edt_end_time"
            style="@style/AppTextInputEditText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:focusable="false"
            android:clickable="true"
            android:cursorVisible="false"
            android:inputType="none"
            tools:text="17:30" />
    </com.google.android.material.textfield.TextInputLayout>

    <!-- 3. Cho phép check-in -->
    <com.google.android.material.textfield.TextInputLayout
        android:id="@+id/til_allowed_check_in_time"
        style="@style/AppTextInputLayout"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/spacing_m"
        android:hint="Thời điểm cho phép check-in"
        app:startIconDrawable="@drawable/ic_late"
        app:endIconMode="custom"
        app:layout_constraintTop_toBottomOf="@id/til_start_time"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <com.google.android.material.textfield.TextInputEditText
            android:id="@+id/edt_allowed_check_in_time"
            style="@style/AppTextInputEditText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:focusable="false"
            android:clickable="true"
            android:cursorVisible="false"
            android:inputType="none"
            tools:text="07:30" />
    </com.google.android.material.textfield.TextInputLayout>

    <!-- 4. Vị trí chấm công -->
    <TextView
        android:id="@+id/tv_location_section"
        style="@style/BodyTextMediumStyle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/spacing_l"
        android:text="Vị trí chấm công"
        android:textColor="?attr/colorOnSurface"
        android:textStyle="bold"
        app:layout_constraintTop_toBottomOf="@id/til_allowed_check_in_time"
        app:layout_constraintStart_toStartOf="parent" />

    <com.google.android.material.textfield.TextInputLayout
        android:id="@+id/til_location"
        style="@style/AppTextInputLayout"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/spacing_s"
        android:hint="Vị trí làm việc"
        app:startIconDrawable="@drawable/ic_location"
        app:endIconDrawable="@drawable/ic_my_location"
        app:endIconMode="custom"
        app:endIconContentDescription="Lấy vị trí hiện tại"
        app:layout_constraintTop_toBottomOf="@id/tv_location_section"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <com.google.android.material.textfield.TextInputEditText
            android:id="@+id/edt_location"
            style="@style/AppTextInputEditText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:inputType="textPostalAddress"
            android:imeOptions="actionNext"
            tools:text="138, Trần Cung, Cầu Giấy, Hà Nội" />
    </com.google.android.material.textfield.TextInputLayout>

    <!-- 5. Bán kính check-in -->
    <com.google.android.material.textfield.TextInputLayout
        android:id="@+id/til_check_in_radius"
        style="@style/AppTextInputLayout"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/spacing_m"
        android:hint="Bán kính chấm công (m)"
        app:startIconDrawable="@drawable/ic_location"
        app:layout_constraintTop_toBottomOf="@id/til_location"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <com.google.android.material.textfield.TextInputEditText
            android:id="@+id/edt_check_in_radius"
            style="@style/AppTextInputEditText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:inputType="number"
            android:maxLines="1"
            android:imeOptions="actionDone"
            android:text="100" />
    </com.google.android.material.textfield.TextInputLayout>

    <TextView
        android:id="@+id/tv_radius_hint"
        style="@style/BodyTextSmallStyle"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/spacing_xs"
        android:text="Nhân viên cần ở trong phạm vi này để chấm công."
        android:textColor="?attr/colorOnSurfaceVariant"
        app:layout_constraintTop_toBottomOf="@id/til_check_in_radius"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- Save -->
    <com.google.android.material.button.MaterialButton
        android:id="@+id/btn_save_shift"
        style="@style/ButtonMaxWidthStyle"
        android:layout_width="0dp"
        android:layout_height="@dimen/button_height_default"
        android:layout_marginTop="@dimen/spacing_l"
        android:text="Tạo ca làm việc"
        app:icon="@drawable/ic_check"
        app:iconGravity="textStart"
        app:layout_constraintTop_toBottomOf="@id/tv_radius_hint"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintBottom_toBottomOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>