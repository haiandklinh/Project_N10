<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_bottom_sheet"
    android:padding="@dimen/spacing_m">

    <!-- Thanh gạch ngang chỉ báo kéo BottomSheet -->
    <View
        android:id="@+id/drag_handle"
        android:layout_width="32dp"
        android:layout_height="4dp"
        android:background="@drawable/bg_handle"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <!-- Tiêu đề -->
    <TextView
        android:id="@+id/tv_title"
        style="@style/TitleTextMediumStyle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/spacing_s"
        android:text="Thêm ca làm việc mới"
        android:textColor="?attr/colorOnSurface"
        android:textStyle="bold"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/drag_handle" />

    <!-- 1. Tên ca làm việc -->
    <com.google.android.material.textfield.TextInputLayout
        android:id="@+id/til_shift_name"
        style="@style/AppTextInputLayout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/spacing_m"
        android:hint="Tên ca (VD: Ca Sáng)"
        app:layout_constraintTop_toBottomOf="@id/tv_title">

        <com.google.android.material.textfield.TextInputEditText
            android:id="@+id/edt_shift_name"
            style="@style/AppTextInputEditText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:inputType="textCapWords"
            android:maxLines="1" />
    </com.google.android.material.textfield.TextInputLayout>

    <!-- 2. Giờ bắt đầu -->
    <com.google.android.material.textfield.TextInputLayout
        android:id="@+id/til_start_time"
        style="@style/AppTextInputLayout"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/spacing_m"
        android:layout_marginEnd="@dimen/spacing_xs"
        android:hint="Giờ bắt đầu"
        app:endIconDrawable="@drawable/ic_history"
        app:endIconMode="custom"
        app:layout_constraintEnd_toStartOf="@id/til_end_time"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/til_shift_name">

        <com.google.android.material.textfield.TextInputEditText
            android:id="@+id/edt_start_time"
            style="@style/AppTextInputEditText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:focusable="false"
            android:clickable="true"
            android:inputType="none"
            tools:text="08:00 AM" />

    </com.google.android.material.textfield.TextInputLayout>

    <!-- 3. Giờ kết thúc -->
    <com.google.android.material.textfield.TextInputLayout
        android:id="@+id/til_end_time"
        style="@style/AppTextInputLayout"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/spacing_xs"
        android:layout_marginTop="@dimen/spacing_m"
        android:hint="Giờ kết thúc"
        app:endIconDrawable="@drawable/ic_history"
        app:endIconMode="custom"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toEndOf="@id/til_start_time"
        app:layout_constraintTop_toBottomOf="@id/til_shift_name">

        <com.google.android.material.textfield.TextInputEditText
            android:id="@+id/edt_end_time"
            style="@style/AppTextInputEditText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:focusable="false"
            android:clickable="true"
            android:inputType="none"
            tools:text="12:00 PM" />

    </com.google.android.material.textfield.TextInputLayout>

    <!-- 4. Nút Thêm / Cập nhật ca -->
    <com.google.android.material.button.MaterialButton
        android:id="@+id/btn_save_shift"
        style="@style/ButtonMaxWidthStyle"
        android:layout_width="match_parent"
        android:layout_height="@dimen/button_height_default"
        android:layout_marginTop="@dimen/spacing_l"
        android:text="Thêm ca làm việc"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintTop_toBottomOf="@id/til_end_time" />

</androidx.constraintlayout.widget.ConstraintLayout>