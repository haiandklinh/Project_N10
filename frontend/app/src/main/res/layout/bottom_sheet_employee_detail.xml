<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_bottom_sheet"
    android:orientation="vertical"
    android:paddingHorizontal="@dimen/spacing_xl"
    android:paddingBottom="@dimen/spacing_2xl">

    <View
        android:layout_width="30dp"
        android:layout_height="4dp"
        android:layout_gravity="center_horizontal"
        android:layout_marginTop="@dimen/spacing_s"
        android:background="@drawable/bg_handle" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/spacing_xl"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <com.google.android.material.imageview.ShapeableImageView
            android:id="@+id/iv_avatar"
            android:layout_width="@dimen/avatar_size_xl"
            android:layout_height="@dimen/avatar_size_xl"
            android:scaleType="centerCrop"
            android:padding="@dimen/border_width_s"
            android:src="@drawable/ic_avatar"
            android:contentDescription="@null"
            app:shapeAppearanceOverlay="@style/ImageCircleStyle"
            app:strokeColor="?attr/colorPrimary"
            app:strokeWidth="@dimen/border_width_s" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/spacing_m"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/tv_name"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textSize="@dimen/text_size_title_large"
                android:textStyle="bold"
                tools:text="Phạm Thu Hà" />

            <TextView
                android:id="@+id/tv_position"
                style="@style/BodyTextMediumStyle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                tools:text="Thu ngân · Cửa hàng Q1" />

            <com.google.android.material.chip.Chip
                android:id="@+id/chip_status"
                style="@style/ChipStatusStyle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/spacing_xs"
                tools:text="Đang làm" />

        </LinearLayout>

    </LinearLayout>

    <View style="@style/DividerStyle"
        android:layout_marginTop="@dimen/spacing_l" />

    <!-- Thông tin liên hệ -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/spacing_l"
        android:orientation="vertical">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <ImageView
                android:layout_width="@dimen/icon_size_m"
                android:layout_height="@dimen/icon_size_m"
                android:src="@drawable/ic_phone"
                app:tint="?attr/colorPrimary" />

            <TextView
                android:id="@+id/tv_phone"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/spacing_s"
                android:textSize="@dimen/text_size_body_medium"
                tools:text="0987 654 321" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/spacing_m"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <ImageView
                android:layout_width="@dimen/icon_size_m"
                android:layout_height="@dimen/icon_size_m"
                android:src="@drawable/ic_calendar"
                app:tint="?attr/colorPrimary" />

            <TextView
                android:id="@+id/tv_join_date"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/spacing_s"
                android:textSize="@dimen/text_size_body_medium"
                tools:text="Ngày vào làm: 03/01/2025" />
        </LinearLayout>

    </LinearLayout>

    <!-- Số liệu tổng hợp tháng này -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/spacing_l"
        android:text="Tổng hợp tháng này"
        android:textSize="@dimen/text_size_label_large"
        android:textStyle="bold" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/spacing_s"
        android:baselineAligned="false"
        android:orientation="horizontal">

        <com.google.android.material.card.MaterialCardView
            style="@style/IconViewCard"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginEnd="@dimen/spacing_s"
            android:layout_weight="1">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:orientation="vertical"
                android:paddingVertical="@dimen/spacing_m">

                <TextView
                    android:id="@+id/tv_shift_count"
                    style="@style/TitleTextLargeStyle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    tools:text="22" />

                <TextView
                    style="@style/BodyTextSmallStyle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Ca đã làm" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <com.google.android.material.card.MaterialCardView
            style="@style/IconViewCard"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:orientation="vertical"
                android:paddingVertical="@dimen/spacing_m">

                <TextView
                    android:id="@+id/tv_leave_count"
                    style="@style/TitleTextLargeStyle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    tools:text="1" />

                <TextView
                    style="@style/BodyTextSmallStyle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Ngày nghỉ phép" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

    </LinearLayout>

    <!-- Lương tạm tính -->
    <com.google.android.material.card.MaterialCardView
        style="@style/MainCard"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/spacing_m"
        app:cardBackgroundColor="?attr/colorPrimaryContainer">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:padding="@dimen/spacing_l">

            <ImageView
                android:layout_width="@dimen/icon_size_l"
                android:layout_height="@dimen/icon_size_l"
                android:src="@drawable/ic_payroll"
                app:tint="?attr/colorOnPrimaryContainer" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/spacing_m"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Lương tạm tính tháng này"
                    android:textColor="?attr/colorOnPrimaryContainer"
                    android:textSize="@dimen/text_size_body_small" />

                <TextView
                    android:id="@+id/tv_salary"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textColor="?attr/colorOnPrimaryContainer"
                    android:textSize="@dimen/text_size_title_medium"
                    android:textStyle="bold"
                    tools:text="7.850.000 đ" />
            </LinearLayout>

        </LinearLayout>

    </com.google.android.material.card.MaterialCardView>

    <com.google.android.material.button.MaterialButton
        android:id="@+id/btn_close"
        style="@style/ButtonMaxWidthStyle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/spacing_xl"
        android:text="Đóng"
        app:cornerRadius="@dimen/radius_full" />

</LinearLayout>
