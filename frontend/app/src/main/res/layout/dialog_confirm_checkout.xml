<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_dialog"
    android:gravity="center_horizontal"
    android:orientation="vertical"
    android:padding="@dimen/spacing_xl">

    <!-- Icon Card -->
    <com.google.android.material.card.MaterialCardView
        style="@style/IconViewCard"
        android:layout_width="@dimen/icon_container_xl"
        android:layout_height="@dimen/icon_container_xl"
        android:layout_marginBottom="@dimen/spacing_s"
        app:cardBackgroundColor="?attr/colorPrimaryContainer"
        app:cardCornerRadius="@dimen/radius_m"
        app:cardElevation="0dp"
        app:strokeWidth="0dp">

        <ImageView
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:padding="@dimen/spacing_m"
            android:src="@drawable/ic_date_time"
            app:tint="?attr/colorPrimary" />
    </com.google.android.material.card.MaterialCardView>

    <!-- Tiêu đề -->
    <TextView
        android:id="@+id/tvDialogTitle"
        style="@style/DialogTitleStyle"
        android:text="@string/checkout_dialog_title" />

    <!-- Nội dung thông báo thời gian làm việc và xác nhận -->
    <TextView
        android:id="@+id/tvDialogMessage"
        style="@style/DialogMessageStyle" />

    <!-- 2 Nút bấm -->
    <LinearLayout
        style="@style/DialogActionButtonsContainerStyle">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnCancel"
            style="@style/ButtonOutlinedSmallStyle"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="@string/checkout_dialog_btn_cancel"
            android:textStyle="bold" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnConfirm"
            style="@style/ButtonFilledSmallStyle"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/spacing_l"
            android:layout_weight="1"
            android:text="@string/checkout_dialog_btn_confirm" />
    </LinearLayout>

</LinearLayout>
