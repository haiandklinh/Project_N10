<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?android:attr/colorBackground"
    android:padding="@dimen/spacing_xl">

    <!-- Guest Button ở góc trên bên phải -->
    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnContinueAsGuest"
        style="@style/Widget.Material3.Button.TextButton"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/spacing_s"
        
        android:text="Khách"
        android:textColor="?attr/colorPrimary"
        app:icon="@drawable/ic_user"
        app:iconGravity="textStart"
        app:iconPadding="@dimen/spacing_xs"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <!-- Header / Illustration Section -->
    <LinearLayout
        android:id="@+id/layoutHeader"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:orientation="vertical"
        android:paddingTop="@dimen/spacing_l"
        app:layout_constraintBottom_toTopOf="@id/cardInfo"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/btnContinueAsGuest"
        app:layout_constraintVertical_chainStyle="packed">

        <!-- Glowing Clock Icon Container -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/cardIllustration"
            android:layout_width="100dp"
            android:layout_height="100dp"
            app:cardBackgroundColor="?attr/colorPrimaryContainer"
            app:cardCornerRadius="50dp"
            app:cardElevation="0dp"
            app:strokeWidth="0dp">

            <ImageView
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:padding="@dimen/spacing_l"
                android:src="@drawable/ic_history"
                app:tint="?attr/colorPrimary" />
        </com.google.android.material.card.MaterialCardView>

        <!-- Title -->
        <TextView
            android:id="@+id/tvTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/spacing_s"
            android:text="Đang chờ phê duyệt"
            android:textSize="@dimen/text_size_headline_medium"
            android:textStyle="bold" />

        <!-- Subtitle Message -->
        <TextView
            android:id="@+id/tvMessage"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/spacing_xs"
            android:gravity="center"
            android:text="Yêu cầu tham gia của bạn đã được gửi đi. Vui lòng chờ Quản lý phê duyệt để bắt đầu sử dụng ứng dụng."
            android:textColor="?attr/colorOnSurfaceVariant"
            android:textSize="@dimen/text_size_body_medium" />
    </LinearLayout>

    <!-- Info Card Group -->
    <com.google.android.material.card.MaterialCardView
        android:id="@+id/cardInfo"
        style="@style/MainCard"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/spacing_xl"
        app:cardBackgroundColor="?attr/colorSurfaceVariant"
        app:layout_constraintBottom_toTopOf="@id/layoutButtons"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/layoutHeader">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="@dimen/spacing_l">

            <!-- Company Info Row -->
            <TextView
                android:id="@+id/tvCompanyNameLabel"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Doanh nghiệp đăng ký"
                android:textColor="?attr/colorOnSurfaceVariant"
                android:textSize="@dimen/text_size_body_small" />

            <TextView
                android:id="@+id/tvCompanyName"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/spacing_3xs"
                android:textColor="?attr/colorOnSurface"
                android:textSize="@dimen/text_size_title_medium"
                android:textStyle="bold"
                tools:text="Công ty TNHH Công Nghệ ABC" />

            <!-- Custom Divider inside Card -->
            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:layout_marginVertical="@dimen/spacing_m"
                android:background="?attr/colorOutlineVariant" />

            <!-- Invite Code Row with Badge Style -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/tvInviteCodeLabel"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Mã mời đã sử dụng"
                    android:textColor="?attr/colorOnSurfaceVariant"
                    android:textSize="@dimen/text_size_body_small" />

                <!-- Code Badge -->
                <com.google.android.material.chip.Chip
                    android:id="@+id/tvInviteCode"
                    style="@style/ChipStatusStyle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textColor="?attr/colorPrimary"
                    app:chipBackgroundColor="?attr/colorSurface"
                    tools:text="ABC1234" />
            </LinearLayout>

        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>

    <!-- Bottom Actions Container -->
    <LinearLayout
        android:id="@+id/layoutButtons"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent">

        <!-- Primary Refresh Button -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnCheckStatus"
            style="@style/ButtonMaxWidthStyle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Kiểm tra trạng thái"
            app:cornerRadius="@dimen/radius_full"
            app:icon="@drawable/ic_refresh"
            app:iconGravity="textStart"
            app:iconPadding="@dimen/spacing_s" />

        <!-- Secondary Logout Button -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_logout"
            style="@style/Widget.Material3.Button.OutlinedButton"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:layout_marginTop="@dimen/spacing_s"
            android:text="Hủy yêu cầu"
            android:textColor="@color/md_theme_light_error"
            app:strokeColor="@color/md_theme_light_error"
            app:strokeWidth="1dp" />
    </LinearLayout>

    <com.google.android.material.progressindicator.CircularProgressIndicator
        android:id="@+id/progressBar"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:indeterminate="true"
        android:visibility="gone"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        tools:visibility="visible" />

</androidx.constraintlayout.widget.ConstraintLayout>