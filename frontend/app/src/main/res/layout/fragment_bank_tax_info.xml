<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?android:attr/colorBackground">

    <com.example.attendanceapp.core.utils.ToolbarApp
        android:id="@+id/layout_toolbar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <androidx.core.widget.NestedScrollView
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:fillViewport="true"
        android:overScrollMode="never"
        app:layout_constraintTop_toBottomOf="@id/layout_toolbar"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="@dimen/spacing_l">

            <!-- NHÓM 1: TÀI KHOẢN NGÂN HÀNG NHẬN LƯƠNG -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Tài khoản nhận lương"
                android:textStyle="bold"
                android:textColor="?attr/colorPrimary"
                android:layout_marginBottom="@dimen/spacing_s"/>

            <com.google.android.material.textfield.TextInputLayout
                style="@style/AppTextInputLayout"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="Tên ngân hàng"
                app:endIconMode="custom"
                app:endIconDrawable="@drawable/ic_lock"
                android:layout_marginBottom="@dimen/spacing_m">
                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/et_bank_name"
                    style="@style/AppTextInputEditText"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:enabled="false"
                    android:text="MB Bank (Ngân hàng Quân Đội)" />
            </com.google.android.material.textfield.TextInputLayout>

            <com.google.android.material.textfield.TextInputLayout
                style="@style/AppTextInputLayout"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="Số tài khoản"
                app:endIconMode="custom"
                app:endIconDrawable="@drawable/ic_lock"
                android:layout_marginBottom="@dimen/spacing_m">
                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/et_bank_account_number"
                    style="@style/AppTextInputEditText"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:enabled="false"
                    android:text="999988886666" />
            </com.google.android.material.textfield.TextInputLayout>

            <com.google.android.material.textfield.TextInputLayout
                style="@style/AppTextInputLayout"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="Chủ tài khoản (Không dấu)"
                app:endIconMode="custom"
                app:endIconDrawable="@drawable/ic_lock"
                android:layout_marginBottom="@dimen/spacing_l">
                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/et_bank_account_holder"
                    style="@style/AppTextInputEditText"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:enabled="false"
                    android:text="NGUYEN VIET SON" />
            </com.google.android.material.textfield.TextInputLayout>

            <!-- NHÓM 2: THUẾ & BẢO HIỂM -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Thông tin Thuế &amp; BHXH"
                android:textStyle="bold"
                android:textColor="?attr/colorPrimary"
                android:layout_marginBottom="@dimen/spacing_s"/>

            <com.google.android.material.textfield.TextInputLayout
                style="@style/AppTextInputLayout"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="Mã số thuế cá nhân"
                app:endIconMode="custom"
                app:endIconDrawable="@drawable/ic_lock"
                android:layout_marginBottom="@dimen/spacing_m">
                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/et_tax_code"
                    style="@style/AppTextInputEditText"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:enabled="false"
                    android:text="8539201928" />
            </com.google.android.material.textfield.TextInputLayout>

            <com.google.android.material.textfield.TextInputLayout
                style="@style/AppTextInputLayout"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="Số sổ BHXH"
                app:endIconMode="custom"
                app:endIconDrawable="@drawable/ic_lock"
                android:layout_marginBottom="@dimen/spacing_xl">
                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/et_social_insurance_number"
                    style="@style/AppTextInputEditText"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:enabled="false"
                    android:text="0123456789" />
            </com.google.android.material.textfield.TextInputLayout>

            <!-- Nút gửi yêu cầu thay đổi tài khoản nhận lương -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_request_change_bank"
                style="@style/Widget.Material3.Button.TextButton"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Yêu cầu thay đổi tài khoản ngân hàng / MST"
                app:icon="@drawable/ic_form" />

        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

</androidx.constraintlayout.widget.ConstraintLayout>