<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?android:attr/colorBackground">

    <!-- Toolbar -->
    <com.example.attendanceapp.core.utils.ToolbarApp
        android:id="@+id/layout_toolbar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <androidx.core.widget.NestedScrollView
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:fillViewport="true"
        android:overScrollMode="never"
        app:layout_constraintTop_toBottomOf="@id/layout_toolbar"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="@dimen/spacing_l">

            <!-- Avatar Section -->
            <androidx.constraintlayout.widget.ConstraintLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="@dimen/spacing_xl">

                <com.google.android.material.imageview.ShapeableImageView
                    android:id="@+id/iv_edit_avatar"
                    android:layout_width="100dp"
                    android:layout_height="100dp"
                    android:src="@drawable/ic_avatar"
                    android:scaleType="centerCrop"
                    app:shapeAppearanceOverlay="@style/ImageCircleStyle"
                    app:strokeColor="?attr/colorPrimary"
                    app:strokeWidth="1dp"
                    android:padding="1dp"
                    app:layout_constraintTop_toTopOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintEnd_toEndOf="parent" />

                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/btn_change_photo"
                    android:layout_width="32dp"
                    android:layout_height="32dp"
                    app:cardCornerRadius="16dp"
                    app:cardBackgroundColor="?attr/colorPrimary"
                    app:cardElevation="2dp"
                    app:layout_constraintBottom_toBottomOf="@id/iv_edit_avatar"
                    app:layout_constraintEnd_toEndOf="@id/iv_edit_avatar">

                    <ImageView
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:padding="8dp"
                        android:src="@drawable/ic_camera"
                        app:tint="?attr/colorOnPrimary" />
                </com.google.android.material.card.MaterialCardView>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Ảnh đại diện nhận diện khuôn mặt"
                    android:textSize="@dimen/text_size_label_small"
                    android:textColor="?attr/colorOnSurfaceVariant"
                    android:layout_marginTop="@dimen/spacing_s"
                    app:layout_constraintTop_toBottomOf="@id/iv_edit_avatar"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintEnd_toEndOf="parent" />

            </androidx.constraintlayout.widget.ConstraintLayout>

            <!-- Main Menu Card -->
            <com.google.android.material.card.MaterialCardView
                style="@style/MainCard"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="@dimen/spacing_xl">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">

                    <!-- 1. Thông tin cá nhân cơ bản -->
                    <include
                        android:id="@+id/row_basic_info"
                        layout="@layout/item_profile_menu_row" />

                    <View style="@style/DividerStyle" />

                    <!-- 2. Thông tin liên hệ -->
                    <include
                        android:id="@+id/row_contact_info"
                        layout="@layout/item_profile_menu_row" />

                    <View style="@style/DividerStyle" />

                    <!-- 3. Thông tin ngân hàng & Thuế -->
                    <include
                        android:id="@+id/row_finance_info"
                        layout="@layout/item_profile_menu_row" />

                    <View style="@style/DividerStyle" />

                    <!-- 4. Thông tin công việc -->
                    <include
                        android:id="@+id/row_job_info"
                        layout="@layout/item_profile_menu_row" />

                    <View style="@style/DividerStyle" />

                    <!-- 5. Cài đặt ứng dụng & Quyền riêng tư -->
                    <include
                        android:id="@+id/row_privacy_settings"
                        layout="@layout/item_profile_menu_row" />

                </LinearLayout>

            </com.google.android.material.card.MaterialCardView>

            <!-- Tip/Notice -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Lưu ý: Một số thông tin quan trọng như Mã nhân viên, Chức vụ chỉ có thể thay đổi bởi bộ phận Nhân sự."
                android:textSize="@dimen/text_size_body_small"
                android:textColor="?attr/colorOnSurfaceVariant"
                android:fontStyle="italic"
                android:gravity="center"
                android:paddingHorizontal="@dimen/spacing_m" />

        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

</androidx.constraintlayout.widget.ConstraintLayout>