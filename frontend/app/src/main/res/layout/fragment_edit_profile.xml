<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?android:attr/colorBackground">

    <!-- Toolbar -->
    <com.example.attendanceapp.core.utils.ToolbarApp
        android:id="@+id/layout_toolbar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <androidx.core.widget.NestedScrollView
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:fillViewport="true"
        android:overScrollMode="never"
        app:layout_constraintTop_toBottomOf="@id/layout_toolbar"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="@dimen/spacing_l">

            <!-- Main Menu Card -->
            <com.google.android.material.card.MaterialCardView
                style="@style/MainCard"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="@dimen/spacing_xl">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">

                    <!-- 1. Thông tin cá nhân cơ bản -->
                    <include
                        android:id="@+id/row_basic_info"
                        layout="@layout/item_profile_menu_row" />

                    <View style="@style/DividerStyle" />

                    <!-- 2. Thông tin liên hệ -->
                    <include
                        android:id="@+id/row_contact_info"
                        layout="@layout/item_profile_menu_row" />

                    <View style="@style/DividerStyle" />

                    <!-- 3. Thông tin ngân hàng & Thuế -->
                    <include
                        android:id="@+id/row_finance_info"
                        layout="@layout/item_profile_menu_row" />

                    <View style="@style/DividerStyle" />

                    <!-- 4. Thông tin công việc -->
                    <include
                        android:id="@+id/row_job_info"
                        layout="@layout/item_profile_menu_row" />

                    <View style="@style/DividerStyle" />

                    <!-- 5. Cài đặt ứng dụng & Quyền riêng tư -->
                    <include
                        android:id="@+id/row_privacy_settings"
                        layout="@layout/item_profile_menu_row" />

                </LinearLayout>

            </com.google.android.material.card.MaterialCardView>

            <!-- Tip/Notice -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Lưu ý: Một số thông tin quan trọng như Mã nhân viên, Chức vụ chỉ có thể thay đổi bởi bộ phận Nhân sự."
                android:textSize="@dimen/text_size_body_small"
                android:textColor="?attr/colorOnSurfaceVariant"
                android:fontStyle="italic"
                android:gravity="center"
                android:paddingHorizontal="@dimen/spacing_m" />

        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

</androidx.constraintlayout.widget.ConstraintLayout>