<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView
    android:id="@+id/scroll_view_checkin"
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?android:attr/colorBackground"
    android:clipToPadding="false"
    android:fillViewport="true"
    android:overScrollMode="never"
    tools:context=".ui.employee.checkin.EmployeeCheckInFragment"
    android:fitsSystemWindows="true">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="@dimen/spacing_s">


        <!-- HERO - THỜI GIAN HIỆN TẠI -->
        <TextView
            android:id="@+id/tv_clock_big"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/spacing_l"
            android:fontFamily="sans-serif-medium"
            android:includeFontPadding="false"
            android:letterSpacing="-0.03"
            android:text="08:42"
            android:textColor="?attr/colorPrimary"
            android:textSize="56sp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />


        <TextView
            android:id="@+id/tv_date_today"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/spacing_2xs"
            android:text="Thứ Ba, 01 tháng 09, 2026"
            android:textColor="?attr/colorPrimary"
            android:textSize="@dimen/text_size_body_medium"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/tv_clock_big" />


        <!-- ==================== VỊ TRÍ HIỆN TẠI ==================== -->
        <TextView
            android:id="@+id/tv_location_label"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/spacing_l"
            android:layout_marginStart="@dimen/spacing_l"
            android:text="@string/checkin_current_location_label"
            android:textColor="?attr/colorOnSurface"
            android:textSize="@dimen/text_size_title_small"
            android:textStyle="bold"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/tv_date_today" />


        <com.google.android.material.card.MaterialCardView
            android:id="@+id/card_map_preview"
            style="@style/MainCard"
            android:layout_width="0dp"
            android:layout_height="220dp"
            android:layout_marginTop="@dimen/spacing_s"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/tv_location_label">

            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent">

                <com.mapbox.maps.MapView
                    android:id="@+id/map_view"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:contentDescription="Bản đồ vị trí hiện tại" />

                <!-- Lớp trong suốt xử lý chạm ngăn xung đột cuộn dọc với NestedScrollView -->
                <View
                    android:id="@+id/view_map_touch_interceptor"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:background="@android:color/transparent" />

                                <!-- Nút định vị nổi góc trên trái: Vị trí của tôi -->
                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/btn_recenter_location"
                    android:layout_width="38dp"
                    android:layout_height="38dp"
                    android:layout_gravity="top|start"
                    android:layout_margin="@dimen/spacing_m"
                    app:cardCornerRadius="19dp"
                    app:cardElevation="3dp"
                    app:strokeWidth="0dp"
                    app:cardBackgroundColor="?attr/colorSurface"
                    android:clickable="true"
                    android:focusable="true">

                    <ImageView
                        android:layout_width="20dp"
                        android:layout_height="20dp"
                        android:layout_gravity="center"
                        android:src="@drawable/ic_my_location"
                        app:tint="?attr/colorPrimary"
                        android:contentDescription="Định vị của tôi" />
                </com.google.android.material.card.MaterialCardView>

                <!-- Chip trạng thái nổi góc trên phải: Hợp lệ / Ngoài khu vực -->
                <com.google.android.material.chip.Chip
                    android:id="@+id/tag_location_valid"
                    style="@style/ChipStatusStyle"
                    android:layout_margin="@dimen/spacing_m"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="top|end"
                    android:layout_marginTop="@dimen/spacing_m"
                    android:layout_marginEnd="@dimen/spacing_m"
                    tools:text="Hợp lệ" />

                <!-- Thanh thông tin đè dưới đáy map: địa chỉ + khoảng cách -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_gravity="bottom"
                    android:background="#801A1A1A"
                    android:orientation="vertical"
                    android:padding="@dimen/spacing_s">

                    <TextView
                        android:id="@+id/tv_location_address"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:ellipsize="end"
                        android:maxLines="1"
                        android:text="@string/checkin_determining_location"
                        android:textColor="?attr/colorOnPrimary"
                        android:textSize="@dimen/text_size_body_small"
                        android:textStyle="bold"
                        tools:text="123 Đường Láng, Đống Đa, Hà Nội" />

                    <TextView
                        android:id="@+id/tv_distance_to_office"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="1dp"
                        android:text="Cách văn phòng 45m"
                        android:textColor="?attr/colorOnSecondary"
                        android:textSize="@dimen/text_size_label_small"
                        tools:text="Cách văn phòng 45m" />

                </LinearLayout>

            </FrameLayout>

        </com.google.android.material.card.MaterialCardView>


        <!-- ==================== ĐIỀU KIỆN CHẤM CÔNG ==================== -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/card_checkin_conditions"
            style="@style/MainCard"
            app:cardBackgroundColor="?attr/colorSurfaceVariant"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/spacing_m"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/card_map_preview">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="@dimen/spacing_m">

                <!-- Dòng 1: GPS -->
                <LinearLayout
                    android:id="@+id/row_condition_gps"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:paddingVertical="@dimen/spacing_2xs">

                    <ImageView
                        android:id="@+id/iv_condition_gps_status"
                        android:layout_width="20dp"
                        android:layout_height="20dp"
                        android:contentDescription="@null"
                        android:src="@drawable/ic_check"
                        app:tint="#4CAF50" />

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="@dimen/spacing_s"
                        android:layout_weight="1"
                        android:text="@string/checkin_gps_enabled"
                        android:textColor="?attr/colorOnSurface"
                        android:textSize="@dimen/text_size_body_small" />

                </LinearLayout>

                <!-- Dòng 2: Trong bán kính cho phép -->
                <LinearLayout
                    android:id="@+id/row_condition_range"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:paddingVertical="@dimen/spacing_2xs">

                    <ImageView
                        android:id="@+id/iv_condition_range_status"
                        android:layout_width="20dp"
                        android:layout_height="20dp"
                        android:contentDescription="@null"
                        android:src="@drawable/ic_check"
                        app:tint="#4CAF50" />

                    <TextView
                        android:id="@+id/tv_condition_range"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="@dimen/spacing_s"
                        android:layout_weight="1"
                        android:text="@string/checkin_within_range_default"
                        android:textColor="?attr/colorOnSurface"
                        android:textSize="@dimen/text_size_body_small"
                        tools:text="Trong bán kính cho phép (100m)" />

                </LinearLayout>

                <!-- Dòng 3: Kết nối mạng -->
                <LinearLayout
                    android:id="@+id/row_condition_network"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:paddingVertical="@dimen/spacing_2xs">

                    <ImageView
                        android:id="@+id/iv_condition_network_status"
                        android:layout_width="20dp"
                        android:layout_height="20dp"
                        android:contentDescription="@null"
                        android:src="@drawable/ic_check"
                        app:tint="#4CAF50" />

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="@dimen/spacing_s"
                        android:layout_weight="1"
                        android:text="@string/checkin_network_stable"
                        android:textColor="?attr/colorOnSurface"
                        android:textSize="@dimen/text_size_body_small" />

                </LinearLayout>

            </LinearLayout>

        </com.google.android.material.card.MaterialCardView>


        <!-- CHECK IN BUTTON -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_check_action"
            style="@style/ButtonMaxWidthStyle"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/spacing_xl"
            android:text="CHECK IN"
            android:textAllCaps="false"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/card_checkin_conditions" />


        <!-- TODAY SUMMARY -->
        <TextView
            android:id="@+id/tv_today_summary_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/spacing_l"
            android:layout_marginStart="@dimen/spacing_l"
            android:text="@string/checkin_today_summary"
            android:textColor="?attr/colorOnSurface"
            android:textSize="@dimen/text_size_title_small"
            android:textStyle="bold"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/btn_check_action" />


        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/layout_today_summary_cards"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/spacing_s"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/tv_today_summary_title">

            <!-- CARD CHECK IN -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/card_summary_check_in"
                style="@style/ItemCard"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginEnd="@dimen/spacing_l"
                app:cardBackgroundColor="?attr/colorPrimaryContainer"
                app:layout_constraintEnd_toStartOf="@id/card_summary_check_out"
                app:layout_constraintHorizontal_chainStyle="spread"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent">

                <androidx.constraintlayout.widget.ConstraintLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:padding="@dimen/spacing_m">

                    <!-- Tiêu đề trên cùng -->
                    <TextView
                        android:id="@+id/tv_label_check_in"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/checkin_check_in_time"
                        android:textColor="?attr/colorOnSurfaceVariant"
                        android:textSize="@dimen/text_size_body_small"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toTopOf="parent" />


                    <TextView
                        android:id="@+id/tv_summary_check_in_time"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="@dimen/spacing_2xs"
                        android:layout_marginTop="4dp"
                        android:text="--:--"
                        android:textColor="?attr/colorOnSurface"
                        android:textSize="@dimen/text_size_title_medium"
                        android:textStyle="bold"
                        app:layout_constraintBottom_toBottomOf="parent"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toBottomOf="@id/tv_label_check_in" />

                </androidx.constraintlayout.widget.ConstraintLayout>

            </com.google.android.material.card.MaterialCardView>

            <!-- CARD CHECK OUT -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/card_summary_check_out"
                style="@style/ItemCard"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/spacing_2xs"
                app:cardBackgroundColor="?attr/colorPrimaryContainer"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toEndOf="@id/card_summary_check_in"
                app:layout_constraintTop_toTopOf="parent">

                <androidx.constraintlayout.widget.ConstraintLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:padding="@dimen/spacing_m">

                    <!-- Tiêu đề trên cùng -->
                    <TextView
                        android:id="@+id/tv_label_check_out"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/checkin_check_out_time"
                        android:textColor="?attr/colorOnSurfaceVariant"
                        android:textSize="@dimen/text_size_body_small"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toTopOf="parent" />


                    <TextView
                        android:id="@+id/tv_summary_check_out_time"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="@dimen/spacing_2xs"
                        android:layout_marginTop="4dp"
                        android:text="--:--"
                        android:textColor="?attr/colorOnSurface"
                        android:textSize="@dimen/text_size_title_medium"
                        android:textStyle="bold"
                        app:layout_constraintBottom_toBottomOf="parent"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toBottomOf="@id/tv_label_check_out" />

                </androidx.constraintlayout.widget.ConstraintLayout>

            </com.google.android.material.card.MaterialCardView>

        </androidx.constraintlayout.widget.ConstraintLayout>

        <!-- WARNING -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/card_warning_out_of_range"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/spacing_m"
            android:visibility="gone"
            app:cardBackgroundColor="?attr/colorErrorContainer"
            app:cardCornerRadius="@dimen/radius_m"
            app:cardElevation="0dp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/layout_today_summary_cards"
            app:strokeWidth="0dp"
            tools:visibility="visible">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:padding="@dimen/spacing_m">

                <ImageView
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:contentDescription="@null"
                    android:src="@drawable/ic_warning"
                    app:tint="?attr/colorOnErrorContainer" />

                <TextView
                    android:id="@+id/tv_warning_out_of_range"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/spacing_s"
                    android:layout_weight="1"
                    android:text="@string/checkin_warning_out_of_range"
                    android:textColor="?attr/colorOnErrorContainer"
                    android:textSize="@dimen/text_size_body_small"
                    android:textStyle="bold" />

            </LinearLayout>


        </com.google.android.material.card.MaterialCardView>

        <Space
            android:id="@+id/spacer_bottom_nav"
            android:layout_width="match_parent"
            android:layout_height="80dp"
            app:layout_constraintTop_toBottomOf="@id/card_warning_out_of_range"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent" />

    </androidx.constraintlayout.widget.ConstraintLayout>

</androidx.core.widget.NestedScrollView>