<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?android:attr/colorBackground">

    <!-- TOOLBAR -->
    <com.example.attendanceapp.core.utils.ToolbarApp
        android:id="@+id/toolbar_app"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- 1. TAB LỌC THEO TRẠNG THÁI (TẤT CẢ / CHỜ DUYỆT / ĐÃ DUYỆT / TỪ CHỐI) -->
    <com.google.android.material.tabs.TabLayout
        android:id="@+id/tab_layout_status"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="?attr/colorSurface"
        app:tabGravity="fill"
        app:tabMode="fixed"
        app:tabIndicatorColor="?attr/colorPrimary"
        app:tabIndicatorHeight="3dp"
        app:tabSelectedTextColor="?attr/colorPrimary"
        app:tabTextColor="?attr/colorOnSurfaceVariant"
        app:layout_constraintTop_toBottomOf="@id/toolbar_app"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <com.google.android.material.tabs.TabItem
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Tất cả" />

        <com.google.android.material.tabs.TabItem
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Chờ duyệt" />

        <com.google.android.material.tabs.TabItem
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Đã duyệt" />

        <com.google.android.material.tabs.TabItem
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Từ chối" />

    </com.google.android.material.tabs.TabLayout>

    <!-- 2. HÀNG 4 CHIP LỌC LOẠI ĐƠN TỪ (TẤT CẢ, CHỈNH CÔNG, ĐỔI CA, XIN NGHỈ PHÉP) -->
    <HorizontalScrollView
        android:id="@+id/scroll_chips"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:scrollbars="none"
        android:paddingHorizontal="@dimen/spacing_m"
        android:paddingVertical="@dimen/spacing_xs"
        android:clipToPadding="false"
        app:layout_constraintTop_toBottomOf="@id/tab_layout_status"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <com.google.android.material.chip.ChipGroup
            android:id="@+id/chip_group_type"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            app:singleLine="true"
            app:singleSelection="true"
            app:selectionRequired="true">

            <com.google.android.material.chip.Chip
                android:id="@+id/chip_filter_all"
                style="@style/ChipFilterStyle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:checked="true"
                android:text="Tất cả" />

            <com.google.android.material.chip.Chip
                android:id="@+id/chip_filter_adjustment"
                style="@style/ChipFilterStyle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Chỉnh công" />

            <com.google.android.material.chip.Chip
                android:id="@+id/chip_filter_swap"
                style="@style/ChipFilterStyle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Đổi ca" />

            <com.google.android.material.chip.Chip
                android:id="@+id/chip_filter_leave"
                style="@style/ChipFilterStyle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Xin nghỉ phép" />

        </com.google.android.material.chip.ChipGroup>
    </HorizontalScrollView>

    <!-- 3. SWIPE REFRESH LAYOUT & DANH SÁCH YÊU CẦU -->
    <androidx.swiperefreshlayout.widget.SwipeRefreshLayout
        android:id="@+id/swipe_refresh_layout"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintTop_toBottomOf="@id/scroll_chips"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/rv_requests"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:paddingHorizontal="@dimen/spacing_m"
            android:paddingTop="@dimen/spacing_xs"
            android:clipToPadding="false"
            android:paddingBottom="100dp"
            tools:listitem="@layout/item_leave_request" />

    </androidx.swiperefreshlayout.widget.SwipeRefreshLayout>

    <!-- 4. EMPTY STATE KHI KHÔNG CÓ DỮ LIỆU -->
    <include
        android:id="@+id/layout_empty_state"
        layout="@layout/layout_empty_state"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:visibility="gone"
        app:layout_constraintTop_toBottomOf="@id/scroll_chips"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        tools:visibility="visible" />

    <!-- 5. FAB TẠO ĐƠN MỚI -->
    <com.google.android.material.floatingactionbutton.ExtendedFloatingActionButton
        android:id="@+id/fab_create_request"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginEnd="@dimen/spacing_2xl"
        android:layout_marginBottom="@dimen/spacing_2xl"
        android:text="Tạo đơn mới"
        app:icon="@drawable/ic_add"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>
