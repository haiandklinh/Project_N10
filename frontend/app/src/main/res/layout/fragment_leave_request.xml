<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?android:attr/colorBackground">

    <!-- Import Toolbar dùng chung -->
    <com.example.attendanceapp.core.utils.ToolbarApp
        android:id="@+id/toolbar_app"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <androidx.core.widget.NestedScrollView
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:fillViewport="true"
        android:overScrollMode="never"
        app:layout_constraintBottom_toTopOf="@id/layout_bottom_action"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/toolbar_app">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="@dimen/spacing_l">

            <!-- CARD KHU VỰC NHẬP ĐƠN TỪ -->
            <com.google.android.material.card.MaterialCardView
                style="@style/MainCard"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="@dimen/spacing_m">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="@dimen/spacing_m">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Thông tin đơn đề nghị"
                        android:textColor="?attr/colorPrimary"
                        android:textSize="@dimen/text_size_title_medium"
                        android:textStyle="bold"
                        android:layout_marginBottom="@dimen/spacing_m" />

                    <!-- LOẠI ĐƠN TỪ (Dropdown) -->
                    <com.google.android.material.textfield.TextInputLayout
                        android:id="@+id/til_request_type"
                        style="@style/SpinnerStyle"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:hint="Loại đơn từ"
                        app:startIconDrawable="@drawable/ic_category"
                        app:startIconTint="?attr/colorPrimary"
                        android:layout_marginBottom="@dimen/spacing_m">

                        <AutoCompleteTextView
                            android:id="@+id/act_request_type"
                            style="@style/AppTextInputEditText"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:inputType="none"
                            tools:ignore="LabelFor" />
                    </com.google.android.material.textfield.TextInputLayout>

                    <!-- NGÀY ÁP DỤNG -->
                    <com.google.android.material.textfield.TextInputLayout
                        android:id="@+id/til_date"
                        style="@style/AppTextInputLayout"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:hint="Chọn ngày áp dụng"
                        app:startIconDrawable="@drawable/ic_calendar"
                        app:startIconTint="?attr/colorPrimary"
                        android:layout_marginBottom="@dimen/spacing_m">

                        <com.google.android.material.textfield.TextInputEditText
                            android:id="@+id/et_date"
                            style="@style/AppTextInputEditText"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:clickable="true"
                            android:focusable="false"
                            android:inputType="none" />
                    </com.google.android.material.textfield.TextInputLayout>

                    <!-- CA LÀM / CA HỌC ĐỔI (Dropdown/Select) -->
                    <com.google.android.material.textfield.TextInputLayout
                        android:id="@+id/til_shift_info"
                        style="@style/SpinnerStyle"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:hint="Chọn ca làm / ca học cần đổi"
                        app:startIconDrawable="@drawable/ic_history"
                        app:startIconTint="?attr/colorPrimary"
                        android:visibility="gone"
                        android:layout_marginBottom="@dimen/spacing_m"
                        tools:visibility="visible">

                        <AutoCompleteTextView
                            android:id="@+id/act_shift_info"
                            style="@style/AppTextInputEditText"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:inputType="none" />
                    </com.google.android.material.textfield.TextInputLayout>

                    <!-- LÝ DO CỤ THỂ -->
                    <com.google.android.material.textfield.TextInputLayout
                        android:id="@+id/til_reason"
                        style="@style/AppTextInputLayout"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:hint="Lý do cụ thể"
                        app:startIconTint="?attr/colorPrimary"
                        android:layout_marginBottom="@dimen/spacing_s">

                        <com.google.android.material.textfield.TextInputEditText
                            android:id="@+id/et_reason"
                            style="@style/AppTextInputEditText"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:gravity="top|start"
                            android:inputType="textMultiLine"
                            android:lines="3"
                            android:minLines="3" />
                    </com.google.android.material.textfield.TextInputLayout>

                    <!-- CHECKBOX NGHỈ ĐỘT XUẤT -->
                    <com.google.android.material.checkbox.MaterialCheckBox
                        android:id="@+id/cb_is_emergency"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Nghỉ đột xuất (Cần HR/Quản lý duyệt gấp trong ngày)"
                        android:textColor="?attr/colorError"
                        android:textSize="@dimen/text_size_body_small" />

                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

    <!-- CONTAINER CỐ ĐỊNH NÚT BẤM DƯỚI CÙNG -->
    <com.google.android.material.card.MaterialCardView
        android:id="@+id/layout_bottom_action"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:cardElevation="@dimen/elevation_l"
        app:cardCornerRadius="0dp"
        app:layout_constraintBottom_toBottomOf="parent">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_submit"
            style="@style/ButtonMaxWidthStyle"
            android:layout_width="match_parent"
            android:layout_height="@dimen/button_height_default"
            android:layout_margin="@dimen/spacing_m"
            android:text="Gửi đơn phê duyệt" />
    </com.google.android.material.card.MaterialCardView>

</androidx.constraintlayout.widget.ConstraintLayout>