<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_login_header"
    tools:context=".ui.main.auth.login.LoginSavedAccountFragment">

    <!-- HEADER: LOGO VÀ TIÊU ĐỀ NỀN XANH -->
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/headerLayout"
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="72dp"
            android:gravity="center"
            android:orientation="vertical"
            android:paddingHorizontal="@dimen/spacing_xl"
            app:layout_constraintTop_toTopOf="parent"
            tools:layout_editor_absoluteX="0dp">

            <com.google.android.material.card.MaterialCardView
                android:id="@+id/cardLogo"
                android:layout_width="@dimen/login_logo_size"
                android:layout_height="@dimen/login_logo_size"
                app:cardCornerRadius="@dimen/radius_full"
                app:cardElevation="@dimen/elevation_none"
                app:strokeWidth="@dimen/border_none">

                <ImageView
                    android:id="@+id/ivLogo"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:contentDescription="@string/app_name"
                    android:padding="@dimen/spacing_l"
                    android:src="@drawable/ic_logo" />
            </com.google.android.material.card.MaterialCardView>

            <TextView
                android:id="@+id/tvWelcome"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/spacing_m"
                android:fontFamily="sans-serif-black"
                android:gravity="center"
                android:text="Chào mừng quay trở lại"
                android:textColor="?attr/colorOnPrimary"
                android:textSize="@dimen/text_size_headline_medium" />

            <TextView
                android:id="@+id/tvSubtitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/spacing_2xs"
                android:alpha="0.8"
                android:gravity="center"
                android:text="@string/login_welcome_subtitle"
                android:textColor="?attr/colorOnPrimary"
                android:textSize="@dimen/text_size_body_medium" />

        </LinearLayout>
    </androidx.constraintlayout.widget.ConstraintLayout>

    <!-- BOTTOM SHEET: THÔNG TIN TÀI KHOẢN ĐÃ LƯU & MẬT KHẨU -->
    <androidx.core.widget.NestedScrollView
        android:id="@+id/bottomSheet"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/bg_bottom_sheet"
        android:elevation="8dp"
        android:overScrollMode="never"
        app:behavior_fitToContents="true"
        app:behavior_hideable="false"
        app:behavior_peekHeight="490dp"
        app:layout_behavior="com.google.android.material.bottomsheet.BottomSheetBehavior">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingHorizontal="@dimen/spacing_xl"
            android:paddingTop="@dimen/spacing_2xl"
            android:paddingBottom="@dimen/spacing_xl">

            <!-- Card hiển thị User Profile đã lưu -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:cardBackgroundColor="?attr/colorSurfaceVariant"
                app:cardCornerRadius="@dimen/radius_l"
                app:cardElevation="0dp"
                app:strokeWidth="0dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:padding="@dimen/spacing_m">

                    <com.google.android.material.imageview.ShapeableImageView
                        android:id="@+id/ivUserAvatar"
                        android:layout_width="54dp"
                        android:layout_height="54dp"
                        android:contentDescription="Ảnh người dùng"
                        android:padding="@dimen/border_width_s"
                        android:src="@drawable/ic_avatar"
                        app:shapeAppearanceOverlay="@style/ShapeAppearance.Material3.Corner.Full"
                        app:strokeColor="?attr/colorPrimary"
                        app:strokeWidth="1.5dp" />

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="@dimen/spacing_m"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:id="@+id/tvUserName"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:ellipsize="end"
                            android:fontFamily="sans-serif-medium"
                            android:maxLines="1"
                            android:textColor="?attr/colorOnSurface"
                            android:textSize="@dimen/text_size_title_medium"
                            android:textStyle="bold"
                            tools:text="Nguyễn Viết Sơn" />

                        <TextView
                            android:id="@+id/tvCompany"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:ellipsize="end"
                            android:maxLines="1"
                            android:textColor="?attr/colorOnSurfaceVariant"
                            android:textSize="@dimen/text_size_body_small"
                            tools:text="Cty ABC" />

                        <!-- TextView SĐT đã mã hóa -->
                        <TextView
                            android:id="@+id/tvMaskedPhone"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:ellipsize="end"
                            android:maxLines="1"
                            android:textColor="?attr/colorPrimary"
                            android:textSize="@dimen/text_size_body_medium"
                            android:textStyle="bold"
                            tools:text="098* *** *89" />
                    </LinearLayout>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Field Mật khẩu -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/spacing_m"
                android:text="Mật khẩu"
                android:textColor="?attr/colorOnSurface"
                android:textSize="@dimen/text_size_body_small"
                android:textStyle="bold" />

            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/tilPassword"
                style="@style/AppTextInputLayout"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/spacing_2xs"
                app:endIconMode="password_toggle"
                app:hintEnabled="false"
                app:startIconDrawable="@drawable/ic_lock">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/edtPassword"
                    style="@style/AppTextInputEditText"
                    android:hint="Nhập mật khẩu"
                    android:inputType="textPassword" />
            </com.google.android.material.textfield.TextInputLayout>

            <TextView
                android:id="@+id/tvForgotPassword"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="end"
                android:layout_marginTop="@dimen/spacing_xs"
                android:background="?attr/selectableItemBackground"
                android:padding="@dimen/spacing_2xs"
                android:text="@string/auth_forgot_password"
                android:textColor="?attr/colorPrimary"
                android:textSize="@dimen/text_size_label_large"
                android:textStyle="bold" />

            <!-- Action Buttons (Đăng nhập & Vân tay) -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/spacing_m"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnLogin"
                    style="@style/ButtonMaxWidthStyle"
                    android:layout_width="0dp"
                    android:layout_height="@dimen/button_height_default"
                    android:layout_weight="1"
                    android:text="@string/auth_login_button"
                    app:cornerRadius="@dimen/radius_full" />

                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/btnBiometric"
                    style="@style/RadiusItemCard"
                    android:layout_width="@dimen/button_height_default"
                    android:layout_height="@dimen/button_height_default"
                    android:layout_marginStart="@dimen/spacing_m"
                    app:cardCornerRadius="@dimen/radius_full"
                    app:cardElevation="0dp"
                    app:strokeColor="?attr/colorPrimary"
                    app:strokeWidth="1dp">

                    <ImageView
                        android:layout_width="@dimen/icon_size_l"
                        android:layout_height="@dimen/icon_size_l"
                        android:layout_gravity="center"
                        android:contentDescription="Đăng nhập Sinh trắc học"
                        android:src="@drawable/ic_fingerprint"
                        app:tint="?attr/colorPrimary" />
                </com.google.android.material.card.MaterialCardView>
            </LinearLayout>

            <!-- diver -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/spacing_l"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <View
                    android:layout_width="0dp"
                    android:layout_height="1dp"
                    android:layout_weight="1"
                    android:background="?attr/colorOutlineVariant" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:paddingHorizontal="@dimen/spacing_m"
                    android:text="HOẶC"
                    android:textColor="?attr/colorOnSurfaceVariant"
                    android:textSize="@dimen/text_size_label_medium" />

                <View
                    android:layout_width="0dp"
                    android:layout_height="1dp"
                    android:layout_weight="1"
                    android:background="?attr/colorOutlineVariant" />
            </LinearLayout>

            <!-- Nút Đổi tài khoản -->
            <LinearLayout
                android:id="@+id/btnSwitchAccount"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center_horizontal"
                android:layout_marginTop="@dimen/spacing_m"
                android:background="?attr/selectableItemBackground"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center"
                android:orientation="horizontal"
                android:paddingHorizontal="@dimen/spacing_m"
                android:paddingVertical="@dimen/spacing_s">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Đăng nhập tài khoản khác? "
                    android:textColor="?attr/colorOnSurfaceVariant"
                    android:textSize="@dimen/text_size_body_medium" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Đổi tài khoản"
                    android:textColor="?attr/colorPrimary"
                    android:textSize="@dimen/text_size_body_medium"
                    android:textStyle="bold" />
            </LinearLayout>

            <!-- Nút Hỗ trợ CSKH (Được chuyển xuống vị trí dưới cùng) -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/btnContactSupport"
                style="@style/ItemCard"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center_horizontal"
                android:layout_marginTop="@dimen/spacing_xl"
                app:cardBackgroundColor="?attr/colorSurfaceVariant"
                app:cardCornerRadius="@dimen/radius_full"
                app:cardElevation="0dp"
                app:strokeWidth="0dp">

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:gravity="center"
                    android:orientation="horizontal"
                    android:paddingHorizontal="@dimen/spacing_l"
                    android:paddingVertical="@dimen/spacing_s">

                    <ImageView
                        android:layout_width="@dimen/icon_size_s"
                        android:layout_height="@dimen/icon_size_s"
                        android:layout_marginEnd="@dimen/spacing_2xs"
                        android:importantForAccessibility="no"
                        android:src="@drawable/ic_phone"
                        app:tint="?attr/colorPrimary" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/forgot_password_contact_help"
                        android:textColor="?attr/colorOnSurfaceVariant"
                        android:textSize="@dimen/text_size_body_small" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/forgot_password_contact_support"
                        android:textColor="?attr/colorPrimary"
                        android:layout_marginStart="@dimen/spacing_3xs"
                        android:textSize="@dimen/text_size_body_small"
                        android:textStyle="bold" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

    <!-- Progress Indicator -->
    <com.google.android.material.progressindicator.CircularProgressIndicator
        android:id="@+id/progressBar"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:indeterminate="true"
        android:visibility="gone"
        app:indicatorColor="?attr/colorOnPrimary" />

</androidx.coordinatorlayout.widget.CoordinatorLayout>