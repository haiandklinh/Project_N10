<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?android:attr/colorBackground">

    <!-- Header Toolbar chuẩn ứng dụng -->
    <com.example.attendanceapp.core.utils.ToolbarApp
        android:id="@+id/toolbar_app"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- Filter/Search dạng EditText chọn tháng dùng style app -->
    <com.google.android.material.textfield.TextInputLayout
        android:id="@+id/layout_filter"
        style="@style/AppTextInputLayout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_margin="@dimen/spacing_l"
        android:hint="Chọn tháng"
        app:endIconDrawable="@drawable/ic_calendar"
        app:endIconMode="custom"
        app:layout_constraintTop_toBottomOf="@id/toolbar_app">

        <com.google.android.material.textfield.TextInputEditText
            android:id="@+id/tv_month_picker"
            style="@style/AppTextInputEditText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:cursorVisible="false"
            android:focusable="false"
            android:clickable="true"
            android:longClickable="false"
            android:text="Tháng 09/2026" />
    </com.google.android.material.textfield.TextInputLayout>

    <!-- List Payroll -->
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rv_payroll_list"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:paddingHorizontal="@dimen/spacing_l"
        android:clipToPadding="false"
        app:layout_constraintTop_toBottomOf="@id/layout_filter"
        app:layout_constraintBottom_toTopOf="@id/btn_confirm_all"
        tools:listitem="@layout/item_payroll_history"/>

    <!-- Action Button chuẩn style app -->
    <com.google.android.material.button.MaterialButton
        android:id="@+id/btn_confirm_all"
        style="@style/ButtonMaxWidthStyle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_margin="@dimen/spacing_l"
        android:text="XÁC NHẬN CHỐT LƯƠNG"
        app:layout_constraintBottom_toBottomOf="parent"/>

</androidx.constraintlayout.widget.ConstraintLayout>