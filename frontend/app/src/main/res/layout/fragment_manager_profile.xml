<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?android:attr/colorBackground"
    android:fillViewport="true"
    android:overScrollMode="never"
    tools:context=".ui.manager.profile.ManagerProfileFragment">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <!-- ==================== PROFILE HEADER ================== -->
        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/layout_profile_header"
            android:layout_width="match_parent"
            android:layout_height="240dp"
            android:paddingHorizontal="@dimen/spacing_l"
            android:background="@drawable/bg_login_header"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent">

            <com.google.android.material.imageview.ShapeableImageView
                android:id="@+id/iv_avatar"
                android:layout_width="88dp"
                android:layout_height="88dp"
                android:contentDescription="Ảnh đại diện"
                android:scaleType="centerCrop"
                android:src="@drawable/ic_avatar"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                app:shapeAppearanceOverlay="@style/ImageCircleStyle"
                app:strokeColor="?attr/colorOutlineVariant"
                app:strokeWidth="1dp" />

            <TextView
                android:id="@+id/tv_user_name"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/spacing_s"
                android:text="@string/manager_profile_default_name"
                android:textColor="?attr/colorOnPrimary"
                android:textSize="@dimen/text_size_title_medium"
                android:textStyle="bold"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@id/iv_avatar" />

            <TextView
                android:id="@+id/tv_user_position"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:alpha="0.8"
                android:text="@string/manager_profile_default_pos"
                android:textColor="?attr/colorOnPrimary"
                android:textSize="@dimen/text_size_body_small"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@id/tv_user_name" />

        </androidx.constraintlayout.widget.ConstraintLayout>

        <!-- ================= PROFILE CONTENT =================== -->
        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/layout_profile_content"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="?android:attr/colorBackground"
            android:paddingStart="@dimen/spacing_l"
            android:paddingTop="50dp"
            android:paddingEnd="@dimen/spacing_l"
            android:paddingBottom="@dimen/spacing_xl"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/layout_profile_header">


            <!-- Card Tóm tắt doanh nghiệp (Mới bổ sung) -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/card_business_summary"
                style="@style/MainCard"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/spacing_s"
                app:layout_constraintTop_toTopOf="parent"
                android:elevation="2dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:padding="@dimen/spacing_m"
                    android:orientation="horizontal"
                    android:baselineAligned="false">

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:gravity="center"
                        android:orientation="vertical">
                        <TextView
                            android:id="@+id/tv_total_employees"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="24"
                            android:textColor="?attr/colorPrimary"
                            android:textSize="@dimen/text_size_title_medium"
                            android:textStyle="bold" />
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Nhân viên"
                            android:textSize="@dimen/text_size_label_small" />
                    </LinearLayout>

                    <View
                        android:layout_width="1dp"
                        android:layout_height="match_parent"
                        android:background="?attr/colorOutlineVariant"
                        android:layout_marginVertical="4dp" />

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:gravity="center"
                        android:orientation="vertical">
                        <TextView
                            android:id="@+id/tv_pending_requests"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="05"
                            android:textColor="@color/md_theme_light_error"
                            android:textSize="@dimen/text_size_title_medium"
                            android:textStyle="bold" />
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Chờ duyệt"
                            android:textSize="@dimen/text_size_label_small" />
                    </LinearLayout>

                </LinearLayout>

            </com.google.android.material.card.MaterialCardView>


            <!-- =================== QUẢN LÝ DOANH NGHIỆP ==================== -->
            <TextView
                android:id="@+id/tv_group_business"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/spacing_m"
                android:text="@string/manager_profile_section_business"
                android:textColor="?attr/colorOnSurfaceVariant"
                android:textSize="@dimen/text_size_label_medium"
                android:textStyle="bold"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/card_business_summary" />

            <com.google.android.material.card.MaterialCardView
                android:id="@+id/card_business_settings"
                style="@style/MainCard"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/spacing_s"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@id/tv_group_business">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">

                    <include android:id="@+id/row_company_settings" layout="@layout/item_profile_menu_row" />
                    <View style="@style/DividerStyle" />
                    <include android:id="@+id/row_salary_config" layout="@layout/item_profile_menu_row" />
                    <View style="@style/DividerStyle" />
                    <include android:id="@+id/row_permissions" layout="@layout/item_profile_menu_row" />
                    <View style="@style/DividerStyle" />
                    <include android:id="@+id/row_statistics" layout="@layout/item_profile_menu_row" />

                </LinearLayout>

            </com.google.android.material.card.MaterialCardView>

            <!-- =================== TÀI KHOẢN ==================== -->
            <TextView
                android:id="@+id/tv_group_account"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/spacing_xl"
                android:text="@string/profile_section_account"
                android:textColor="?attr/colorOnSurfaceVariant"
                android:textSize="@dimen/text_size_label_medium"
                android:textStyle="bold"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@id/card_business_settings" />

            <com.google.android.material.card.MaterialCardView
                android:id="@+id/card_account_settings"
                style="@style/MainCard"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/spacing_s"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@id/tv_group_account">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">

                    <include android:id="@+id/row_edit_profile" layout="@layout/item_profile_menu_row" />
                    <View style="@style/DividerStyle" />
                    <include android:id="@+id/row_change_password" layout="@layout/item_profile_menu_row" />
                    <View style="@style/DividerStyle" />
                    <include android:id="@+id/row_notification_settings" layout="@layout/item_profile_menu_row" />
                    <View style="@style/DividerStyle" />
                    <include android:id="@+id/row_personal_history" layout="@layout/item_profile_menu_row" />

                </LinearLayout>

            </com.google.android.material.card.MaterialCardView>

            <!-- ==================== ỨNG DỤNG ==================== -->
            <TextView
                android:id="@+id/tv_group_app"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/spacing_xl"
                android:text="@string/profile_section_app"
                android:textColor="?attr/colorOnSurfaceVariant"
                android:textSize="@dimen/text_size_label_medium"
                android:textStyle="bold"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@id/card_account_settings" />

            <com.google.android.material.card.MaterialCardView
                android:id="@+id/card_app_settings"
                style="@style/MainCard"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/spacing_s"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@id/tv_group_app">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">

                    <include android:id="@+id/row_language" layout="@layout/item_profile_menu_row" />
                    <View style="@style/DividerStyle" />
                    <include android:id="@+id/row_themes" layout="@layout/item_profile_menu_row" />
                    <View style="@style/DividerStyle" />
                    <include android:id="@+id/row_dark_mode" layout="@layout/item_profile_switch_row" />
                    <View style="@style/DividerStyle" />
                    <include android:id="@+id/row_help_support" layout="@layout/item_profile_menu_row" />
                    <View style="@style/DividerStyle" />
                    <include android:id="@+id/row_about_app" layout="@layout/item_profile_menu_row" />

                </LinearLayout>

            </com.google.android.material.card.MaterialCardView>

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_logout"
                style="@style/Widget.Material3.Button.OutlinedButton"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:layout_marginTop="@dimen/spacing_3xl"
                android:text="@string/profile_logout_button"
                android:textColor="@color/md_theme_light_error"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@id/card_app_settings"
                app:strokeColor="@color/md_theme_light_error"
                app:strokeWidth="1dp" />

            <TextView
                android:id="@+id/tv_app_version"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/spacing_l"
                android:text="@string/profile_version"
                android:layout_marginBottom="100dp"
                android:textColor="?attr/colorOnSurfaceVariant"
                android:textSize="@dimen/text_size_label_small"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@id/btn_logout" />

        </androidx.constraintlayout.widget.ConstraintLayout>

        <!-- ============ TỔNG HỢP NHANH (Invite & Stats) ================== -->
        <LinearLayout
            android:id="@+id/layout_summary_cards"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingHorizontal="@dimen/spacing_l"
            app:layout_constraintBottom_toTopOf="@id/layout_profile_content"
            app:layout_constraintTop_toBottomOf="@id/layout_profile_header">

            <!-- Card Mã mời -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/card_invite_code"
                style="@style/CategoryCard"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">

                <androidx.constraintlayout.widget.ConstraintLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:padding="@dimen/spacing_m">

                    <!-- Tiêu đề Card -->
                    <TextView
                        android:id="@+id/tv_invite_title"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:text="@string/manager_profile_invite_title"
                        android:textColor="?attr/colorOnPrimaryContainer"
                        android:textSize="@dimen/text_size_body_medium"
                        android:textStyle="bold"
                        app:layout_constraintEnd_toStartOf="@id/btn_copy_code"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toTopOf="parent"
                        tools:text="Mã giới thiệu quản lý" />

                    <!-- Mã Code (BKS-CODE-2024) -->
                    <TextView
                        android:id="@+id/tv_invite_code"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textColor="?attr/colorPrimary"
                        android:textSize="@dimen/text_size_title_large"
                        android:textStyle="bold"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toBottomOf="@id/tv_invite_title"
                        tools:text="BKS-CODE-2024" />

                    <!-- Môn tả/Ghi chú bên dưới mã Code -->
                    <TextView
                        android:id="@+id/tv_invite_description"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:textColor="?attr/colorOnPrimaryContainer"
                        android:textSize="@dimen/text_size_body_small"
                        app:layout_constraintEnd_toStartOf="@id/btn_copy_code"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toBottomOf="@id/tv_invite_code"
                        tools:text="Chia sẻ mã này để mời nhân viên tham gia vào hệ thống." />

                    <!-- Nút Copy căn giữa theo chiều dọc của Card -->
                    <ImageView
                        android:id="@+id/btn_copy_code"
                        android:layout_width="24dp"
                        android:layout_height="24dp"
                        android:layout_marginStart="@dimen/spacing_s"
                        android:background="?attr/selectableItemBackgroundBorderless"
                        android:contentDescription="Sao chép mã"
                        android:padding="2dp"
                        android:src="@drawable/ic_copy"
                        app:layout_constraintBottom_toBottomOf="parent"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintTop_toTopOf="parent"
                        app:tint="?attr/colorPrimary" />

                </androidx.constraintlayout.widget.ConstraintLayout>

            </com.google.android.material.card.MaterialCardView>

        </LinearLayout>

    </androidx.constraintlayout.widget.ConstraintLayout>

</androidx.core.widget.NestedScrollView>
