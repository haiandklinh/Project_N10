<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?android:attr/colorBackground">

    <!-- Header Toolbar chuẩn ứng dụng -->
    <com.example.attendanceapp.core.utils.ToolbarApp
        android:id="@+id/toolbar_app"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:fillViewport="true"
        app:layout_constraintTop_toBottomOf="@id/toolbar_app"
        app:layout_constraintBottom_toBottomOf="parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="@dimen/spacing_l">

            <!-- Chọn loại hình -->
            <TextView
                style="@style/TitleTextMediumStyle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Hình thức áp dụng"
                android:layout_marginBottom="@dimen/spacing_s"/>

            <RadioGroup
                android:id="@+id/rg_type"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginBottom="@dimen/spacing_l">

                <RadioButton
                    android:id="@+id/rb_reward"
                    style="@style/BodyTextLargeStyle"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Khen thưởng (+)"
                    android:checked="true"/>

                <RadioButton
                    android:id="@+id/rb_punish"
                    style="@style/BodyTextLargeStyle"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Khấu trừ / Phạt (-)"/>
            </RadioGroup>

            <!-- Chọn Nhân viên -->
            <com.google.android.material.textfield.TextInputLayout
                style="@style/AppTextInputLayout"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="Chọn nhân sự áp dụng"
                android:layout_marginBottom="@dimen/spacing_l"
                app:startIconDrawable="@drawable/ic_check"
                app:endIconMode="custom">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/tv_select_employee"
                    style="@style/AppTextInputEditText"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:cursorVisible="false"
                    android:focusable="false"
                    android:clickable="true"
                    android:longClickable="false"
                    android:text="Nhấn để chọn nhân viên từ danh sách..." />
            </com.google.android.material.textfield.TextInputLayout>

            <!-- Nhập Số tiền -->
            <com.google.android.material.textfield.TextInputLayout
                style="@style/AppTextInputLayout"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="@dimen/spacing_l"
                android:hint="Số tiền"
                app:suffixText="VNĐ"
                app:suffixTextAppearance="@style/BodyTextSmallStyle">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/et_amount"
                    style="@style/AppTextInputEditText"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:inputType="number" />

            </com.google.android.material.textfield.TextInputLayout>

            <!-- Lý do / Nội dung chi tiết -->
            <com.google.android.material.textfield.TextInputLayout
                style="@style/AppTextInputLayout"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="Lý do cụ thể"
                android:layout_marginBottom="@dimen/spacing_xl"
                app:helperText="Ví dụ: Khen thưởng thành tích xuất sắc, vi phạm quy định đi trễ...">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/et_reason"
                    style="@style/AppTextInputEditText"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:minLines="4"
                    android:gravity="top|start"
                    android:inputType="textMultiLine" />
            </com.google.android.material.textfield.TextInputLayout>
            <!-- Gửi xác nhận -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_submit"
                style="@style/ButtonMaxWidthStyle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="LƯU QUYẾT ĐỊNH" />

        </LinearLayout>
    </ScrollView>

</androidx.constraintlayout.widget.ConstraintLayout>