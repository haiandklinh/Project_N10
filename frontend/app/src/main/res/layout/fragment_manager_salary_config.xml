<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?attr/colorSurface"
    android:fitsSystemWindows="true">

    <!-- Toolbar -->
    <com.google.android.material.appbar.AppBarLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="?attr/colorSurface"
        app:elevation="0dp">

        <com.example.attendanceapp.core.utils.ToolbarApp
            android:id="@+id/toolbar_app"
            android:layout_width="match_parent"
            android:layout_height="wrap_content" />

    </com.google.android.material.appbar.AppBarLayout>

    <!-- Nội dung -->
    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:clipToPadding="false"
        android:fillViewport="true"
        android:overScrollMode="never"
        android:paddingBottom="112dp"
        app:layout_behavior="@string/appbar_scrolling_view_behavior">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="@dimen/spacing_l"
            android:paddingTop="@dimen/spacing_m"
            android:paddingEnd="@dimen/spacing_l"
            android:paddingBottom="@dimen/spacing_l">

            <!-- Banner Hướng dẫn / Cảnh báo -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="@dimen/spacing_l"
                app:cardBackgroundColor="?attr/colorPrimaryContainer"
                app:cardCornerRadius="@dimen/radius_m"
                app:cardElevation="0dp"
                app:strokeWidth="0dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:padding="@dimen/spacing_m">

                    <ImageView
                        android:layout_width="24dp"
                        android:layout_height="24dp"
                        android:contentDescription="@null"
                        android:src="@drawable/ic_warning"
                        app:tint="?attr/colorPrimary" />

                    <TextView
                        style="@style/BodyTextSmallStyle"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:layout_marginStart="@dimen/spacing_s"
                        android:lineSpacingExtra="2dp"
                        android:text="@string/salary_config_notice"
                        android:textColor="?attr/colorOnPrimaryContainer" />

                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- PHẦN 1 -->
            <TextView
                style="@style/TitleTextMediumStyle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginBottom="@dimen/spacing_m"
                android:text="@string/salary_config_group_rates"
                android:textColor="?attr/colorPrimary"
                android:textStyle="bold" />

            <com.google.android.material.card.MaterialCardView
                style="@style/MainCard"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="@dimen/spacing_l"
                app:cardCornerRadius="@dimen/radius_m"
                app:cardElevation="1dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="@dimen/spacing_m">

                    <!-- Ca Sáng -->
                    <com.google.android.material.textfield.TextInputLayout
                        style="@style/AppTextInputLayout"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:hint="@string/salary_config_shift_morning"
                        app:prefixText="₫"
                        app:startIconDrawable="@drawable/ic_history"
                        app:suffixText="/ ca">

                        <com.google.android.material.textfield.TextInputEditText
                            android:id="@+id/et_rate_morning"
                            style="@style/AppTextInputEditText"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:inputType="number"
                            android:text="180000" />

                    </com.google.android.material.textfield.TextInputLayout>

                    <!-- Ca Chiều -->
                    <com.google.android.material.textfield.TextInputLayout
                        style="@style/AppTextInputLayout"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/spacing_m"
                        android:hint="@string/salary_config_shift_afternoon"
                        app:prefixText="₫"
                        app:startIconDrawable="@drawable/ic_history"
                        app:suffixText="/ ca">

                        <com.google.android.material.textfield.TextInputEditText
                            android:id="@+id/et_rate_afternoon"
                            style="@style/AppTextInputEditText"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:inputType="number"
                            android:text="180000" />

                    </com.google.android.material.textfield.TextInputLayout>

                    <!-- Ca Tối -->
                    <com.google.android.material.textfield.TextInputLayout
                        style="@style/AppTextInputLayout"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/spacing_m"
                        android:hint="@string/salary_config_shift_night"
                        app:prefixText="₫"
                        app:startIconDrawable="@drawable/ic_history"
                        app:suffixText="/ ca">

                        <com.google.android.material.textfield.TextInputEditText
                            android:id="@+id/et_rate_night"
                            style="@style/AppTextInputEditText"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:inputType="number"
                            android:text="120000" />

                    </com.google.android.material.textfield.TextInputLayout>

                    <!-- Toàn thời gian -->
                    <com.google.android.material.textfield.TextInputLayout
                        style="@style/AppTextInputLayout"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/spacing_m"
                        android:hint="@string/salary_config_shift_fulltime"
                        app:prefixText="₫"
                        app:startIconDrawable="@drawable/ic_calendar"
                        app:suffixText="/ ca">

                        <com.google.android.material.textfield.TextInputEditText
                            android:id="@+id/et_rate_fulltime"
                            style="@style/AppTextInputEditText"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:inputType="number"
                            android:text="400000" />

                    </com.google.android.material.textfield.TextInputLayout>

                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- PHẦN 2 -->
            <TextView
                style="@style/TitleTextMediumStyle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginBottom="@dimen/spacing_m"
                android:text="@string/salary_config_group_adjustments"
                android:textColor="?attr/colorPrimary"
                android:textStyle="bold" />

            <com.google.android.material.card.MaterialCardView
                style="@style/MainCard"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:cardCornerRadius="@dimen/radius_m"
                app:cardElevation="1dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="@dimen/spacing_m">

                    <!-- Phạt đi muộn -->
                    <com.google.android.material.textfield.TextInputLayout
                        style="@style/AppTextInputLayout"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:hint="@string/salary_config_penalty_late"
                        app:helperText="@string/salary_config_penalty_helper"
                        app:prefixText="₫"
                        app:startIconDrawable="@drawable/ic_late"
                        app:suffixText="/ lần">

                        <com.google.android.material.textfield.TextInputEditText
                            android:id="@+id/et_penalty_late"
                            style="@style/AppTextInputEditText"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:inputType="number"
                            android:text="30000" />

                    </com.google.android.material.textfield.TextInputLayout>

                    <!-- Hệ số lương ngày nghỉ -->
                    <com.google.android.material.textfield.TextInputLayout
                        style="@style/AppTextInputLayout"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/spacing_m"
                        android:hint="@string/salary_config_multiplier_weekend"
                        app:helperText="@string/salary_config_multiplier_helper"
                        app:startIconDrawable="@drawable/ic_chart"
                        app:suffixText="x">

                        <com.google.android.material.textfield.TextInputEditText
                            android:id="@+id/et_weekend_multiplier"
                            style="@style/AppTextInputEditText"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:digits="0123456789."
                            android:inputType="numberDecimal"
                            android:text="1.5" />

                    </com.google.android.material.textfield.TextInputLayout>

                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

    <!-- Thanh lưu cố định -->
    <com.google.android.material.card.MaterialCardView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:backgroundTint="?attr/colorSurface"
        app:cardCornerRadius="0dp"
        app:cardElevation="8dp"
        app:strokeWidth="0dp">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_save_config"
            style="@style/ButtonMaxWidthStyle"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:layout_margin="@dimen/spacing_l"
            android:text="@string/salary_config_action_update"
            android:textSize="16sp"
            android:textStyle="bold"
            app:cornerRadius="@dimen/radius_m" />

    </com.google.android.material.card.MaterialCardView>

</androidx.coordinatorlayout.widget.CoordinatorLayout>