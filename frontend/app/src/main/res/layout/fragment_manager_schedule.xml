<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?android:attr/colorBackground"
    tools:context=".ui.manager.schedule.ManagerScheduleFragment">

    <com.google.android.material.appbar.MaterialToolbar
        android:id="@+id/toolbar"
        android:layout_width="match_parent"
        android:layout_height="@dimen/button_height_m"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:title="Quản lý lịch làm việc"
        app:titleCentered="false"
        app:titleTextAppearance="@style/TitleTextLargeStyle" />

    <com.google.android.material.card.MaterialCardView
        android:id="@+id/card_header"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="@dimen/spacing_m"
        android:layout_marginTop="@dimen/spacing_xs"
        app:cardCornerRadius="@dimen/radius_l"
        app:cardElevation="0dp"
        app:layout_constraintTop_toBottomOf="@id/toolbar"
        app:strokeWidth="0dp">

        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/layout_header"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_card_gradient"
            android:padding="@dimen/spacing_m">

            <!-- Cụm điều hướng tháng/năm (Căn giữa) -->
            <LinearLayout
                android:id="@+id/layout_month_navigation"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:orientation="horizontal"
                app:layout_constraintBottom_toBottomOf="@id/toggle_group_time"
                app:layout_constraintEnd_toStartOf="@id/divider_vertical"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="@id/toggle_group_time">

                <ImageView
                    android:id="@+id/btn_prev_month"
                    android:layout_width="@dimen/icon_size_xl"
                    android:layout_height="@dimen/icon_size_xl"
                    android:background="@drawable/bg_time_icon_circle"
                    android:clickable="true"
                    android:contentDescription="Tháng trước"
                    android:focusable="true"
                    android:padding="@dimen/spacing_xs"
                    android:src="@drawable/ic_chevron_left"
                    app:tint="?attr/colorOnPrimary" />

                <TextView
                    android:id="@+id/tv_month_title"
                    style="@style/TitleTextMediumStyle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginHorizontal="@dimen/spacing_s"
                    android:ellipsize="end"
                    android:maxLines="1"
                    android:textColor="?attr/colorOnPrimary"
                    android:textStyle="bold"
                    tools:text="Tháng 9/2026" />

                <ImageView
                    android:id="@+id/btn_next_month"
                    android:layout_width="@dimen/icon_size_xl"
                    android:layout_height="@dimen/icon_size_xl"
                    android:background="@drawable/bg_time_icon_circle"
                    android:clickable="true"
                    android:contentDescription="Tháng sau"
                    android:focusable="true"
                    android:padding="@dimen/spacing_xs"
                    android:src="@drawable/ic_chevron_right"
                    app:tint="?attr/colorOnPrimary" />
            </LinearLayout>

            <!-- Đường dọc phẩy nhẹ chia giữa cụm Tháng và Toggle -->
            <View
                android:id="@+id/divider_vertical"
                android:layout_width="1dp"
                android:layout_height="22dp"
                android:layout_marginHorizontal="@dimen/spacing_s"
                android:alpha="0.3"
                android:background="?attr/colorOnPrimary"
                app:layout_constraintBottom_toBottomOf="@id/toggle_group_time"
                app:layout_constraintEnd_toStartOf="@id/toggle_group_time"
                app:layout_constraintTop_toTopOf="@id/toggle_group_time" />

            <!-- Toggle Button Tuần / Tháng (Căn phải) -->
            <com.google.android.material.button.MaterialButtonToggleGroup
                android:id="@+id/toggle_group_time"
                android:layout_width="wrap_content"
                android:layout_height="28dp"
                android:layout_marginVertical="@dimen/spacing_xs"
                app:checkedButton="@id/btn_mode_week"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                app:selectionRequired="true"
                app:singleSelection="true">

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btn_mode_week"
                    style="@style/Widget.Material3.Button.OutlinedButton"
                    android:layout_width="36dp"
                    android:layout_height="match_parent"
                    android:backgroundTint="@color/filter_chip_bg_selector"
                    android:insetLeft="0dp"
                    android:insetTop="0dp"
                    android:insetRight="0dp"
                    android:insetBottom="0dp"
                    android:padding="0dp"
                    android:text="W"
                    android:textColor="@color/filter_chip_text_selector"
                    android:textSize="@dimen/text_size_label_medium"
                    android:textStyle="bold" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btn_mode_month"
                    style="@style/Widget.Material3.Button.OutlinedButton"
                    android:layout_width="36dp"
                    android:layout_height="match_parent"
                    android:backgroundTint="@color/filter_chip_bg_selector"
                    android:insetLeft="0dp"
                    android:insetTop="0dp"
                    android:insetRight="0dp"
                    android:insetBottom="0dp"
                    android:padding="0dp"
                    android:text="M"
                    android:textColor="@color/filter_chip_text_selector"
                    android:textSize="@dimen/text_size_label_medium"
                    android:textStyle="bold" />
            </com.google.android.material.button.MaterialButtonToggleGroup>

            <!-- Đường ngang phân cách mảnh -->
            <View
                android:id="@+id/divider_calendar_top"
                android:layout_width="0dp"
                android:layout_height="1dp"
                android:layout_marginTop="@dimen/spacing_s"
                android:alpha="0.2"
                android:background="?attr/colorOnPrimary"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@id/toggle_group_time" />

            <!-- Strip lịch 7 ngày (Tuần) -->
            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/rv_week_days"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/spacing_xs"
                android:clipToPadding="false"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@id/divider_calendar_top"
                tools:itemCount="7"
                tools:layoutManager="androidx.recyclerview.widget.GridLayoutManager"
                tools:listitem="@layout/item_schedule_week_day"
                tools:spanCount="7" />

        </androidx.constraintlayout.widget.ConstraintLayout>
    </com.google.android.material.card.MaterialCardView>

    <!-- Các view nội dung bên dưới giữ nguyên -->
    <TextView
        android:id="@+id/tv_schedule_hint"
        style="@style/TitleTextMediumStyle"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/spacing_m"
        android:layout_marginEnd="@dimen/spacing_s"
        android:ellipsize="end"
        android:maxLines="1"
        android:textColor="?android:attr/textColorSecondary"
        app:layout_constraintBottom_toBottomOf="@id/btn_add_shift"
        app:layout_constraintEnd_toStartOf="@id/btn_add_shift"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="@id/btn_add_shift"
        tools:text="Hôm nay - Thứ 2, 29/9/2026" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/btn_add_shift"
        style="@style/ButtonFilledSmallStyle"
        android:layout_width="wrap_content"
        android:layout_height="@dimen/button_height_xs"
        android:layout_marginTop="@dimen/spacing_xs"
        android:layout_marginEnd="@dimen/spacing_m"
        android:backgroundTint="?attr/colorPrimaryContainer"
        android:paddingHorizontal="@dimen/spacing_s"
        android:text="Xếp ca"
        android:textColor="?attr/colorPrimary"
        app:icon="@drawable/ic_add"
        app:iconPadding="@dimen/spacing_xs"
        app:iconTint="?attr/colorPrimary"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toBottomOf="@id/card_header" />

    <View
        android:id="@+id/divider1"
        android:layout_width="0dp"
        android:layout_height="1dp"
        android:layout_marginTop="@dimen/spacing_xs"
        android:background="?attr/colorOutlineVariant"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/btn_add_shift" />

    <HorizontalScrollView
        android:id="@+id/scroll_view_chips"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:clipToPadding="false"
        android:paddingHorizontal="@dimen/spacing_s"
        android:paddingVertical="@dimen/spacing_s"
        android:scrollbars="none"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/divider1">

        <com.google.android.material.chip.ChipGroup
            android:id="@+id/chip_group_shifts"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            app:chipSpacingHorizontal="@dimen/spacing_s"
            app:selectionRequired="true"
            app:singleLine="true"
            app:singleSelection="true">
        </com.google.android.material.chip.ChipGroup>
    </HorizontalScrollView>

    <androidx.swiperefreshlayout.widget.SwipeRefreshLayout
        android:id="@+id/swipe_refresh_layout"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/scroll_view_chips">

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/rv_employees"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:clipToPadding="false"
            android:paddingHorizontal="@dimen/spacing_m"
            android:paddingTop="@dimen/spacing_xs"
            android:paddingBottom="80dp"
            tools:listitem="@layout/item_manager_schedule_employee" />
    </androidx.swiperefreshlayout.widget.SwipeRefreshLayout>

    <include
        android:id="@+id/layout_calendar_month"
        layout="@layout/layout_schedule_calendar"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_marginHorizontal="@dimen/spacing_xs"
        android:layout_marginTop="@dimen/spacing_xs"
        android:visibility="gone"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/card_header" />

    <include
        android:id="@+id/layout_empty_state"
        layout="@layout/layout_empty_state"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:visibility="gone"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/scroll_view_chips"
        tools:visibility="visible" />

</androidx.constraintlayout.widget.ConstraintLayout>