<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?attr/colorSurface"
    android:fitsSystemWindows="true">

    <!-- Nút Bỏ qua -->
    <TextView
        android:id="@+id/btnSkip"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:clickable="true"
        android:focusable="true"
        android:padding="@dimen/spacing_m"
        android:layout_marginEnd="@dimen/spacing_xl"
        android:text="@string/onboarding_skip"
        android:textColor="?attr/colorOnSurfaceVariant"
        android:textSize="@dimen/text_size_body_medium"
        android:textStyle="bold"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        tools:text="@string/onboarding_skip" />

    <!-- ViewPager chứa các slide -->
    <androidx.viewpager2.widget.ViewPager2
        android:id="@+id/viewPagerOnboarding"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:paddingStart="60dp"
        android:paddingEnd="60dp"
        android:overScrollMode="never"
        app:layout_constraintBottom_toTopOf="@id/tabIndicator"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/btnSkip" />

    <!-- Dot indicator (Chỉ số trang) -->
    <me.relex.circleindicator.CircleIndicator3
        android:id="@+id/tabIndicator"
        android:layout_width="wrap_content"
        android:layout_height="@dimen/spacing_2xl"
        android:layout_marginBottom="@dimen/spacing_l"

        app:layout_constraintBottom_toTopOf="@id/btnNext"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent" />

    <!-- Nút Tiếp theo / Bắt đầu ngay -->
    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnNext"
        style="@style/ButtonMaxWidthStyle"
        android:layout_width="0dp"
        android:layout_height="52dp"
        android:layout_marginHorizontal="@dimen/spacing_xl"
        android:layout_marginBottom="@dimen/spacing_3xl"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        tools:text="Tiếp theo" />

</androidx.constraintlayout.widget.ConstraintLayout>