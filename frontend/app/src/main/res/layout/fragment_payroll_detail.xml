<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?android:attr/colorBackground">

    <com.example.attendanceapp.core.utils.ToolbarApp
        android:id="@+id/toolbar_app"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <!-- NỘI DUNG CUỘN -->
    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:fillViewport="true"
        android:overScrollMode="never"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintTop_toBottomOf="@id/toolbar_app">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="@dimen/spacing_m">

            <!-- 1. CARD BLUE HEADER THÔNG TIN NHÂN VIÊN & THỰC LĨNH -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                style="@style/MainCard">

                <androidx.constraintlayout.widget.ConstraintLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="@drawable/bg_card_gradient"
                    android:padding="@dimen/spacing_l">

                    <!-- AVATAR TRÒN KHỞI TẠO TÊN -->
                  <com.google.android.material.imageview.ShapeableImageView
                      android:id="@+id/iv_avatar"
                      android:layout_width="@dimen/avatar_size_l"
                      android:layout_height="@dimen/avatar_size_l"
                      app:shapeAppearanceOverlay="@style/ImageCircleStyle"
                      android:padding="1dp"
                      app:strokeColor="?attr/colorOutlineVariant"
                      app:strokeWidth="1dp"
                      app:layout_constraintStart_toStartOf="parent"
                      app:layout_constraintTop_toTopOf="parent"
                      app:srcCompat="@drawable/ic_avatar" />

                    <!-- TÊN NHÂN VIÊN & PHÒNG BAN -->
                    <TextView
                        android:id="@+id/tv_employee_name"
                        style="@style/TitleTextLargeStyle"
                        android:textColor="?attr/colorSurface"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="12dp"
                        app:layout_constraintStart_toEndOf="@id/iv_avatar"
                        app:layout_constraintTop_toTopOf="@id/iv_avatar"
                        tools:text="Nguyễn Văn An" />

                    <TextView
                        android:id="@+id/tv_department"
                        style="@style/BodyTextMediumStyle"
                        android:textColor="?attr/colorSurface"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:background="@drawable/bg_time_chip"
                        android:paddingHorizontal="@dimen/spacing_s"
                        app:layout_constraintStart_toStartOf="@id/tv_employee_name"
                        app:layout_constraintTop_toBottomOf="@id/tv_employee_name"
                        tools:text="Kỹ thuật" />

                    <!-- TIÊU ĐỀ THỰC LĨNH -->
                    <TextView
                        android:id="@+id/tv_label_net_salary"
                        style="@style/BodyTextMediumStyle"
                        android:textColor="?attr/colorSurface"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/spacing_l"
                        android:paddingHorizontal="@dimen/spacing_s"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toBottomOf="@id/iv_avatar"
                        tools:text="Thực lĩnh tháng 08/2026" />

                    <!-- SỐ TIỀN THỰC LĨNH LỚN -->
                    <TextView
                        android:id="@+id/tv_net_salary_amount"
                        style="@style/TitleTextLargeStyle"
                        android:textSize="32sp"
                        android:textColor="?attr/colorSurface"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/spacing_3xs"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toBottomOf="@id/tv_label_net_salary"
                        tools:text="14.818.182 đ" />

                    <ImageView
                        android:id="@+id/iv_status"
                        android:layout_width="@dimen/icon_size_s"
                        android:layout_height="@dimen/icon_size_s"
                        android:layout_marginTop="@dimen/spacing_m"
                        android:src="@drawable/ic_check"
                        app:tint="?attr/colorAttendancePresent"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toBottomOf="@id/tv_net_salary_amount" />

                    <!-- TRẠNG THÁI THANH TOÁN -->
                    <TextView
                        android:id="@+id/tv_payment_date"
                        style="@style/TitleTextSmallStyle"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="@dimen/spacing_s"
                        android:background="@drawable/bg_time_chip"
                        android:paddingHorizontal="@dimen/spacing_xs"
                        android:textColor="?attr/colorAttendancePresent"
                        app:layout_constraintBottom_toBottomOf="@+id/iv_status"
                        app:layout_constraintStart_toEndOf="@id/iv_status"
                        app:layout_constraintTop_toTopOf="@+id/iv_status"
                        tools:text="Đã chi trả ngày 5/9/2026" />

                </androidx.constraintlayout.widget.ConstraintLayout>

            </com.google.android.material.card.MaterialCardView>

            <!-- 2. CARD CHI TIẾT TÍNH LƯƠNG -->
            <com.google.android.material.card.MaterialCardView
                style="@style/MainCard"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginVertical="@dimen/spacing_l">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="@dimen/spacing_l">

                    <TextView
                        style="@style/TitleTextMediumStyle"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="@dimen/spacing_s"
                        android:text="Chi tiết tính lương"
                        android:textStyle="bold" />

                    <!-- DÒNG 1: LƯƠNG CƠ BẢN -->
                    <include
                        android:id="@+id/row_base_salary"
                        layout="@layout/item_salary_detail_row" />

                    <View style="@style/DividerStyle" android:alpha="0.3" />

                    <!-- DÒNG 2: NGÀY CÔNG THỰC TẾ -->
                    <include
                        android:id="@+id/row_actual_work"
                        layout="@layout/item_salary_detail_row" />

                    <View style="@style/DividerStyle" android:alpha="0.3" />

                    <!-- DÒNG 3: THƯỞNG & PHỤ CẤP -->
                    <include
                        android:id="@+id/row_bonus"
                        layout="@layout/item_salary_detail_row" />

                    <View style="@style/DividerStyle" android:alpha="0.3" />

                    <!-- DÒNG 4: KHẨU TRỪ & PHẠT -->
                    <include
                        android:id="@+id/row_deductions"
                        layout="@layout/item_salary_detail_row" />

                    <View style="@style/DividerStyle" android:alpha="0.3" />

                    <!-- DÒNG 5: TỔNG THỰC LĨNH -->
                    <include
                        android:id="@+id/row_total_net"
                        layout="@layout/item_salary_detail_row" />

                </LinearLayout>

            </com.google.android.material.card.MaterialCardView>

            <!-- 3. NHÓM 3 CARD TÓM TẮT PHÍA DƯỚI CÙNG -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:baselineAligned="false"
                android:orientation="horizontal">

                <!-- CARD 1: NGÀY CÔNG -->
                <com.google.android.material.card.MaterialCardView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    style="@style/MainCard"
                    android:layout_marginEnd="@dimen/spacing_xs"
                    android:layout_weight="1"
                    app:cardBackgroundColor="?attr/colorAttendanceLateContainer">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center"
                        android:orientation="vertical"
                        android:padding="@dimen/spacing_l">

                        <ImageView
                            android:layout_width="@dimen/icon_size_m"
                            android:layout_height="@dimen/icon_size_m"
                            android:src="@drawable/ic_calendar"
                            app:tint="?attr/colorAttendanceLate"/>

                        <TextView
                            android:id="@+id/tv_summary_days"
                            style="@style/TitleTextMediumStyle"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="@dimen/spacing_2xs"
                            android:textColor="?attr/colorAttendanceLate"
                            tools:text="21/22" />

                        <TextView
                            style="@style/BodyTextSmallStyle"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:textColor="?attr/colorAttendanceLate"
                            android:text="Ngày công" />
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <!-- CARD 2: THƯỞNG -->
                <com.google.android.material.card.MaterialCardView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    style="@style/MainCard"
                    android:layout_marginEnd="@dimen/spacing_xs"
                    android:layout_weight="1"
                    app:cardBackgroundColor="?attr/colorAttendancePresentContainer">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center"
                        android:orientation="vertical"
                        android:padding="16dp">

                        <ImageView
                            android:layout_width="@dimen/icon_size_m"
                            android:layout_height="@dimen/icon_size_m"
                            android:src="@drawable/ic_gift"
                            app:tint="?attr/colorAttendancePresent"/>

                        <TextView
                            android:id="@+id/tv_summary_bonus"
                            style="@style/TitleTextMediumStyle"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="@dimen/spacing_2xs"
                            android:textColor="?attr/colorAttendancePresent"
                            tools:text="+0.5M" />

                        <TextView
                            style="@style/BodyTextSmallStyle"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:textColor="?attr/colorAttendancePresent"
                            android:text="Thưởng" />
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <!-- CARD 3: KHẨU TRỪ -->
                <com.google.android.material.card.MaterialCardView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    style="@style/MainCard"
                    android:layout_weight="1"
                    app:cardBackgroundColor="?attr/colorAttendanceAbsentContainer">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center"
                        android:orientation="vertical"
                        android:padding="16dp">

                        <ImageView
                            android:layout_width="@dimen/icon_size_m"
                            android:layout_height="@dimen/icon_size_m"
                            android:src="@drawable/ic_heart_broken"
                            app:tint="?attr/colorAttendanceAbsent"/>

                        <TextView
                            android:id="@+id/tv_summary_deduction"
                            style="@style/TitleTextMediumStyle"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="@dimen/spacing_2xs"
                            android:textColor="?attr/colorAttendanceAbsent"
                            tools:text="-0.68M" />

                        <TextView
                            style="@style/BodyTextSmallStyle"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:textColor="?attr/colorAttendanceAbsent"
                            android:text="Khấu trừ" />
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

            </LinearLayout>

        </LinearLayout>

    </androidx.core.widget.NestedScrollView>

</androidx.constraintlayout.widget.ConstraintLayout>