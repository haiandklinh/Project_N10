<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?android:attr/colorBackground">

    <!-- Import Toolbar dùng chung -->
    <com.example.attendanceapp.core.utils.ToolbarApp
        android:id="@+id/toolbar_app"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:layout_constraintTop_toTopOf="parent" />

    <androidx.swiperefreshlayout.widget.SwipeRefreshLayout
        android:id="@+id/swipe_refresh_layout"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintTop_toBottomOf="@id/toolbar_app">

        <androidx.core.widget.NestedScrollView
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:fillViewport="true">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="@dimen/spacing_l">

                <!-- 0. THÔNG BÁO HẠN MỨC ĐỔI CA (Đưa lên đầu) -->
                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/card_quota_info"
                    style="@style/MainCard"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    app:cardBackgroundColor="?attr/colorSurfaceContainerHigh"
                    app:strokeWidth="0dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="12dp">

                        <TextView
                            android:id="@+id/tv_quota_status"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:textColor="?attr/colorOnSurfaceVariant"
                            android:textSize="13sp"
                            tools:text="Hạn mức tháng này: Bạn còn 2/4 lần xin đổi ca." />

                        <com.google.android.material.progressindicator.LinearProgressIndicator
                            android:id="@+id/progress_quota"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="8dp"
                            app:trackCornerRadius="4dp"
                            app:trackThickness="6dp" />
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <!-- 1. BƯỚC 1: CHỌN CA CỦA BẠN -->
                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/spacing_m"
                    android:text="1. Chọn ca của bạn muốn đổi"
                    android:textColor="?attr/colorOnSurface"
                    android:textSize="@dimen/text_size_title_small"
                    android:textStyle="bold" />

                <com.google.android.material.progressindicator.LinearProgressIndicator
                    android:id="@+id/progress_my_shifts"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/spacing_s"
                    android:indeterminate="true"
                    android:visibility="gone" />

                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/rv_my_shifts"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/spacing_s"
                    android:nestedScrollingEnabled="false"
                    android:overScrollMode="never"
                    tools:itemCount="2"
                    tools:listitem="@layout/item_shift_upcoming" />

                <TextView
                    android:id="@+id/tv_empty_my_shifts"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/spacing_s"
                    android:background="?attr/colorSurfaceContainerLow"
                    android:padding="16dp"
                    android:text="Bạn hiện không có ca làm việc sắp tới nào để đổi."
                    android:textColor="?attr/colorOnSurfaceVariant"
                    android:textSize="13sp"
                    android:visibility="gone" />

                <!-- 2. BƯỚC 2: CHỌN CA TRỐNG MUỐN ĐỔI SANG -->
                <TextView
                    android:id="@+id/tv_available_shift_label"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/spacing_l"
                    android:text="2. Chọn ca trống / ca khả dụng muốn đổi sang"
                    android:textColor="?attr/colorOnSurface"
                    android:textSize="@dimen/text_size_title_small"
                    android:textStyle="bold" />

                <com.google.android.material.progressindicator.LinearProgressIndicator
                    android:id="@+id/progress_available_shifts"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/spacing_s"
                    android:indeterminate="true"
                    android:visibility="gone" />

                <!-- Danh sách ca trống để đổi -->
                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/rv_available_shifts"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/spacing_s"
                    android:nestedScrollingEnabled="false"
                    android:overScrollMode="never"
                    tools:itemCount="2"
                    tools:listitem="@layout/item_shift_upcoming" />

                <!-- Empty State khi chưa chọn Ca của bạn hoặc không có ca trống -->
                <TextView
                    android:id="@+id/tv_empty_available_shifts"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/spacing_s"
                    android:background="?attr/colorSurfaceContainerLow"
                    android:padding="16dp"
                    android:text="Vui lòng chọn ca của bạn ở trên để xem các ca trống khả dụng."
                    android:textColor="?attr/colorOnSurfaceVariant"
                    android:textSize="13sp" />

                <!-- 3. LÝ DO ĐỔI CA -->
                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/spacing_l"
                    android:text="3. Lý do đổi ca"
                    android:textColor="?attr/colorOnSurface"
                    android:textSize="@dimen/text_size_title_small"
                    android:textStyle="bold" />

                <com.google.android.material.textfield.TextInputLayout
                    android:id="@+id/til_reason"
                    style="@style/AppTextInputLayout"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/spacing_s">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/et_reason"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="top"
                        android:hint="Nhập lý do của bạn..."
                        android:lines="4" />
                </com.google.android.material.textfield.TextInputLayout>

                <!-- NÚT GỬI YÊU CẦU -->
                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btn_submit_exchange"
                    style="@style/ButtonMaxWidthStyle"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/spacing_xl"
                    android:text="Gửi yêu cầu đổi ca"
                    app:cornerRadius="@dimen/radius_full" />

            </LinearLayout>
        </androidx.core.widget.NestedScrollView>
    </androidx.swiperefreshlayout.widget.SwipeRefreshLayout>

</androidx.constraintlayout.widget.ConstraintLayout>
