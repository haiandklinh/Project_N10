
<com.google.android.material.card.MaterialCardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/card_calendar_day"
    style="@style/CategoryCard"
    app:cardCornerRadius="@dimen/radius_s"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginTop="@dimen/spacing_xs"
    android:layout_marginHorizontal="@dimen/spacing_2xs">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:orientation="vertical"
        android:padding="@dimen/spacing_s">

        <!-- Ngày -->
        <TextView
            android:id="@+id/tv_day_number"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="?attr/colorPrimary"
            android:textSize="@dimen/text_size_label_large"
            android:textStyle="bold"
            tools:text="11" />

        <!-- Trạng thái chấm công -->
        <ImageView
            android:id="@+id/iv_day_status"
            android:layout_width="16dp"
            android:layout_height="16dp"
            android:layout_marginTop="@dimen/spacing_2xs"
            android:contentDescription="@null"
            android:scaleType="centerInside"
            app:tint="?attr/colorPrimary"
            tools:src="@drawable/ic_check" />

    </LinearLayout>

</com.google.android.material.card.MaterialCardView>
