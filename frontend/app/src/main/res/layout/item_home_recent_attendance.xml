<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/card_recent_record"
    style="@style/ItemCard"
    android:layout_marginBottom="@dimen/spacing_s"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingHorizontal="@dimen/spacing_m"
        android:paddingVertical="@dimen/spacing_s">

        <!-- Icon trạng thái: đúng giờ / trễ / vắng, đổi ảnh + tint theo dữ liệu thật -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/status_icon_container"
            android:layout_width="40dp"
            android:layout_height="40dp"
            app:cardCornerRadius="20dp"
            app:cardElevation="0dp"
            app:cardBackgroundColor="?attr/colorPrimaryContainer"
            app:strokeWidth="0dp"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintBottom_toBottomOf="parent">

            <ImageView
                android:id="@+id/iv_status_icon"
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:layout_gravity="center"
                android:src="@drawable/ic_check"
                app:tint="?attr/colorOnPrimaryContainer"
                tools:ignore="ContentDescription" />

        </com.google.android.material.card.MaterialCardView>

        <!-- Ngày -->
        <TextView
            android:id="@+id/tv_recent_day"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/spacing_m"
            android:layout_marginEnd="@dimen/spacing_s"
            android:ellipsize="end"
            android:maxLines="1"
            android:textColor="?attr/colorOnSurface"
            android:textSize="@dimen/text_size_body_medium"
            android:textStyle="bold"
            app:layout_constraintStart_toEndOf="@id/status_icon_container"
            app:layout_constraintEnd_toStartOf="@id/tag_status"
            app:layout_constraintTop_toTopOf="@id/status_icon_container"
            tools:text="Hôm nay" />

        <!-- Nhãn trạng thái: Đúng giờ / Đi trễ / Vắng -->
        <com.google.android.material.chip.Chip
            android:id="@+id/tag_status"
            style="@style/ChipStatusStyle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="@id/status_icon_container"
            app:layout_constraintBottom_toBottomOf="@id/status_icon_container"
            tools:text="Đúng giờ" />

        <!-- Khoảng thời gian vào - ra, kèm icon đồng hồ -->
        <ImageView
            android:id="@+id/iv_time_icon"
            android:layout_width="14dp"
            android:layout_height="14dp"
            android:layout_marginTop="@dimen/spacing_xs"
            android:src="@drawable/ic_history"
            app:tint="?attr/colorOnSurfaceVariant"
            app:layout_constraintStart_toStartOf="@id/tv_recent_day"
            app:layout_constraintTop_toBottomOf="@id/tv_recent_day"
            tools:ignore="ContentDescription" />

        <LinearLayout
            android:id="@+id/layout_time"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginStart="@dimen/spacing_xs"
            android:gravity="center_vertical"
            app:layout_constraintStart_toEndOf="@id/iv_time_icon"
            app:layout_constraintTop_toTopOf="@id/iv_time_icon"
            app:layout_constraintBottom_toBottomOf="@id/iv_time_icon">

            <TextView
                android:id="@+id/tv_recent_check_in"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="?attr/colorOnSurfaceVariant"
                android:textSize="@dimen/text_size_body_small"
                tools:text="08:01" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="6dp"
                android:text="-"
                android:textColor="?attr/colorOutline"
                android:textSize="@dimen/text_size_body_small" />

            <TextView
                android:id="@+id/tv_recent_check_out"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="?attr/colorOnSurfaceVariant"
                android:textSize="@dimen/text_size_body_small"
                tools:text="17:32" />

        </LinearLayout>

    </androidx.constraintlayout.widget.ConstraintLayout>

</com.google.android.material.card.MaterialCardView>