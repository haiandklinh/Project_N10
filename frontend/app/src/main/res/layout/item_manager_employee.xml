<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    style="@style/ItemCard"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="@dimen/spacing_s"
    android:foreground="?attr/selectableItemBackground">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="@dimen/spacing_s">

        <!-- Avatar -->
        <com.google.android.material.imageview.ShapeableImageView
            android:id="@+id/iv_avatar"
            android:layout_width="@dimen/avatar_size_m"
            android:layout_height="@dimen/avatar_size_m"
            android:contentDescription="@null"
            android:scaleType="centerCrop"
            android:src="@drawable/ic_avatar"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:shapeAppearanceOverlay="@style/ImageCircleStyle" />

        <!-- Tên nhân viên -->
        <TextView
            android:id="@+id/tv_name"
            style="@style/TitleTextSmallStyle"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/spacing_m"
            android:ellipsize="end"
            android:maxLines="1"
            app:layout_constraintBottom_toTopOf="@id/tv_employee_code"
            app:layout_constraintEnd_toStartOf="@id/chip_status"
            app:layout_constraintStart_toEndOf="@id/iv_avatar"
            app:layout_constraintTop_toTopOf="parent"
            tools:text="Phạm Thu Hà" />

        <!-- DÒNG 2: MÃ NHÂN VIÊN + PHÒNG BAN -->
        <TextView
            android:id="@+id/tv_employee_code"
            style="@style/BodyTextSmallStyle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:maxLines="1"
            app:layout_constraintBottom_toTopOf="@id/tv_position"
            app:layout_constraintStart_toStartOf="@id/tv_name"
            app:layout_constraintTop_toBottomOf="@id/tv_name"
            tools:text="NV0123456" />

        <TextView
            android:id="@+id/tv_divider"
            style="@style/BodyTextSmallStyle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text=" • "
            app:layout_constraintBottom_toBottomOf="@id/tv_employee_code"
            app:layout_constraintStart_toEndOf="@id/tv_employee_code"
            app:layout_constraintTop_toTopOf="@id/tv_employee_code" />

        <TextView
            android:id="@+id/tv_department"
            style="@style/BodyTextSmallStyle"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:maxLines="1"
            app:layout_constraintBottom_toBottomOf="@id/tv_employee_code"
            app:layout_constraintEnd_toStartOf="@id/chip_status"
            app:layout_constraintStart_toEndOf="@id/tv_divider"
            app:layout_constraintTop_toTopOf="@id/tv_employee_code"
            tools:text="Kế toán" />

        <!-- DÒNG 3: ICON + CHỨC VỤ -->
        <ImageView
            android:id="@+id/iv_position_icon"
            android:layout_width="@dimen/icon_size_xs"
            android:layout_height="@dimen/icon_size_xs"
            android:contentDescription="@null"
            android:src="@drawable/ic_profile"
            app:layout_constraintBottom_toBottomOf="@id/tv_position"
            app:layout_constraintStart_toStartOf="@id/tv_name"
            app:layout_constraintTop_toTopOf="@id/tv_position"
            app:tint="?attr/colorPrimary" />

        <TextView
            android:id="@+id/tv_position"
            style="@style/BodyTextSmallStyle"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/spacing_xs"
            android:textColor="?attr/colorPrimary"
            android:ellipsize="end"
            android:maxLines="1"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toStartOf="@id/chip_status"
            app:layout_constraintStart_toEndOf="@id/iv_position_icon"
            app:layout_constraintTop_toBottomOf="@id/tv_employee_code"
            tools:text="Thu ngân" />

        <!-- Chip trạng thái -->
        <com.google.android.material.chip.Chip
            android:id="@+id/chip_status"
            style="@style/ChipStatusSmallStyle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            tools:text="Đang làm" />

    </androidx.constraintlayout.widget.ConstraintLayout>
</com.google.android.material.card.MaterialCardView>