<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    style="@style/ItemCard"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="@dimen/spacing_s">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="@dimen/spacing_m">

        <com.google.android.material.imageview.ShapeableImageView
            android:id="@+id/iv_avatar"
            android:layout_width="@dimen/avatar_size_m"
            android:layout_height="@dimen/avatar_size_m"
            android:scaleType="centerCrop"
            android:src="@drawable/ic_avatar"
            android:contentDescription="@null"
            app:shapeAppearanceOverlay="@style/ImageCircleStyle"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <TextView
            android:id="@+id/tv_name"
            style="@style/TitleTextMediumStyle"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/spacing_m"
            android:ellipsize="end"
            android:maxLines="1"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toEndOf="@id/iv_avatar"
            app:layout_constraintTop_toTopOf="@id/iv_avatar"
            tools:text="Đỗ Minh Khoa" />

        <TextView
            android:id="@+id/tv_phone"
            style="@style/BodyTextSmallStyle"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/spacing_m"
            android:ellipsize="end"
            android:maxLines="1"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toEndOf="@id/iv_avatar"
            app:layout_constraintTop_toBottomOf="@id/tv_name"
            tools:text="SĐT: 0912 345 678" />

        <TextView
            android:id="@+id/tv_meta"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/spacing_m"
            android:layout_marginTop="1dp"
            android:textColor="?attr/colorOnSurfaceVariant"
            android:textSize="@dimen/text_size_body_small"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toEndOf="@id/iv_avatar"
            app:layout_constraintTop_toBottomOf="@id/tv_phone"
            tools:text="Mã mời: NV-8823 · 12 phút trước" />

        <View
            android:id="@+id/divider"
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_marginTop="@dimen/spacing_xl"
            android:alpha="0.4"
            android:background="?attr/colorOutlineVariant"
            app:layout_constraintTop_toBottomOf="@id/iv_avatar" />

        <LinearLayout
            android:id="@+id/layout_actions"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/spacing_m"
            android:orientation="horizontal"
            app:layout_constraintTop_toBottomOf="@id/divider">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_reject"
                style="@style/ButtonOutlinedSmallStyle"
                android:layout_width="0dp"
                android:layout_height="@dimen/button_height_s"
                android:layout_weight="1"
                android:layout_marginEnd="@dimen/spacing_3xl"
                android:text="Từ chối"
                app:strokeColor="?attr/colorAttendanceAbsent"
                android:textColor="?attr/colorAttendanceAbsent" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_approve"
                style="@style/ButtonFilledSmallStyle"
                android:layout_width="0dp"
                android:layout_height="@dimen/button_height_s"
                android:layout_weight="1"
                android:text="Chấp nhận" />

        </LinearLayout>

    </androidx.constraintlayout.widget.ConstraintLayout>
</com.google.android.material.card.MaterialCardView>
