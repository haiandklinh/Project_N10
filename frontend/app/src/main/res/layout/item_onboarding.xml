<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:gravity="center"
    android:orientation="vertical"
    android:paddingHorizontal="@dimen/spacing_l">

    <!-- Container chứa Icon/Ảnh bo tròn mềm mại + Hiệu ứng đổ bóng nhẹ -->


        <ImageView
            android:id="@+id/imageOnboarding"
            android:layout_width="230dp"
            android:layout_height="230dp"
            android:padding="@dimen/spacing_l"
            android:layout_gravity="center"
            android:contentDescription="@null"
            android:scaleType="fitCenter"
            tools:src="@drawable/ic_onboarding_mind" />


    <!-- Tiêu đề Slide (Nổi bật, dùng colorOnSurface) -->
    <TextView
        android:id="@+id/textTitle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:textColor="?attr/colorOnSurface"
        android:textSize="22sp"
        android:textStyle="bold"
        tools:text="Chấm công chỉ trong 1 chạm" />

    <!-- Nội dung mô tả (Màu nhạt hơn để tạo điểm nhấn cho tiêu đề) -->
    <TextView
        android:id="@+id/textDescription"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:layout_marginHorizontal="16dp"
        android:gravity="center"
        android:lineSpacingExtra="4dp"
        android:textColor="?attr/colorOnSurfaceVariant"
        android:textSize="15sp"
        tools:text="Check-in / check-out nhanh chóng bằng khuôn mặt hoặc định vị GPS chính xác." />

</LinearLayout>