<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:paddingVertical="14dp">

    <!-- Icon phía trước -->
    <ImageView
        android:id="@+id/iv_row_icon"
        android:layout_width="@dimen/icon_size_l"
        android:layout_height="@dimen/icon_size_l"
        android:src="@drawable/ic_money"
        app:tint="?attr/colorPrimary"
        android:gravity="center" />

    <!-- Tên mục -->
    <TextView
        android:id="@+id/tv_row_label"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="12dp"
        android:layout_weight="1"
        android:textColor="?attr/colorOnSurfaceVariant"
        android:textSize="15sp"
        tools:text="Lương cơ bản / tháng" />

    <!-- Giá trị tiền -->
    <TextView
        android:id="@+id/tv_row_value"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:textColor="?attr/colorOnSurface"
        android:textSize="15sp"
        android:textStyle="bold"
        tools:text="15.000.000 đ" />

</LinearLayout>