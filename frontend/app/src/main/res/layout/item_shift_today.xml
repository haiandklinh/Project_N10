<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/card_today_shift"
    style="@style/CategoryCard"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="@dimen/spacing_s"
    android:foreground="?attr/selectableItemBackground"
    app:cardBackgroundColor="?attr/colorSurfaceVariant">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginEnd="@dimen/spacing_m">

        <!-- Dải màu nhấn bên trái (được bo theo góc của card) -->
        <View
            android:id="@+id/view_accent"
            android:layout_width="6dp"
            android:layout_height="0dp"
            android:background="?attr/colorPrimary"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <!-- 1. TÊN CA + KHUNG GIỜ -->
        <TextView
            android:id="@+id/tv_shift_name"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/spacing_m"
            android:layout_marginTop="@dimen/spacing_m"
            android:layout_marginEnd="@dimen/spacing_s"
            android:ellipsize="end"
            android:maxLines="1"
            android:textColor="?attr/colorOnSurface"
            android:textSize="@dimen/text_size_body_medium"
            android:textStyle="bold"
            app:layout_constraintEnd_toStartOf="@id/tag_shift_employee_count"
            app:layout_constraintStart_toEndOf="@id/view_accent"
            app:layout_constraintTop_toTopOf="parent"
            tools:text="Ca sáng · 08:00 - 17:00" />

        <!-- 2. ĐỊA ĐIỂM -->
        <ImageView
            android:id="@+id/iv_shift_location"
            android:layout_width="14dp"
            android:layout_height="14dp"
            android:layout_marginStart="@dimen/spacing_m"
            android:contentDescription="@null"
            android:src="@drawable/ic_location"
            app:layout_constraintBottom_toBottomOf="@id/tv_shift_location"
            app:layout_constraintStart_toEndOf="@id/view_accent"
            app:layout_constraintTop_toTopOf="@id/tv_shift_location" />

        <TextView
            android:id="@+id/tv_shift_location"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="7dp"
            android:layout_marginTop="3dp"
            android:layout_marginEnd="@dimen/spacing_s"
            android:layout_marginBottom="@dimen/spacing_m"
            android:ellipsize="end"
            android:maxLines="1"
            android:textColor="?attr/colorOnSurfaceVariant"
            android:textSize="@dimen/text_size_label_small"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toStartOf="@id/tag_shift_employee_count"
            app:layout_constraintStart_toEndOf="@id/iv_shift_location"
            app:layout_constraintTop_toBottomOf="@id/tv_shift_name"
            tools:text="Văn phòng chính" />

        <!-- CHIP SỐ NHÂN VIÊN LÀM CA NÀY -->
        <com.google.android.material.chip.Chip
            android:id="@+id/tag_shift_employee_count"
            style="@style/ChipStatusStyle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="0 NV"
            android:textColor="?attr/colorPrimary"
            app:chipBackgroundColor="?attr/colorPrimaryContainer"
            app:ensureMinTouchTargetSize="false"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            tools:text="5 NV" />

    </androidx.constraintlayout.widget.ConstraintLayout>

</com.google.android.material.card.MaterialCardView>