<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/card_upcoming_shift"
    style="@style/ItemCard"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="@dimen/spacing_s"
    android:checkable="true"
    android:clickable="true"
    android:focusable="true"
    android:foreground="?attr/selectableItemBackground">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <!-- Dải màu nhấn bên trái (được bo theo góc của card) -->
        <View
            android:id="@+id/view_accent"
            android:layout_width="10dp"
            android:layout_height="0dp"
            android:background="?attr/colorPrimary"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <!-- 1. TÊN CA -->
        <TextView
            android:id="@+id/tv_shift_name"
            style="@style/BodyTextMediumStyle"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/spacing_m"
            android:layout_marginTop="@dimen/spacing_m"
            android:layout_marginEnd="@dimen/spacing_s"
            android:ellipsize="end"
            android:maxLines="1"
            android:textStyle="bold"
            app:layout_constraintEnd_toStartOf="@id/card_shift_time"
            app:layout_constraintStart_toEndOf="@id/view_accent"
            app:layout_constraintTop_toTopOf="parent"
            tools:text="Ca Sáng" />

        <!-- 2. THỜI GIAN (dạng pill) -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/card_shift_time"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginEnd="@dimen/spacing_m"
            app:cardBackgroundColor="?attr/colorPrimaryContainer"
            app:cardCornerRadius="12dp"
            app:cardElevation="0dp"
            app:layout_constraintBottom_toBottomOf="@id/tv_shift_name"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="@id/tv_shift_name"
            app:strokeWidth="0dp">

            <TextView
                android:id="@+id/tv_shift_time"
                style="@style/BodyTextSmallStyle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:paddingStart="10dp"
                android:paddingTop="4dp"
                android:paddingEnd="10dp"
                android:paddingBottom="4dp"
                android:textColor="?attr/colorPrimary"
                android:textStyle="bold"
                tools:text="08:00 - 17:30" />

        </com.google.android.material.card.MaterialCardView>

        <!-- 3. NGÀY THÁNG -->
        <ImageView
            android:id="@+id/iv_shift_date"
            android:layout_width="14dp"
            android:layout_height="14dp"
            android:layout_marginStart="@dimen/spacing_m"
            android:contentDescription="@null"
            android:src="@drawable/ic_schedule"
            app:layout_constraintBottom_toBottomOf="@id/tv_shift_date"
            app:layout_constraintStart_toEndOf="@id/view_accent"
            app:layout_constraintTop_toTopOf="@id/tv_shift_date"
            app:tint="?attr/colorPrimary" />

        <TextView
            android:id="@+id/tv_shift_date"
            style="@style/BodyTextSmallStyle"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="4dp"
            android:layout_marginTop="2dp"
            android:layout_marginEnd="@dimen/spacing_m"
            android:ellipsize="end"
            android:maxLines="1"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toEndOf="@id/iv_shift_date"
            app:layout_constraintTop_toBottomOf="@id/tv_shift_name"
            tools:text="Thứ 4, 02/09" />

        <!-- 4. ĐỊA ĐIỂM (icon nhỏ + chữ) -->
        <ImageView
            android:id="@+id/iv_shift_location"
            android:layout_width="14dp"
            android:layout_height="14dp"
            android:layout_marginStart="@dimen/spacing_m"
            android:contentDescription="@null"
            android:src="@drawable/ic_location"
            app:layout_constraintBottom_toBottomOf="@id/tv_shift_location"
            app:layout_constraintStart_toEndOf="@id/view_accent"
            app:layout_constraintTop_toTopOf="@id/tv_shift_location"
            app:tint="?attr/colorPrimary" />

        <TextView
            android:id="@+id/tv_shift_location"
            style="@style/BodyTextSmallStyle"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="4dp"
            android:layout_marginTop="2dp"
            android:layout_marginEnd="@dimen/spacing_m"
            android:layout_marginBottom="@dimen/spacing_m"
            android:ellipsize="end"
            android:maxLines="1"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toEndOf="@id/iv_shift_location"
            app:layout_constraintTop_toBottomOf="@id/tv_shift_date"
            tools:text="Văn phòng chính · Tầng 3" />

    </androidx.constraintlayout.widget.ConstraintLayout>

</com.google.android.material.card.MaterialCardView>