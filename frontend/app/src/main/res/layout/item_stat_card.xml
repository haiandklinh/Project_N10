<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/card_root"
    style="@style/ItemCard"
    android:layout_margin="@dimen/spacing_2xs"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="@dimen/spacing_m">

        <!-- Icon chỉ số -->
        <ImageView
            android:id="@+id/iv_stat_icon"
            android:layout_width="@dimen/icon_size_m"
            android:layout_height="@dimen/icon_size_m"
            android:contentDescription="@null"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            tools:src="@drawable/ic_check" />

        <!-- Giá trị số chính (Ví dụ: 9) -->
        <TextView
            android:id="@+id/tv_stat_value"
            style="@style/TitleTextLargeStyle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/spacing_s"
            android:includeFontPadding="false"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/iv_stat_icon"
            tools:text="9"
            tools:textColor="?attr/colorAttendancePresent" />

        <!-- Đơn vị (Ví dụ: ngày) - Căn chuẩn theo đường chân chữ của tv_stat_value -->
        <TextView
            android:id="@+id/tv_stat_unit"
            style="@style/BodyTextSmallStyle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/spacing_3xs"
            android:includeFontPadding="false"
            android:textStyle="bold"
            app:layout_constraintBaseline_toBaselineOf="@id/tv_stat_value"
            app:layout_constraintStart_toEndOf="@id/tv_stat_value"
            tools:text="ngày"
            tools:textColor="?attr/colorAttendancePresent" />

        <!-- Tên nhãn (Ví dụ: Ngày đúng giờ) -->
        <TextView
            android:id="@+id/tv_stat_label"
            style="@style/BodyTextSmallStyle"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/spacing_3xs"
            android:ellipsize="end"
            android:maxLines="1"
            android:textColor="?attr/colorOnSurfaceVariant"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/tv_stat_value"
            tools:text="Ngày đúng giờ" />

    </androidx.constraintlayout.widget.ConstraintLayout>

</com.google.android.material.card.MaterialCardView>