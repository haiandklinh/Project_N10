<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/card_no_shift"
    style="@style/ItemCard"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginTop="@dimen/spacing_s"
    app:strokeColor="?attr/colorPrimaryContainer"
    app:strokeWidth="@dimen/border_width_s"
    app:layout_constraintTop_toBottomOf="@id/tv_today_shift_label">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="@dimen/spacing_m">

        <!-- 1. ICON NẰM BÊN TRÁI -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/card_no_shift_icon_bg"
            android:layout_width="@dimen/icon_container_m"
            android:layout_height="@dimen/icon_container_m"
            app:cardBackgroundColor="?attr/colorPrimaryContainer"
            app:cardCornerRadius="@dimen/radius_m"
            app:cardElevation="0dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:strokeWidth="0dp">

            <ImageView
                android:id="@+id/iv_no_shift_icon"
                android:layout_width="@dimen/icon_size_m"
                android:layout_height="@dimen/icon_size_m"
                android:layout_gravity="center"
                android:contentDescription="@null"
                android:src="@drawable/ic_schedule"
                app:tint="?attr/colorPrimary" />
        </com.google.android.material.card.MaterialCardView>

        <!-- 2. ICON CHEVRON RIGHT BÊN PHẢI -->
        <ImageView
            android:id="@+id/iv_chevron_right"
            android:layout_width="@dimen/icon_size_s"
            android:layout_height="@dimen/icon_size_s"
            android:contentDescription="@null"
            android:src="@drawable/ic_chevron_right"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:tint="?attr/colorOnSurfaceVariant" />

        <!-- 3. TIÊU ĐỀ NẰM GIỮA ICON TRÁI VÀ CHEVRON PHẢI -->
        <TextView
            android:id="@+id/tv_no_shift_title"
            style="@style/TitleTextSmallStyle"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/spacing_m"
            android:layout_marginEnd="@dimen/spacing_s"
            android:text="Hôm nay bạn không có ca làm"
            app:layout_constraintBottom_toTopOf="@id/tv_no_shift_subtitle"
            app:layout_constraintEnd_toStartOf="@id/iv_chevron_right"
            app:layout_constraintStart_toEndOf="@id/card_no_shift_icon_bg"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintVertical_chainStyle="packed" />

        <!-- 4. MÔ TẢ NẰM GIỮA ICON TRÁI VÀ CHEVRON PHẢI -->
        <TextView
            android:id="@+id/tv_no_shift_subtitle"
            style="@style/BodyTextSmallStyle"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/spacing_m"
            android:layout_marginEnd="@dimen/spacing_s"
            android:layout_marginTop="@dimen/spacing_3xs"
            android:text="Tận hưởng thời gian nghỉ ngơi!"
            android:textColor="?attr/colorOnSurfaceVariant"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toStartOf="@id/iv_chevron_right"
            app:layout_constraintStart_toEndOf="@id/card_no_shift_icon_bg"
            app:layout_constraintTop_toBottomOf="@id/tv_no_shift_title" />

    </androidx.constraintlayout.widget.ConstraintLayout>

</com.google.android.material.card.MaterialCardView>