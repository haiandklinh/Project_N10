<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/layoutError"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:gravity="center"
    android:orientation="vertical"
    android:padding="@dimen/spacing_3xl">

    <ImageView
        android:id="@+id/imgError"
        android:layout_width="120dp"
        android:layout_height="120dp"
        android:src="@drawable/ic_error" />

    <TextView
        android:id="@+id/tvErrorTitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/spacing_l"
        android:text="Có lỗi xảy ra!"
        android:textSize="@dimen/text_size_title_medium"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/tvErrorMessage"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/spacing_2xs"
        android:text="Không thể tải dữ liệu, vui lòng kiểm tra kết nối mạng."
        android:textAlignment="center"
        android:textColor="?attr/colorOnSurfaceVariant"
        android:textSize="@dimen/text_size_body_medium" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnRetry"
        style="@style/ButtonOutlinedSmallStyle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/spacing_l"
        android:text="@string/action_retry" />
</LinearLayout>