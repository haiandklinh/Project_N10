<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/cardStep2VerifyOtp"
    style="@style/MainCard"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    app:cardCornerRadius="@dimen/radius_xl"
    app:cardElevation="@dimen/elevation_none"
    app:strokeColor="?attr/colorSecondary"
    app:strokeWidth="1dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="@dimen/spacing_xl">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/forgot_password_step_2_title"
            android:textColor="?attr/colorPrimary"
            android:textSize="@dimen/text_size_title_medium"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tvOtpDescription"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/spacing_2xs"
            android:textColor="?attr/colorOnSurfaceVariant"
            android:textSize="@dimen/text_size_body_small"
            android:text="@string/forgot_password_step_2_desc" />

        <!-- HÀNG 6 Ô NHẬP OTP -->
        <LinearLayout
            android:id="@+id/layoutOtpInputs"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/spacing_xl"
            android:gravity="center"
            android:orientation="horizontal">

            <EditText
                android:id="@+id/edtOtp1"
                style="@style/OtpBoxStyle" />

            <View
                android:layout_width="@dimen/spacing_s"
                android:layout_height="0dp" />

            <EditText
                android:id="@+id/edtOtp2"
                style="@style/OtpBoxStyle" />

            <View
                android:layout_width="@dimen/spacing_s"
                android:layout_height="0dp" />

            <EditText
                android:id="@+id/edtOtp3"
                style="@style/OtpBoxStyle" />

            <View
                android:layout_width="@dimen/spacing_s"
                android:layout_height="0dp" />

            <EditText
                android:id="@+id/edtOtp4"
                style="@style/OtpBoxStyle" />

            <View
                android:layout_width="@dimen/spacing_s"
                android:layout_height="0dp" />

            <EditText
                android:id="@+id/edtOtp5"
                style="@style/OtpBoxStyle" />

            <View
                android:layout_width="@dimen/spacing_s"
                android:layout_height="0dp" />

            <EditText
                android:id="@+id/edtOtp6"
                style="@style/OtpBoxStyle" />

        </LinearLayout>

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnVerifyOtp"
            style="@style/ButtonMaxWidthStyle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/spacing_xl"
            android:text="@string/forgot_password_verify_otp"
            app:cornerRadius="@dimen/radius_full" />

        <!-- Gửi lại mã OTP -->
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal"
            android:layout_marginTop="@dimen/spacing_m"
            android:gravity="center"
            android:orientation="horizontal">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/forgot_password_no_otp"
                android:textColor="?attr/colorOnSurfaceVariant"
                android:textSize="@dimen/text_size_body_medium" />

            <TextView
                android:id="@+id/tvResendOtp"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="?attr/selectableItemBackground"
                android:padding="@dimen/spacing_2xs"
                android:text="@string/forgot_password_resend_otp"
                android:textColor="?attr/colorPrimary"
                android:textSize="@dimen/text_size_body_medium"
                android:textStyle="bold" />
        </LinearLayout>

    </LinearLayout>
</com.google.android.material.card.MaterialCardView>