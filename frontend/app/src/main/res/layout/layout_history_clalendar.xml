<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/card_calendar"
    style="@style/MainCard"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginHorizontal="@dimen/spacing_s"
    app:cardCornerRadius="@dimen/radius_l">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingBottom="@dimen/spacing_m">

        <!-- Header Thứ trong tuần -->
        <GridLayout
            android:id="@+id/calendar_week_header"
            android:layout_width="0dp"
            android:layout_height="36dp"
            android:layout_marginHorizontal="@dimen/spacing_3xs"
            android:alignmentMode="alignMargins"
            android:background="?attr/colorSurface"
            android:columnCount="7"
            android:rowCount="1"
            android:useDefaultMargins="false"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent">

            <TextView
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_columnWeight="1"
                android:gravity="center"
                android:text="@string/schedule_day_mon"
                android:textColor="?attr/colorOnSurfaceVariant"
                android:textSize="@dimen/text_size_label_medium"
                android:textStyle="bold" />

            <TextView
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_columnWeight="1"
                android:gravity="center"
                android:text="@string/schedule_day_tue"
                android:textColor="?attr/colorOnSurfaceVariant"
                android:textSize="@dimen/text_size_label_medium"
                android:textStyle="bold" />

            <TextView
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_columnWeight="1"
                android:gravity="center"
                android:text="@string/schedule_day_wed"
                android:textColor="?attr/colorOnSurfaceVariant"
                android:textSize="@dimen/text_size_label_medium"
                android:textStyle="bold" />

            <TextView
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_columnWeight="1"
                android:gravity="center"
                android:text="@string/schedule_day_thu"
                android:textColor="?attr/colorOnSurfaceVariant"
                android:textSize="@dimen/text_size_label_medium"
                android:textStyle="bold" />

            <TextView
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_columnWeight="1"
                android:gravity="center"
                android:text="@string/schedule_day_fri"
                android:textColor="?attr/colorOnSurfaceVariant"
                android:textSize="@dimen/text_size_label_medium"
                android:textStyle="bold" />

            <TextView
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_columnWeight="1"
                android:gravity="center"
                android:text="@string/schedule_day_sat"
                android:textColor="?attr/colorOnSurfaceVariant"
                android:textSize="@dimen/text_size_label_medium"
                android:textStyle="bold" />

            <TextView
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_columnWeight="1"
                android:gravity="center"
                android:text="@string/schedule_day_sun"
                android:textColor="?attr/colorError"
                android:textSize="@dimen/text_size_label_medium"
                android:textStyle="bold" />
        </GridLayout>

        <!-- Lưới Ngày Trong Tháng -->
        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/rv_calendar_grid"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_margin="@dimen/spacing_3xs"
            android:clipToPadding="false"
            android:nestedScrollingEnabled="false"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/calendar_week_header"
            tools:itemCount="31"
            tools:layoutManager="androidx.recyclerview.widget.GridLayoutManager"
            tools:listitem="@layout/item_history_calendar_day"
            tools:spanCount="7" />

        <!-- Chú thích trạng thái (Legend 3 cột x 2 hàng) -->
        <GridLayout
            android:id="@+id/layout_calendar_legend"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="@dimen/spacing_s"
            android:layout_marginTop="@dimen/spacing_s"
            android:alignmentMode="alignMargins"
            android:columnCount="3"
            android:rowCount="2"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/rv_calendar_grid">

            <!-- HÀNG 1 -->
            <!-- 1. Đúng giờ -->
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_columnWeight="1"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingVertical="4dp">

                <ImageView
                    android:layout_width="@dimen/icon_size_s"
                    android:layout_height="@dimen/icon_size_s"
                    android:contentDescription="@null"
                    android:src="@drawable/ic_check"
                    app:tint="?attr/colorAttendancePresent" />

                <TextView
                    style="@style/BodyTextSmallStyle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="4dp"
                    android:text="@string/history_status_on_time"
                    android:textColor="?attr/colorOnSurfaceVariant" />
            </LinearLayout>

            <!-- 2. Đi muộn -->
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_columnWeight="1"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingVertical="4dp">

                <ImageView
                    android:layout_width="@dimen/icon_size_s"
                    android:layout_height="@dimen/icon_size_s"
                    android:contentDescription="@null"
                    android:src="@drawable/ic_warning"
                    app:tint="?attr/colorAttendanceLate" />

                <TextView
                    style="@style/BodyTextSmallStyle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="4dp"
                    android:text="@string/history_status_late"
                    android:textColor="?attr/colorOnSurfaceVariant" />
            </LinearLayout>

            <!-- 3. Vắng mặt -->
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_columnWeight="1"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingVertical="4dp">

                <ImageView
                    android:layout_width="@dimen/icon_size_s"
                    android:layout_height="@dimen/icon_size_s"
                    android:contentDescription="@null"
                    android:src="@drawable/ic_close"
                    app:tint="?attr/colorAttendanceAbsent" />

                <TextView
                    style="@style/BodyTextSmallStyle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="4dp"
                    android:text="@string/history_status_absent"
                    android:textColor="?attr/colorOnSurfaceVariant" />
            </LinearLayout>

            <!-- HÀNG 2 -->
            <!-- 4. Về sớm -->
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_columnWeight="1"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingVertical="4dp">

                <ImageView
                    android:layout_width="@dimen/icon_size_s"
                    android:layout_height="@dimen/icon_size_s"
                    android:contentDescription="@null"
                    android:src="@drawable/ic_check"
                    app:tint="?attr/colorAttendanceEarlyLeave" />

                <TextView
                    style="@style/BodyTextSmallStyle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="4dp"
                    android:text="@string/history_status_early_leave"
                    android:textColor="?attr/colorOnSurfaceVariant" />
            </LinearLayout>

            <!-- 5. Nghỉ phép -->
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_columnWeight="1"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingVertical="4dp">

                <ImageView
                    android:layout_width="@dimen/icon_size_s"
                    android:layout_height="@dimen/icon_size_s"
                    android:contentDescription="@null"
                    android:src="@drawable/ic_check"
                    app:tint="?attr/colorAttendanceLeave" />

                <TextView
                    style="@style/BodyTextSmallStyle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="4dp"
                    android:text="@string/history_status_leave"
                    android:textColor="?attr/colorOnSurfaceVariant" />
            </LinearLayout>

            <!-- 6. Chưa chấm -->
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_columnWeight="1"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingVertical="4dp">

                <ImageView
                    android:layout_width="@dimen/icon_size_s"
                    android:layout_height="@dimen/icon_size_s"
                    android:contentDescription="@null"
                    android:src="@drawable/ic_remove"
                    app:tint="?attr/colorAttendanceNotChecked" />

                <TextView
                    style="@style/BodyTextSmallStyle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="4dp"
                    android:text="@string/history_status_not_checked"
                    android:textColor="?attr/colorOnSurfaceVariant" />
            </LinearLayout>

        </GridLayout>

    </androidx.constraintlayout.widget.ConstraintLayout>

</com.google.android.material.card.MaterialCardView>