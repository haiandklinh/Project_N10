<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">

    <!-- ==================== TÁC VỤ NHANH ==================== -->
    <TextView
        android:id="@+id/tv_categories_label"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Tác vụ nhanh"
        android:textSize="@dimen/text_size_title_medium"
        android:textStyle="bold"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rv_categories"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:clipToPadding="false"
        android:layout_marginTop="@dimen/spacing_s"
        app:layout_constraintTop_toBottomOf="@id/tv_categories_label"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        tools:itemCount="10"
        tools:listitem="@layout/item_home_category"
        tools:layoutManager="androidx.recyclerview.widget.GridLayoutManager"
        tools:spanCount="1"
        tools:orientation="horizontal" />

    <!-- Thanh chỉ báo cuộn ngang cho rv_categories: track nền mờ + thumb di chuyển theo % cuộn -->
    <FrameLayout
        android:id="@+id/scroll_indicator_track"
        android:layout_width="40dp"
        android:layout_height="4dp"
        android:layout_marginTop="@dimen/spacing_s"
        android:background="@drawable/bg_scroll_track"
        app:layout_constraintTop_toBottomOf="@id/rv_categories"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <View
            android:id="@+id/scroll_indicator_thumb"
            android:layout_width="20dp"
            android:layout_height="4dp"
            android:layout_gravity="start"
            android:background="@drawable/bg_scroll_thumb" />

    </FrameLayout>

</androidx.constraintlayout.widget.ConstraintLayout>
