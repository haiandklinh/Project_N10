<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/header"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">

    <!-- Avatar -->
    <com.google.android.material.imageview.ShapeableImageView
        android:id="@+id/iv_avatar"
        android:layout_width="@dimen/avatar_size_l"
        android:layout_height="@dimen/avatar_size_l"
        android:contentDescription="Ảnh đại diện"
        android:padding="1dp"
        android:scaleType="centerCrop"
        android:src="@drawable/ic_avatar"
        app:shapeAppearanceOverlay="@style/ImageCircleStyle"
        app:strokeColor="?attr/colorPrimary"
        app:strokeWidth="1dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent" />

    <!-- Thông tin chào mừng -->
    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/spacing_m"
        android:orientation="vertical"
        app:layout_constraintStart_toEndOf="@id/iv_avatar"
        app:layout_constraintEnd_toStartOf="@id/btn_notification"
        app:layout_constraintTop_toTopOf="@id/iv_avatar"
        app:layout_constraintBottom_toBottomOf="@id/iv_avatar">


        <TextView
            android:id="@+id/tv_greeting"
            style="@style/TitleTextMediumStyle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/spacing_3xs"
            android:text="Nguyễn Viet Son"/>


        <TextView
            android:id="@+id/tv_company_name"
            style="@style/BodyTextSmallStyle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="1dp"
            android:text="Công ty TNHH ABC" />

    </LinearLayout>

    <!-- Nút thông báo -->
    <com.google.android.material.card.MaterialCardView
        android:id="@+id/btn_notification"
        style="@style/CircleIconCard"
        android:layout_width="@dimen/icon_container_m"
        android:layout_height="@dimen/icon_container_m"
        android:layout_marginEnd="@dimen/spacing_2xs"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent">

        <ImageView
            android:layout_width="@dimen/icon_size_m"
            android:layout_height="@dimen/icon_size_m"
            android:layout_gravity="center"
            android:contentDescription="Thông báo"
            android:src="@drawable/ic_notifications"
            app:tint="?attr/colorOnSurface" />

    </com.google.android.material.card.MaterialCardView>

    <!-- Chấm đỏ thông báo chưa đọc: mặc định ẩn, code sẽ bật khi có thông báo mới -->
    <com.google.android.material.card.MaterialCardView
        android:id="@+id/notification_badge"
        android:layout_width="@dimen/icon_size_xs"
        android:layout_height="@dimen/icon_size_xs"
        android:visibility="gone"
        app:cardBackgroundColor="?attr/colorAttendanceAbsent"
        app:cardCornerRadius="@dimen/radius_full"
        app:cardElevation="0dp"
        app:strokeWidth="0dp"
        app:layout_constraintTop_toTopOf="@id/btn_notification"
        app:layout_constraintEnd_toEndOf="@id/btn_notification"
        android:translationX="-1dp"
        android:translationY="1dp"
        tools:visibility="visible" />

</androidx.constraintlayout.widget.ConstraintLayout>
