<!-- ==================== CHẤM CÔNG HÔM NAY ==================== -->
<com.google.android.material.card.MaterialCardView android:id="@+id/card_today"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    style="@style/MainCard"
    android:foreground="?attr/selectableItemBackground"
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/bg_card_gradient">

        <!-- Vòng tròn trang trí mờ -->
        <View
            android:layout_width="140dp"
            android:layout_height="140dp"
            android:layout_marginTop="-60dp"
            android:layout_marginEnd="-40dp"
            android:alpha="0.08"
            android:background="@drawable/bg_decor_circle"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintEnd_toEndOf="parent" />

        <View
            android:layout_width="90dp"
            android:layout_height="90dp"
            android:layout_marginStart="-30dp"
            android:layout_marginBottom="-30dp"
            android:alpha="0.06"
            android:background="@drawable/bg_decor_circle"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent" />

        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:padding="@dimen/spacing_m"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintBottom_toBottomOf="parent">

            <!-- Nhãn tiêu đề -->
            <TextView
                android:id="@+id/tv_today_label"
                style="@style/TitleTextMediumStyle"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:text="Chấm công hôm nay"
                android:textColor="?attr/colorOnPrimary"
                app:layout_constraintEnd_toStartOf="@id/tv_worked_hours"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent" />

            <!-- CHIP HIỂN THỊ THỜI GIAN LÀM VIỆC (Ở GÓC TRÊN BÊN PHẢI) -->
            <TextView
                android:id="@+id/tv_worked_hours"
                style="@style/TitleTextSmallStyle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_time_chip"
                android:paddingHorizontal="@dimen/spacing_s"
                 android:paddingVertical="@dimen/spacing_3xs"
                android:text="0giờ 00phút"
                android:textColor="?attr/colorOnPrimary"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toTopOf="@+id/tv_today_label"
                app:layout_constraintBottom_toBottomOf="@+id/tv_today_label"
                />

            <!-- Icon đồng hồ -->
            <ImageView
                android:id="@+id/iv_clock_icon"
                android:layout_width="@dimen/icon_size_l"
                android:layout_height="@dimen/icon_size_l"
                android:layout_marginTop="@dimen/spacing_l"
                android:alpha="0.5"
                android:contentDescription="@null"
                android:src="@drawable/ic_history"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@id/tv_today_label"
                app:tint="?attr/colorOnPrimary" />

            <!-- Giờ hiện tại -->
            <TextView
                android:id="@+id/tv_clock"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/spacing_2xs"
                android:text="08:42"
                android:textColor="?attr/colorOnPrimary"
                android:textSize="42sp"
                android:textStyle="bold"
                app:layout_constraintBottom_toBottomOf="@id/iv_clock_icon"
                app:layout_constraintStart_toEndOf="@id/iv_clock_icon"
                app:layout_constraintTop_toTopOf="@id/iv_clock_icon" />

            <!-- Giờ vào -->
            <LinearLayout
                android:id="@+id/layout_check_in"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/spacing_xs"
                android:background="@drawable/bg_time_chip"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:padding="@dimen/spacing_m"
                app:layout_constraintEnd_toStartOf="@id/layout_check_out"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@id/tv_clock">

                <FrameLayout
                    android:layout_width="@dimen/icon_container_m"
                    android:layout_height="@dimen/icon_container_m"
                    android:background="@drawable/bg_time_icon_circle">

                    <ImageView
                        android:layout_width="@dimen/icon_size_m"
                        android:layout_height="@dimen/icon_size_m"
                        android:layout_gravity="center"
                        android:contentDescription="@null"
                        android:src="@drawable/ic_check"
                        app:tint="?attr/colorOnPrimary" />

                </FrameLayout>

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/spacing_s"
                    android:orientation="vertical">

                    <TextView
                        style="@style/BodyTextSmallStyle"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textColor="?attr/colorOnPrimary"
                        android:text="Giờ vào" />

                    <TextView
                        android:id="@+id/tv_check_in_time"
                        style="@style/TitleTextMediumStyle"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="--:--"
                        android:textColor="?attr/colorOnPrimary" />

                </LinearLayout>

            </LinearLayout>

            <!-- Giờ ra -->
            <LinearLayout
                android:id="@+id/layout_check_out"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/spacing_s"
                android:layout_marginTop="@dimen/spacing_xs"
                android:background="@drawable/bg_time_chip"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:padding="@dimen/spacing_m"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toEndOf="@id/layout_check_in"
                app:layout_constraintTop_toBottomOf="@id/tv_clock">

                <FrameLayout
                    android:layout_width="@dimen/icon_container_m"
                    android:layout_height="@dimen/icon_container_m"
                    android:background="@drawable/bg_time_icon_circle">

                    <ImageView
                        android:layout_width="@dimen/icon_size_m"
                        android:layout_height="@dimen/icon_size_m"
                        android:layout_gravity="center"
                        android:contentDescription="@null"
                        android:src="@drawable/ic_close"
                        app:tint="?attr/colorOnPrimary" />

                </FrameLayout>

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/spacing_s"
                    android:orientation="vertical">

                    <TextView
                        style="@style/BodyTextSmallStyle"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Giờ ra"
                        android:textColor="?attr/colorOnPrimary"/>

                    <TextView
                        android:id="@+id/tv_check_out_time"
                        style="@style/TitleTextMediumStyle"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="--:--"
                        android:textColor="?attr/colorOnPrimary" />

                </LinearLayout>

            </LinearLayout>

            <!-- CTA "Chấm công ngay" -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_check_in_cta"
                style="@style/ButtonMaxWidthStyle"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/spacing_s"
                android:text="Chấm công ngay"
                android:textColor="?attr/colorPrimary"
                android:contentDescription="Chấm công ngay"
                app:icon="@drawable/ic_check_circle"
                app:iconTint="?attr/colorPrimary"
                app:iconGravity="textStart"
                app:iconPadding="@dimen/spacing_2xs"
                app:cornerRadius="@dimen/radius_full"
                app:backgroundTint="?attr/colorPrimaryContainer"
                app:rippleColor="?attr/colorPrimary"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toBottomOf="@id/layout_check_in"
                tools:visibility="visible" />

        </androidx.constraintlayout.widget.ConstraintLayout>

    </androidx.constraintlayout.widget.ConstraintLayout>

</com.google.android.material.card.MaterialCardView>