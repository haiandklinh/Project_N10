<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/layout_today_shift"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">

    <!-- TIÊU ĐỀ SECTION HOÀN TÁC ĐỔI CA -->
    <TextView
        android:id="@+id/tv_today_shift_label"
        style="@style/TitleTextMediumStyle"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:text="Ca làm hôm nay"
        app:layout_constraintEnd_toStartOf="@+id/tv_exchange_shift"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <TextView
        android:id="@+id/tv_exchange_shift"
        style="@style/TitleTextSmallStyle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:background="?attr/selectableItemBackground"
        android:clickable="true"
        android:focusable="true"
        android:padding="@dimen/spacing_s"
        android:text="Đổi ca"
        android:textColor="?attr/colorPrimary"
        app:layout_constraintBottom_toBottomOf="@+id/tv_today_shift_label"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="@+id/tv_today_shift_label" />

    <!-- CARD CA LÀM HÔM NAY (ĐÃ CHUẨN HÓA THEO STYLE MỚI) -->
    <FrameLayout
        android:id="@+id/frame_today_shift"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:layout_constraintTop_toBottomOf="@id/tv_today_shift_label">

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/rv_today_shifts"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:clipToPadding="false"
            android:paddingVertical="@dimen/spacing_s"
            tools:itemCount="1"
            tools:listitem="@layout/item_shift_today"/>

        <include
            android:id="@+id/include_card_no_shift"
            layout="@layout/layout_empty_shift"
            android:visibility="gone"/>

    </FrameLayout>

</androidx.constraintlayout.widget.ConstraintLayout>