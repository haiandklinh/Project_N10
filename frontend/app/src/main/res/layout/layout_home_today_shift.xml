<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/layout_today_shift"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">

    <TextView
        android:id="@+id/tv_today_shift_label"
        style="@style/TitleTextMediumStyle"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:text="Ca làm hôm nay"
        app:layout_constraintEnd_toStartOf="@+id/tv_exchange_shift"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <TextView
        android:id="@+id/tv_exchange_shift"
        style="@style/TitleTextSmallStyle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:background="?attr/selectableItemBackground"
        android:clickable="true"
        android:focusable="true"
        android:padding="@dimen/spacing_s"
        android:text="Đổi ca"
        android:textColor="?attr/colorPrimary"
        app:layout_constraintBottom_toBottomOf="@+id/tv_today_shift_label"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="@+id/tv_today_shift_label" />

    <com.google.android.material.card.MaterialCardView
        android:id="@+id/card_today_shift"
        style="@style/ItemCard"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/spacing_s"
        android:foreground="?attr/selectableItemBackground"
        app:cardBackgroundColor="?attr/colorSurface"
        app:layout_constraintTop_toBottomOf="@id/tv_today_shift_label">

        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingEnd="@dimen/spacing_m">

            <!-- Dải màu nhấn bên trái (được bo theo góc của card) -->
            <View
                android:id="@+id/view_accent"
                android:layout_width="@dimen/spacing_s"
                android:layout_height="0dp"
                android:background="?attr/colorPrimary"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent" />

            <!-- 1. TÊN CA -->
            <TextView
                android:id="@+id/tv_shift_name"
                style="@style/BodyTextMediumStyle"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/spacing_m"
                android:layout_marginTop="@dimen/spacing_m"
                android:layout_marginEnd="@dimen/spacing_s"
                android:ellipsize="end"
                android:maxLines="1"
                android:textStyle="bold"
                app:layout_constraintEnd_toStartOf="@id/tag_shift_status"
                app:layout_constraintStart_toEndOf="@id/view_accent"
                app:layout_constraintTop_toTopOf="parent"
                tools:text="Ca Sáng" />

            <!-- CHIP TRẠNG THÁI (căn giữa theo chiều dọc cả thẻ) -->
            <com.google.android.material.chip.Chip
                android:id="@+id/tag_shift_status"
                style="@style/ChipStatusStyle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginEnd="@dimen/spacing_m"
                android:text="Chưa vào ca"
                app:chipBackgroundColor="?attr/colorSurfaceVariant"
                app:ensureMinTouchTargetSize="false"
                app:layout_constraintBottom_toBottomOf="@+id/tv_shift_time"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toTopOf="@+id/tv_shift_name" />

            <!-- 2. KHUNG GIỜ (có icon) -->
            <ImageView
                android:id="@+id/iv_shift_icon"
                android:layout_width="14dp"
                android:layout_height="14dp"
                android:layout_marginStart="@dimen/spacing_m"
                android:contentDescription="@null"
                android:src="@drawable/ic_schedule"
                app:layout_constraintBottom_toBottomOf="@id/tv_shift_time"
                app:layout_constraintStart_toEndOf="@id/view_accent"
                app:layout_constraintTop_toTopOf="@id/tv_shift_time"
                app:tint="?attr/colorPrimary" />

            <TextView
                android:id="@+id/tv_shift_time"
                style="@style/TitleTextSmallStyle"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="7dp"
                android:layout_marginEnd="@dimen/spacing_s"
                android:ellipsize="end"
                android:maxLines="1"
                android:textColor="?attr/colorPrimary"
                android:textStyle="bold"
                app:layout_constraintEnd_toStartOf="@id/tag_shift_status"
                app:layout_constraintStart_toEndOf="@id/iv_shift_icon"
                app:layout_constraintTop_toBottomOf="@id/tv_shift_name"
                tools:text="08:00 - 17:00" />

            <!-- 3. ĐỊA ĐIỂM (có icon) -->
            <ImageView
                android:id="@+id/iv_shift_location"
                android:layout_width="14dp"
                android:layout_height="14dp"
                android:layout_marginStart="@dimen/spacing_m"
                android:contentDescription="@null"
                android:src="@drawable/ic_location"
                app:layout_constraintBottom_toBottomOf="@id/tv_shift_location"
                app:layout_constraintStart_toEndOf="@id/view_accent"
                app:layout_constraintTop_toTopOf="@id/tv_shift_location"
                app:tint="?attr/colorOnSurfaceVariant" />

            <TextView
                android:id="@+id/tv_shift_location"
                style="@style/BodyTextSmallStyle"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="7dp"
                android:layout_marginTop="2dp"
                android:layout_marginEnd="@dimen/spacing_m"
                android:layout_marginBottom="@dimen/spacing_m"
                android:ellipsize="end"
                android:maxLines="1"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toEndOf="@id/iv_shift_location"
                app:layout_constraintTop_toBottomOf="@id/tv_shift_time"
                tools:text="Văn phòng chính · Tầng 3, 123 Đường Láng, Đống Đa, Hà Nội" />

        </androidx.constraintlayout.widget.ConstraintLayout>

    </com.google.android.material.card.MaterialCardView>

</androidx.constraintlayout.widget.ConstraintLayout>