<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">

    <TextView
        android:id="@+id/tv_action_required_label"
        style="@style/TitleTextMediumStyle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Cần xử lý"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <!-- Card hiển thị khi chưa có yêu cầu cần xử lý -->
    <com.google.android.material.card.MaterialCardView
        android:id="@+id/card_empty_action_required"
        style="@style/MainCard"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/spacing_s"
        app:cardCornerRadius="@dimen/radius_m"
        app:strokeColor="?attr/colorPrimaryContainer"
        app:strokeWidth="1dp"
        app:layout_constraintTop_toBottomOf="@id/tv_action_required_label"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:padding="@dimen/spacing_m">

            <ImageView
                android:layout_width="@dimen/icon_size_l"
                android:layout_height="@dimen/icon_size_l"
                android:contentDescription="@null"
                android:src="@drawable/ic_check_circle"
                app:tint="?attr/colorPrimary" />

            <TextView
                android:id="@+id/tv_empty_action_msg"
                style="@style/BodyTextMediumStyle"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/spacing_s"
                android:layout_marginEnd="@dimen/spacing_s"
                android:layout_weight="1"
                android:text="Chưa có yêu cầu xử lý"
                android:textColor="?attr/colorOnSurface" />
        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rv_action_required"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/spacing_s"
        android:nestedScrollingEnabled="false"
        android:visibility="gone"
        app:layout_constraintTop_toBottomOf="@id/tv_action_required_label"
        tools:itemCount="2"
        tools:listitem="@layout/item_manager_action_required" />

</androidx.constraintlayout.widget.ConstraintLayout>
