<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">

    <TextView
        android:id="@+id/tv_today_shifts_label"
        style="@style/TitleTextMediumStyle"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:text="Ca làm việc hôm nay"
        app:layout_constraintEnd_toStartOf="@id/tv_see_all_shifts"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <TextView
        android:id="@+id/tv_see_all_shifts"
        style="@style/TitleTextSmallStyle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:background="?attr/selectableItemBackground"
        android:clickable="true"
        android:focusable="true"
        android:padding="@dimen/spacing_3xs"
        android:text="Xem lịch"
        android:textColor="?attr/colorPrimary"
        android:textSize="@dimen/text_size_label_medium"
        android:textStyle="bold"
        app:layout_constraintBottom_toBottomOf="@id/tv_today_shifts_label"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="@id/tv_today_shifts_label" />

    <!-- CONTAINER CHỨA CẢ CARD TRỐNG VÀ RECYCLERVIEW -->
    <FrameLayout
        android:id="@+id/fl_today_shifts_container"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/spacing_s"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/tv_today_shifts_label">

        <!-- 1. Card hiển thị khi chưa có ca làm việc -->
        <include
            android:id="@+id/include_shift_today"
            layout="@layout/layout_empty_shift"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:visibility="visible"
            tools:visibility="visible" />

        <!-- 2. Danh sách ca làm việc -->
        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/rv_today_shifts"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:nestedScrollingEnabled="false"
            android:visibility="gone"
            app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager"
            tools:itemCount="3"
            tools:listitem="@layout/item_shift_today"
            tools:visibility="gone" />

    </FrameLayout>

</androidx.constraintlayout.widget.ConstraintLayout>