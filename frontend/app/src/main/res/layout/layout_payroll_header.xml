<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/layout_header"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_card_gradient"
    android:padding="@dimen/spacing_m">

    <!-- BUTTON BACK -->
    <ImageView
        android:id="@+id/btn_back"
        android:layout_width="@dimen/icon_size_xl"
        android:layout_height="@dimen/icon_size_xl"
        android:background="@drawable/bg_time_chip"
        android:clickable="true"
        android:contentDescription="Quay lại"
        android:focusable="true"
        android:padding="@dimen/spacing_2xs"
        android:rotation="180"
        android:src="@drawable/ic_chevron_right"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:tint="?attr/colorOnPrimary" />

    <!-- TITLE (Cùng hàng & Căn giữa dọc theo btn_back) -->
    <TextView
        android:id="@+id/tv_screen_title"
        style="@style/TitleTextLargeStyle"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/spacing_m"
        android:text="Quản lý lương"
        android:textColor="?attr/colorOnPrimary"
        app:layout_constraintBottom_toBottomOf="@id/btn_back"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toEndOf="@id/btn_back"
        app:layout_constraintTop_toTopOf="@id/btn_back" />

    <!-- SUBTITLE -->
    <TextView
        android:id="@+id/tv_header_subtitle"
        style="@style/BodyTextMediumStyle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/spacing_s"
        android:text="Lịch sử lương của bạn"
        android:textColor="?attr/colorOnPrimary"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/btn_back" />

    <!-- 3 TOP STATS CARD -->
    <LinearLayout
        android:id="@+id/layout_stats_grid"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/spacing_s"
        android:baselineAligned="false"
        android:orientation="horizontal"
        app:layout_constraintTop_toBottomOf="@id/tv_header_subtitle">

        <!-- CARD 1: LƯƠNG CƠ BẢN -->
        <com.google.android.material.card.MaterialCardView
            style="@style/WaterCard"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginEnd="@dimen/spacing_s"
            android:layout_weight="1">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:orientation="vertical"
                android:paddingVertical="@dimen/spacing_s">

                <TextView
                    android:id="@+id/tv_stat_basic"
                    style="@style/TitleTextLargeStyle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="15.0M"
                    android:textColor="?attr/colorSurfaceVariant" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/spacing_3xs"
                    android:text="Lương cơ bản"
                    android:textColor="?attr/colorSurfaceVariant"
                    android:textSize="@dimen/text_size_body_small" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- CARD 2: THÁNG CAO NHẤT -->
        <com.google.android.material.card.MaterialCardView
            style="@style/WaterCard"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginEnd="@dimen/spacing_s"
            android:layout_weight="1">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:orientation="vertical"
                android:paddingVertical="@dimen/spacing_s">

                <TextView
                    android:id="@+id/tv_stat_max"
                    style="@style/TitleTextLargeStyle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="16.5M"
                    android:textColor="?attr/colorSurfaceVariant" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/spacing_3xs"
                    android:text="Tháng cao nhất"
                    android:textColor="?attr/colorSurfaceVariant"
                    android:textSize="@dimen/text_size_body_small" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- CARD 3: TRUNG BÌNH -->
        <com.google.android.material.card.MaterialCardView
            style="@style/WaterCard"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:orientation="vertical"
                android:paddingVertical="@dimen/spacing_s">

                <TextView
                    android:id="@+id/tv_stat_avg"
                    style="@style/TitleTextLargeStyle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="15.2M"
                    android:textColor="?attr/colorSurfaceVariant" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/spacing_3xs"
                    android:text="Trung bình"
                    android:textColor="?attr/colorSurfaceVariant"
                    android:textSize="@dimen/text_size_body_small" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>