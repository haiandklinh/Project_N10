<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:paddingBottom="@dimen/spacing_xl">

    <!-- Progress Indicator: Bước 1 hoàn tất, Bước 2 đang active -->
    <LinearLayout
        android:id="@+id/layoutProgress"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center_horizontal"
        android:layout_marginTop="@dimen/spacing_xl"
        android:gravity="center"
        android:orientation="horizontal"
        android:padding="@dimen/spacing_2xl">

        <TextView
            android:id="@+id/step1Indicator"
            android:layout_width="@dimen/spacing_3xl"
            android:layout_height="@dimen/spacing_3xl"
            android:background="@drawable/bg_dot_active"
            android:contentDescription="@string/auth_step_1_desc"
            android:gravity="center"
            android:text="1"
            android:textColor="@color/white"
            android:textStyle="bold" />

        <View
            android:id="@+id/line1"
            android:layout_width="@dimen/spacing_4xl"
            android:layout_height="@dimen/spacing_3xs"
            android:layout_marginHorizontal="@dimen/spacing_s"
            android:background="?attr/colorPrimary" />

        <TextView
            android:id="@+id/step2Indicator"
            android:layout_width="@dimen/spacing_3xl"
            android:layout_height="@dimen/spacing_3xl"
            android:background="@drawable/bg_dot_active"
            android:contentDescription="@string/auth_step_2_desc"
            android:gravity="center"
            android:text="2"
            android:textColor="@color/white"
            android:textStyle="bold" />

        <View
            android:id="@+id/line2"
            android:layout_width="@dimen/spacing_4xl"
            android:layout_height="@dimen/spacing_3xs"
            android:layout_marginHorizontal="@dimen/spacing_s"
            android:background="?attr/colorOutline" />

        <TextView
            android:id="@+id/step3Indicator"
            android:layout_width="@dimen/spacing_3xl"
            android:layout_height="@dimen/spacing_3xl"
            android:background="@drawable/bg_dot_inactive"
            android:contentDescription="@string/auth_step_3_desc"
            android:gravity="center"
            android:text="3"
            android:textColor="?attr/colorPrimary"
            android:textStyle="bold" />
    </LinearLayout>

    <TextView
        android:id="@+id/tvStepTitle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/spacing_s"
        android:gravity="center"
        android:text="@string/auth_step2_title"
        android:textSize="@dimen/text_size_title_medium"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/tvStepSubtitle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/spacing_3xs"
        android:layout_marginBottom="@dimen/spacing_m"
        android:gravity="center"
        android:text="@string/auth_step2_subtitle"
        android:textColor="?attr/colorOnSurfaceVariant"
        android:textSize="@dimen/text_size_body_medium" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingHorizontal="@dimen/spacing_xl">

        <!-- So dien thoai -->
        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/tilPhone"
            style="@style/AppTextInputLayout"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="@string/auth_phone_hint"
            app:errorEnabled="true"
            app:startIconDrawable="@drawable/ic_phone">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/edtPhone"
                style="@style/AppTextInputEditText"
                android:inputType="phone"
                android:maxLength="10" />
        </com.google.android.material.textfield.TextInputLayout>

        <!-- Hien trang thai da xac thuc, an mac dinh. Sau khi bottom sheet xac nhan OTP thanh cong thi hien len -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/layoutVerifiedStatus"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            style="@style/MainCard"
            android:visibility="gone"
            app:cardBackgroundColor="?attr/colorPrimaryContainer"
            app:cardCornerRadius="@dimen/radius_m"
            app:cardElevation="0dp"
            app:strokeWidth="0dp"
            tools:visibility="visible">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:padding="@dimen/spacing_m">

                <ImageView
                    android:layout_width="@dimen/spacing_xl"
                    android:layout_height="@dimen/spacing_xl"
                    android:importantForAccessibility="no"
                    android:src="@drawable/ic_check_circle"
                    app:tint="?attr/colorAttendancePresent" />

                <TextView
                    android:id="@+id/tvVerifiedPhone"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/spacing_s"
                    android:layout_weight="1"
                    android:textColor="?attr/colorAttendancePresent"
                    android:textSize="@dimen/text_size_body_medium"
                    android:textStyle="bold"
                    tools:text="0912***789 đã xác thực" />
            </LinearLayout>

        </com.google.android.material.card.MaterialCardView>

        <!-- Cum nut duoi cung: Quay lai + Tiep tuc (Tiep tuc gom luon logic gui OTP) -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/spacing_l"
            android:orientation="horizontal">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/tvBackStep1"
                style="@style/ButtonOutlinedSmallStyle"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginEnd="@dimen/spacing_xl"
                android:text="@string/action_back"
                app:strokeColor="?attr/colorPrimary" />

            <!--
                Bam lan dau (chua xac thuc): goi API gui OTP -> mo Bottom Sheet nhap OTP.
                Sau khi Bottom Sheet xac nhan thanh cong: bam lan nua se sang Buoc 3.
                Luon enabled vi ban than no la nut kich hoat gui OTP.
            -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnContinueStep2"
                style="@style/ButtonFilledSmallStyle"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/action_next" />
        </LinearLayout>
    </LinearLayout>
</LinearLayout>