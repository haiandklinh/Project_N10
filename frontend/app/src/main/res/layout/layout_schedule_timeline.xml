<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/card_week_header"
    style="@style/MainCard"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginTop="@dimen/spacing_m">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/bg_card_gradient"
        android:padding="@dimen/spacing_m">

        <!-- ==================== HEADER NAVIGATION (CÂN GIỮA ĐỀU) ==================== -->
        <ImageView
            android:id="@+id/btn_prev_week"
            android:layout_width="@dimen/icon_size_m"
            android:layout_height="@dimen/icon_size_m"
            android:background="@drawable/bg_time_chip"
            android:clickable="true"
            android:contentDescription="Tuần trước"
            android:focusable="true"
            android:padding="4dp"
            android:src="@drawable/ic_chevron_left"
            app:layout_constraintBottom_toBottomOf="@id/tv_week_range"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="@id/tv_week_range"
            app:tint="?attr/colorOnPrimary" />

        <TextView
            android:id="@+id/tv_week_range"
            style="@style/BodyTextLargeStyle"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:textColor="?attr/colorOnPrimary"
            android:textStyle="bold"
            app:layout_constraintEnd_toStartOf="@id/btn_next_week"
            app:layout_constraintStart_toEndOf="@id/btn_prev_week"
            app:layout_constraintTop_toTopOf="parent"
            tools:text="15/09 – 21/09, 2026" />

        <ImageView
            android:id="@+id/btn_next_week"
            android:layout_width="@dimen/icon_size_m"
            android:layout_height="@dimen/icon_size_m"
            android:background="@drawable/bg_time_chip"
            android:clickable="true"
            android:contentDescription="Tuần sau"
            android:focusable="true"
            android:padding="4dp"
            android:src="@drawable/ic_chevron_right"
            app:layout_constraintBottom_toBottomOf="@id/tv_week_range"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="@id/tv_week_range"
            app:tint="?attr/colorOnPrimary" />

        <!-- Divider 1 -->
        <View
            android:id="@+id/divider_header"
            android:layout_width="0dp"
            android:layout_height="1dp"
            android:layout_marginTop="@dimen/spacing_s"
            android:alpha="0.2"
            android:background="?attr/colorOnPrimary"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/tv_week_range" />

        <!-- ==================== STRIP 7 NGÀY TRONG TUẦN (CHIA 7 CỘT BẰNG NHAU) ==================== -->
        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/rv_week_days"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/spacing_s"
            android:clipToPadding="false"
            app:layoutManager="androidx.recyclerview.widget.GridLayoutManager"
            app:spanCount="7"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/divider_header"
            tools:itemCount="7"
            tools:listitem="@layout/item_schedule_week_day" />

        <!-- Divider 2 -->
        <View
            android:id="@+id/divider_summary"
            android:layout_width="0dp"
            android:layout_height="1dp"
            android:layout_marginTop="@dimen/spacing_s"
            android:alpha="0.2"
            android:background="?attr/colorOnPrimary"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/rv_week_days" />

        <!-- ==================== THỐNG KÊ TỔNG QUAN (CÂN BẰNG CHIỀU DỌC & NGANG) ==================== -->
        <!-- Chỉ số 1: Tổng Ca -->
        <TextView
            android:id="@+id/tv_total_shifts"
            style="@style/TitleTextMediumStyle"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/spacing_s"
            android:gravity="center"
            android:textColor="?attr/colorOnPrimary"
            android:textStyle="bold"
            app:layout_constraintEnd_toStartOf="@id/divider_vertical"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/divider_summary"
            tools:text="5 ca" />

        <TextView
            android:id="@+id/tv_label_total_shifts"
            style="@style/BodyTextSmallStyle"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:text="Tổng ca tuần"
            android:textColor="?attr/colorOnPrimary"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="@id/tv_total_shifts"
            app:layout_constraintStart_toStartOf="@id/tv_total_shifts"
            app:layout_constraintTop_toBottomOf="@id/tv_total_shifts" />

        <!-- Divider Dọc -->
        <View
            android:id="@+id/divider_vertical"
            android:layout_width="1dp"
            android:layout_height="0dp"
            android:alpha="0.3"
            android:background="?attr/colorOnPrimary"
            app:layout_constraintBottom_toBottomOf="@id/tv_label_total_shifts"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="@id/tv_total_shifts" />

        <!-- Chỉ số 2: Dự Kiến Làm -->
        <TextView
            android:id="@+id/tv_total_hours"
            style="@style/TitleTextMediumStyle"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:textColor="?attr/colorOnPrimary"
            android:textStyle="bold"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toEndOf="@id/divider_vertical"
            app:layout_constraintTop_toTopOf="@id/tv_total_shifts"
            tools:text="40.0 giờ" />

        <TextView
            android:id="@+id/tv_label_total_hours"
            style="@style/BodyTextSmallStyle"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:text="Dự kiến làm"
            android:textColor="?attr/colorOnPrimary"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="@id/tv_total_hours"
            app:layout_constraintStart_toStartOf="@id/tv_total_hours"
            app:layout_constraintTop_toBottomOf="@id/tv_total_hours" />

    </androidx.constraintlayout.widget.ConstraintLayout>

</com.google.android.material.card.MaterialCardView>