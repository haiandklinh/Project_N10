<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    style="@style/MainCard"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="@dimen/spacing_m">

        <!-- Tiêu đề -->
        <TextView
            android:id="@+id/tv_chart_title"
            style="@style/TitleTextMediumStyle"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:textColor="?attr/colorOnSurface"
            android:textSize="16sp"
            android:textStyle="bold"
            app:layout_constraintEnd_toStartOf="@id/tv_chart_subtitle"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            tools:text="Giờ làm tuần này" />

        <!-- Subtitle Khoảng thời gian -->
        <TextView
            android:id="@+id/tv_chart_subtitle"
            style="@style/BodyTextSmallStyle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="?attr/colorOnSurfaceVariant"
            android:textSize="12sp"
            app:layout_constraintBottom_toBottomOf="@id/tv_chart_title"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="@id/tv_chart_title"
            tools:text="08/09 – 13/09" />

        <!-- Biểu đồ Cột -->
        <com.github.mikephil.charting.charts.BarChart
            android:id="@+id/bar_chart"
            android:layout_width="0dp"
            android:layout_height="170dp"
            android:layout_marginTop="@dimen/spacing_m"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/tv_chart_title" />

        <!-- ==================== LEGEND CHÚ THÍCH CĂN GIỮA ==================== -->

        <TextView
            android:id="@+id/tv_legend_overtime"
            style="@style/BodyTextSmallStyle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/spacing_m"
            android:drawablePadding="6dp"
            android:text="≥ 9h"
            android:textColor="?attr/colorOnSurfaceVariant"
            android:textSize="12sp"
            app:drawableStartCompat="@drawable/ic_circle"
            app:drawableTint="?attr/colorAttendancePresent"
            app:layout_constraintEnd_toStartOf="@id/tv_legend_standard"
            app:layout_constraintHorizontal_chainStyle="packed"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/bar_chart" />

        <TextView
            android:id="@+id/tv_legend_standard"
            style="@style/BodyTextSmallStyle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/spacing_m"
            android:drawablePadding="6dp"
            android:text="8 - 9h"
            android:textColor="?attr/colorOnSurfaceVariant"
            android:textSize="12sp"
            app:drawableStartCompat="@drawable/ic_circle"
            app:drawableTint="?attr/colorAttendanceEarlyLeave"
            app:layout_constraintBottom_toBottomOf="@id/tv_legend_overtime"
            app:layout_constraintEnd_toStartOf="@id/tv_legend_under"
            app:layout_constraintStart_toEndOf="@id/tv_legend_overtime"
            app:layout_constraintTop_toTopOf="@id/tv_legend_overtime" />

        <TextView
            android:id="@+id/tv_legend_under"
            style="@style/BodyTextSmallStyle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/spacing_m"
            android:drawablePadding="6dp"
            android:text="&lt; 8h"
            android:textColor="?attr/colorOnSurfaceVariant"
            android:textSize="12sp"
            app:drawableStartCompat="@drawable/ic_circle"
            app:drawableTint="?attr/colorAttendanceLate"
            app:layout_constraintBottom_toBottomOf="@id/tv_legend_overtime"
            app:layout_constraintEnd_toStartOf="@id/tv_legend_off"
            app:layout_constraintStart_toEndOf="@id/tv_legend_standard"
            app:layout_constraintTop_toTopOf="@id/tv_legend_overtime" />

        <TextView
            android:id="@+id/tv_legend_off"
            style="@style/BodyTextSmallStyle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/spacing_m"
            android:drawablePadding="6dp"
            android:text="Nghỉ"
            android:textColor="?attr/colorOnSurfaceVariant"
            android:textSize="12sp"
            app:drawableStartCompat="@drawable/ic_circle"
            app:drawableTint="?attr/colorAttendanceAbsent"
            app:layout_constraintBottom_toBottomOf="@id/tv_legend_overtime"
            app:layout_constraintStart_toEndOf="@id/tv_legend_under"
            app:layout_constraintTop_toTopOf="@id/tv_legend_overtime" />

    </androidx.constraintlayout.widget.ConstraintLayout>

</com.google.android.material.card.MaterialCardView>