<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/layout_header"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_card_gradient"
    android:padding="@dimen/spacing_m">

    <!-- BUTTON BACK -->
    <ImageView
        android:id="@+id/btn_back"
        android:layout_width="@dimen/icon_size_xl"
        android:layout_height="@dimen/icon_size_xl"
        android:background="@drawable/bg_time_icon_circle"
        android:clickable="true"
        android:contentDescription="Quay lại"
        android:focusable="true"
        android:padding="@dimen/spacing_2xs"
        android:rotation="180"
        android:src="@drawable/ic_chevron_right"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:tint="?attr/colorOnPrimary" />

    <!-- Title -->
    <TextView
        android:id="@+id/tv_screen_title"
        style="@style/TitleTextLargeStyle"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/spacing_m"
        android:layout_marginEnd="@dimen/spacing_s"
        android:text="Thống kê"
        android:textColor="?attr/colorOnPrimary"
        app:layout_constraintBottom_toBottomOf="@id/btn_back"
        app:layout_constraintEnd_toStartOf="@id/divider_vertical"
        app:layout_constraintStart_toEndOf="@id/btn_back"
        app:layout_constraintTop_toTopOf="@id/btn_back" />

    <!-- HORIZONTAL DIVIDER (Đường gạch ngang chia Title và Month) -->
    <View
        android:id="@+id/divider_horizontal"
        android:layout_width="0dp"
        android:layout_height="1dp"
        android:alpha="0.3"
        android:layout_marginTop="@dimen/spacing_2xs"
        android:layout_marginEnd="@dimen/spacing_s"
        android:background="?attr/colorOutline"
        app:layout_constraintEnd_toStartOf="@id/divider_vertical"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/btn_back" />

    <!-- LINEAR LAYOUT BỌC CỤM ĐIỀU HƯỚNG THÁNG/NĂM -->
    <LinearLayout
        android:id="@+id/layout_month_navigation"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/spacing_2xs"
        android:layout_marginEnd="@dimen/spacing_s"
        android:gravity="center"
        android:orientation="horizontal"
        app:layout_constraintEnd_toStartOf="@id/divider_vertical"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/divider_horizontal">

        <ImageView
            android:id="@+id/btn_prev_month"
            android:layout_width="@dimen/icon_size_xl"
            android:layout_height="@dimen/icon_size_xl"
            android:background="@drawable/bg_time_chip"
            android:clickable="true"
            android:contentDescription="Tháng trước"
            android:focusable="true"
            android:padding="@dimen/spacing_xs"
            android:src="@drawable/ic_chevron_left"
            app:tint="?attr/colorOnPrimary" />

        <TextView
            android:id="@+id/tv_header_subtitle"
            style="@style/BodyTextMediumStyle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="@dimen/spacing_m"
            android:text="Tháng 9/2026"
            android:textColor="?attr/colorOnPrimary" />

        <ImageView
            android:id="@+id/btn_next_month"
            android:layout_width="@dimen/icon_size_xl"
            android:layout_height="@dimen/icon_size_xl"
            android:background="@drawable/bg_time_chip"
            android:clickable="true"
            android:contentDescription="Tháng sau"
            android:focusable="true"
            android:padding="@dimen/spacing_xs"
            android:src="@drawable/ic_chevron_right"
            app:tint="?attr/colorOnPrimary" />

    </LinearLayout>

    <!-- VERTICAL DIVIDER (Đường gạch đứng nằm ở giữa Switch và Header) -->
    <View
        android:id="@+id/divider_vertical"
        android:layout_width="1dp"
        android:layout_height="0dp"
        android:alpha="0.3"
        android:layout_marginHorizontal="@dimen/spacing_s"
        android:background="?attr/colorOutline"
        app:layout_constraintBottom_toBottomOf="@id/layout_month_navigation"
        app:layout_constraintEnd_toStartOf="@id/toggle_group_time"
        app:layout_constraintTop_toTopOf="@id/btn_back" />

    <!-- Toggle Button Tuần / Tháng -->
    <com.google.android.material.button.MaterialButtonToggleGroup
        android:id="@+id/toggle_group_time"
        android:layout_width="wrap_content"
        android:layout_height="@dimen/icon_container_m"
        app:checkedButton="@id/btn_mode_month"
        app:layout_constraintBottom_toBottomOf="@+id/layout_month_navigation"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="@id/btn_back"
        app:selectionRequired="true"
        app:singleSelection="true">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_mode_week"
            style="@style/Widget.Material3.Button.OutlinedButton"
            android:layout_width="40dp"
            android:layout_height="match_parent"
            android:padding="0dp"
            android:text="Tuần"
            android:textColor="?attr/colorOnPrimary"
            android:textSize="@dimen/text_size_label_medium" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_mode_month"
            style="@style/Widget.Material3.Button.OutlinedButton"
            android:layout_width="40dp"
            android:layout_height="match_parent"
            android:padding="0dp"
            android:text="Tháng"
            android:textColor="?attr/colorPrimary"
            android:textSize="@dimen/text_size_label_medium" />
    </com.google.android.material.button.MaterialButtonToggleGroup>

    <!-- HORIZONTAL DIVIDER TRÊN LƯỚI CARD THỐNG KÊ -->
    <View
        android:id="@+id/divider_stats_top"
        android:layout_width="0dp"
        android:layout_height="1dp"
        android:alpha="0.3"
        android:layout_marginTop="@dimen/spacing_2xs"
        android:background="?attr/colorOutline"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/layout_month_navigation" />

    <!-- 3 TOP STATS CARD (NGÀY CÔNG / TỔNG GIỜ / CHUYÊN CẦN) -->
    <LinearLayout
        android:id="@+id/layout_stats_grid"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/spacing_m"
        android:baselineAligned="false"
        android:orientation="horizontal"
        app:layout_constraintTop_toBottomOf="@id/divider_stats_top">

        <!-- Stat 1: Ngày công -->
        <com.google.android.material.card.MaterialCardView
            style="@style/WaterCard"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginEnd="@dimen/spacing_s"
            android:layout_weight="1">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:orientation="vertical"
                android:paddingVertical="@dimen/spacing_s">

                <TextView
                    android:id="@+id/tv_header_work_days"
                    style="@style/TitleTextLargeStyle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="12"
                    android:textColor="?attr/colorSurfaceVariant" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/spacing_3xs"
                    android:text="Ngày công"
                    android:textColor="?attr/colorSurfaceVariant"
                    android:textSize="@dimen/text_size_body_small" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- Stat 2: Tổng giờ -->
        <com.google.android.material.card.MaterialCardView
            style="@style/WaterCard"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginEnd="@dimen/spacing_s"
            android:layout_weight="1">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:orientation="vertical"
                android:paddingVertical="@dimen/spacing_s">

                <TextView
                    android:id="@+id/tv_header_total_hours"
                    style="@style/TitleTextLargeStyle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="98h"
                    android:textColor="?attr/colorSurfaceVariant" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/spacing_3xs"
                    android:text="Tổng giờ"
                    android:textColor="?attr/colorSurfaceVariant"
                    android:textSize="@dimen/text_size_body_small" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- Stat 3: Chuyên cần -->
        <com.google.android.material.card.MaterialCardView
            style="@style/WaterCard"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:orientation="vertical"
                android:paddingVertical="@dimen/spacing_s">

                <TextView
                    android:id="@+id/tv_header_attendance_rate"
                    style="@style/TitleTextLargeStyle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="55%"
                    android:textColor="?attr/colorSurfaceVariant" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/spacing_3xs"
                    android:text="Chuyên cần"
                    android:textColor="?attr/colorSurfaceVariant"
                    android:textSize="@dimen/text_size_body_small" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>