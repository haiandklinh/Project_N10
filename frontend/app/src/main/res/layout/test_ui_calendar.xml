<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    xmlns:tools="http://schemas.android.com/tools"
    xmlns:app="http://schemas.android.com/apk/res-auto">

    <com.google.android.material.card.MaterialCardView
        android:id="@+id/card_header"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="@dimen/spacing_m"
        android:layout_marginTop="@dimen/spacing_xs"
        app:cardCornerRadius="@dimen/radius_l"
        app:cardElevation="0dp"
        app:layout_constraintTop_toBottomOf="@id/toolbar"
        app:strokeWidth="0dp">

        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/layout_header"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_card_gradient"
            android:padding="@dimen/spacing_m">

            <!-- Điều hướng tháng/năm -->
            <LinearLayout
                android:id="@+id/layout_month_navigation"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:orientation="horizontal"
                app:layout_constraintBottom_toBottomOf="@id/toggle_group_time"
                app:layout_constraintEnd_toStartOf="@id/divider_vertical"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="@id/toggle_group_time">

                <ImageView
                    android:id="@+id/btn_prev_month"
                    android:layout_width="@dimen/icon_size_xl"
                    android:layout_height="@dimen/icon_size_xl"
                    android:background="@drawable/bg_time_icon_circle"
                    android:clickable="true"
                    android:focusable="true"
                    android:padding="@dimen/spacing_xs"
                    android:src="@drawable/ic_chevron_left"
                    app:tint="?attr/colorOnPrimary" />

                <TextView
                    android:id="@+id/tv_month_title"
                    style="@style/TitleTextMediumStyle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginHorizontal="@dimen/spacing_s"
                    android:ellipsize="end"
                    android:maxLines="1"
                    android:textColor="?attr/colorOnPrimary"
                    android:textStyle="bold"
                    tools:text="Tháng 10/2026" />

                <ImageView
                    android:id="@+id/btn_next_month"
                    android:layout_width="@dimen/icon_size_xl"
                    android:layout_height="@dimen/icon_size_xl"
                    android:background="@drawable/bg_time_icon_circle"
                    android:clickable="true"
                    android:focusable="true"
                    android:padding="@dimen/spacing_xs"
                    android:src="@drawable/ic_chevron_right"
                    app:tint="?attr/colorOnPrimary" />
            </LinearLayout>

            <!-- Vạch đứng -->
            <View
                android:id="@+id/divider_vertical"
                android:layout_width="1dp"
                android:layout_height="22dp"
                android:layout_marginHorizontal="@dimen/spacing_s"
                android:alpha="0.3"
                android:background="?attr/colorOnPrimary"
                app:layout_constraintBottom_toBottomOf="@id/toggle_group_time"
                app:layout_constraintEnd_toStartOf="@id/toggle_group_time"
                app:layout_constraintTop_toTopOf="@id/toggle_group_time" />

            <!-- Toggle Tuần / Tháng -->
            <com.google.android.material.button.MaterialButtonToggleGroup
                android:id="@+id/toggle_group_time"
                android:layout_width="wrap_content"
                android:layout_height="28dp"
                android:layout_marginVertical="@dimen/spacing_xs"
                app:checkedButton="@id/btn_mode_week"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                app:selectionRequired="true"
                app:singleSelection="true">

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btn_mode_week"
                    style="@style/Widget.Material3.Button.OutlinedButton"
                    android:layout_width="wrap_content"
                    android:layout_height="match_parent"
                    android:backgroundTint="@color/filter_chip_bg_selector"
                    android:insetTop="0dp"
                    android:insetBottom="0dp"
                    android:paddingHorizontal="@dimen/spacing_s"
                    android:text="W"
                    android:textColor="@color/filter_chip_text_selector"
                    android:textSize="@dimen/text_size_label_medium"
                    android:textStyle="bold" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btn_mode_month"
                    style="@style/Widget.Material3.Button.OutlinedButton"
                    android:layout_width="wrap_content"
                    android:layout_height="match_parent"
                    android:backgroundTint="@color/filter_chip_bg_selector"
                    android:insetTop="0dp"
                    android:insetBottom="0dp"
                    android:paddingHorizontal="@dimen/spacing_s"
                    android:text="M"
                    android:textColor="@color/filter_chip_text_selector"
                    android:textSize="@dimen/text_size_label_medium"
                    android:textStyle="bold" />
            </com.google.android.material.button.MaterialButtonToggleGroup>

            <!-- Vạch ngang -->
            <View
                android:id="@+id/divider_calendar_top"
                android:layout_width="0dp"
                android:layout_height="1dp"
                android:layout_marginTop="@dimen/spacing_s"
                android:alpha="0.2"
                android:background="?attr/colorOnPrimary"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@id/toggle_group_time" />

            <!-- Hàng thứ trong tuần (7 cột chia đều) -->
            <LinearLayout
                android:id="@+id/calendar_week_header"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/spacing_xs"
                android:baselineAligned="false"
                android:orientation="horizontal"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@id/divider_calendar_top">

                <TextView
                    android:id="@+id/tv_mon"
                    style="@style/BodyTextSmallStyle"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:alpha="0.8"
                    android:gravity="center"
                    android:text="T2"
                    android:textColor="?attr/colorOnPrimary"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tv_tue"
                    style="@style/BodyTextSmallStyle"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:alpha="0.8"
                    android:gravity="center"
                    android:text="T3"
                    android:textColor="?attr/colorOnPrimary"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tv_wed"
                    style="@style/BodyTextSmallStyle"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:alpha="0.8"
                    android:gravity="center"
                    android:text="T4"
                    android:textColor="?attr/colorOnPrimary"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tv_thu"
                    style="@style/BodyTextSmallStyle"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:alpha="0.8"
                    android:gravity="center"
                    android:text="T5"
                    android:textColor="?attr/colorOnPrimary"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tv_fri"
                    style="@style/BodyTextSmallStyle"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:alpha="0.8"
                    android:gravity="center"
                    android:text="T6"
                    android:textColor="?attr/colorOnPrimary"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tv_sat"
                    style="@style/BodyTextSmallStyle"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:alpha="0.8"
                    android:gravity="center"
                    android:text="T7"
                    android:textColor="?attr/colorOnPrimary"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tv_sun"
                    style="@style/BodyTextSmallStyle"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:gravity="center"
                    android:text="CN"
                    android:textColor="?attr/colorError"
                    android:textStyle="bold" />
            </LinearLayout>

            <!-- Lưới ngày (thay cho rv_week_days) -->
            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/rv_calendar_grid"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/spacing_2xs"
                android:nestedScrollingEnabled="false"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@id/calendar_week_header"
                tools:itemCount="35"
                tools:layoutManager="androidx.recyclerview.widget.GridLayoutManager"
                tools:listitem="@layout/item_history_calendar_day"
                tools:spanCount="7" />

            <!-- Vạch trước legend -->
            <View
                android:id="@+id/divider_legend"
                android:layout_width="0dp"
                android:layout_height="1dp"
                android:layout_marginTop="@dimen/spacing_xs"
                android:alpha="0.2"
                android:background="?attr/colorOnPrimary"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@id/rv_calendar_grid" />

            <!-- Legend -->
            <GridLayout
                android:id="@+id/layout_calendar_legend"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/spacing_xs"
                android:columnCount="3"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@id/divider_legend">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_columnWeight="1"
                    android:gravity="center"
                    android:orientation="horizontal">

                    <View
                        android:layout_width="8dp"
                        android:layout_height="8dp"
                        android:background="@drawable/bg_status_dot"
                        android:backgroundTint="?attr/colorAttendancePresent" />

                    <TextView
                        style="@style/BodyTextSmallStyle"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="6dp"
                        android:text="Đủ quân số"
                        android:textColor="?attr/colorOnPrimary" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_columnWeight="1"
                    android:gravity="center"
                    android:orientation="horizontal">

                    <View
                        android:layout_width="8dp"
                        android:layout_height="8dp"
                        android:background="@drawable/bg_status_dot"
                        android:backgroundTint="?attr/colorAttendanceLate" />

                    <TextView
                        style="@style/BodyTextSmallStyle"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="6dp"
                        android:text="Chờ duyệt"
                        android:textColor="?attr/colorOnPrimary" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_columnWeight="1"
                    android:gravity="center"
                    android:orientation="horizontal">

                    <View
                        android:layout_width="8dp"
                        android:layout_height="8dp"
                        android:background="@drawable/bg_status_dot"
                        android:backgroundTint="?attr/colorAttendanceAbsent" />

                    <TextView
                        style="@style/BodyTextSmallStyle"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="6dp"
                        android:text="Thiếu ca"
                        android:textColor="?attr/colorOnPrimary" />
                </LinearLayout>
            </GridLayout>

        </androidx.constraintlayout.widget.ConstraintLayout>
    </com.google.android.material.card.MaterialCardView>

</androidx.constraintlayout.widget.ConstraintLayout>