<?xml version="1.0" encoding="utf-8"?>
<navigation xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/nav_auth"
    app:startDestination="@id/splashFragment">

    <!-- Màn hình Splash chính -->
    <fragment
        android:id="@+id/splashFragment"
        android:name="com.example.attendanceapp.ui.main.splash.SplashFragment"
        android:label="Splash"
        tools:layout="@layout/fragment_auth_splash">

        <!-- Sang LoginSavedAccount nếu có tk đã lưu -->
        <action
            android:id="@+id/action_splashFragment_to_loginSavedAccountFragment"
            app:destination="@id/loginSavedAccountFragment"
            app:popUpTo="@id/splashFragment"
            app:popUpToInclusive="true" />

        <!-- Sang Login thường -->
        <action
            android:id="@+id/action_splashFragment_to_loginFragment"
            app:destination="@id/loginFragment"
            app:popUpTo="@id/splashFragment"
            app:popUpToInclusive="true" />

        <!-- Sang Onboarding nếu là lần đầu chạy app -->
        <action
            android:id="@+id/action_splashFragment_to_onboardingFragment"
            app:destination="@id/onboardingFragment"
            app:popUpTo="@id/splashFragment"
            app:popUpToInclusive="true" />

        <!-- Sang Màn hình chờ phê duyệt -->
        <action
            android:id="@+id/action_splashFragment_to_pendingApprovalFragment"
            app:destination="@id/pendingApprovalFragment"
            app:popUpTo="@id/splashFragment"
            app:popUpToInclusive="true" />
    </fragment>

    <!-- Màn hình Onboarding / Giới thiệu ban đầu -->
    <fragment
        android:id="@+id/onboardingFragment"
        android:name="com.example.attendanceapp.ui.main.onboarding.OnboardingFragment"
        android:label="Onboarding"
        tools:layout="@layout/fragment_auth_onboarding">

        <action
            android:id="@+id/action_onboardingFragment_to_loginFragment"
            app:destination="@id/loginFragment"
            app:popUpTo="@id/onboardingFragment"
            app:popUpToInclusive="true" />
    </fragment>

    <!-- Màn hình Đăng nhập chính -->
    <fragment
        android:id="@+id/loginFragment"
        android:name="com.example.attendanceapp.ui.main.auth.login.LoginFragment"
        android:label="Đăng nhập"
        tools:layout="@layout/fragment_auth_login">

        <action
            android:id="@+id/action_loginFragment_to_forgotPasswordFragment"
            app:destination="@id/forgotPasswordFragment" />

        <action
            android:id="@+id/action_loginFragment_to_registerFragment"
            app:destination="@id/registerFragment" />

        <action
            android:id="@+id/action_loginFragment_to_pendingApprovalFragment"
            app:destination="@id/pendingApprovalFragment" />
    </fragment>

    <!-- Màn hình Đăng nhập tài khoản đã lưu -->
    <fragment
        android:id="@+id/loginSavedAccountFragment"
        android:name="com.example.attendanceapp.ui.main.auth.login.LoginSavedAccountFragment"
        android:label="Đăng nhập tài khoản đã lưu"
        tools:layout="@layout/fragment_auth_login_saved">

        <action
            android:id="@+id/action_loginSavedAccountFragment_to_forgotPasswordFragment"
            app:destination="@id/forgotPasswordFragment" />

        <action
            android:id="@+id/action_loginSavedAccountFragment_to_loginFragment"
            app:destination="@id/loginFragment" />
    </fragment>

    <!-- Màn hình Đăng ký tài khoản -->
    <fragment
        android:id="@+id/registerFragment"
        android:name="com.example.attendanceapp.ui.main.auth.register.RegisterFragment"
        android:label="Đăng ký"
        tools:layout="@layout/fragment_auth_register">

        <action
            android:id="@+id/action_registerFragment_to_loginFragment"
            app:destination="@id/loginFragment" />
    </fragment>

    <!-- Màn hình Quên mật khẩu -->
    <fragment
        android:id="@+id/forgotPasswordFragment"
        android:name="com.example.attendanceapp.ui.main.auth.forgotpassword.ForgotPasswordFragment"
        android:label="Quên mật khẩu"
        tools:layout="@layout/fragment_auth_forgot_password">

        <action
            android:id="@+id/action_forgotPasswordFragment_to_loginFragment"
            app:destination="@id/loginFragment"
            app:popUpTo="@id/loginFragment"
            app:popUpToInclusive="false" />

        <action
            android:id="@+id/action_forgotPasswordFragment_to_registerFragment"
            app:destination="@id/registerFragment"
            app:popUpTo="@id/loginFragment"
            app:popUpToInclusive="false" />
    </fragment>

    <!-- Màn hình Đang chờ phê duyệt -->
    <fragment
        android:id="@+id/pendingApprovalFragment"
        android:name="com.example.attendanceapp.ui.main.auth.login.PendingApprovalFragment"
        android:label="Đang chờ phê duyệt"
        tools:layout="@layout/fragment_auth_pending_approval">

        <action
            android:id="@+id/action_pendingApprovalFragment_to_loginFragment"
            app:destination="@id/loginFragment"
            app:popUpTo="@id/loginFragment"
            app:popUpToInclusive="true" />

    </fragment>

    <fragment
        android:id="@+id/guestModeFragment"
        android:name="com.example.attendanceapp.ui.main.auth.login.GuestModeFragment"
        android:label="GuestModeFragment"
        tools:layout="@layout/fragment_guest_mode">

        <action
            android:id="@+id/action_guestModeFragment_to_pendingApprovalFragment"
            app:destination="@id/pendingApprovalFragment" />
    </fragment>

</navigation>