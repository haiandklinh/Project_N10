<?xml version="1.0" encoding="utf-8"?>
<navigation xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/nav_manager"
    app:startDestination="@id/managerHomeFragment">

    <!-- ================================================================= -->
    <!-- 1. NHÓM MÀN HÌNH CHÍNH (BOTTOM NAVIGATION DESTINATIONS)          -->
    <!-- ================================================================= -->

    <!-- Tab 1: Trang chủ / Tổng quan (Dashboard) -->
    <fragment
        android:id="@+id/managerHomeFragment"
        android:name="com.example.attendanceapp.ui.manager.home.ManagerHomeFragment"
        android:label="@string/nav_manager_dashboard"
        tools:layout="@layout/fragment_manager_home">

        <action
            android:id="@+id/action_managerHomeFragment_to_notificationFragment"
            app:destination="@id/notificationFragment" />

        <action
            android:id="@+id/action_managerHomeFragment_to_managerProfileFragment"
            app:destination="@id/managerProfileFragment" />

        <action
            android:id="@+id/action_managerHomeFragment_to_managerScheduleFragment"
            app:destination="@id/managerScheduleFragment" />
        <action
            android:id="@+id/action_managerHomeFragment_to_managerApprovalFragment"
            app:destination="@id/managerApprovalFragment" />
        <action
            android:id="@+id/action_managerHomeFragment_to_managerPayrollFragment"
            app:destination="@id/managerPayrollFragment" />
        <action
            android:id="@+id/action_managerHomeFragment_to_managerRewardPunishFragment"
            app:destination="@id/managerRewardPunishFragment" />
        <action
            android:id="@+id/action_managerHomeFragment_to_managerJoinRequestFragment"
            app:destination="@id/managerJoinRequestFragment" />
        <action
            android:id="@+id/action_managerHomeFragment_to_managerStatisticFragment"
            app:destination="@id/managerStatisticFragment" />
    </fragment>

    <fragment
        android:id="@+id/notificationFragment"
        android:name="com.example.attendanceapp.ui.main.common.notification.NotificationFragment"
        android:label="Thông báo"
        tools:layout="@layout/fragment_notification" />

    <!-- Tab 2: Phê duyệt (Approvals) -->
    <fragment
        android:id="@+id/managerApprovalFragment"
        android:name="com.example.attendanceapp.ui.manager.approval.ManagerApprovalFragment"
        android:label="@string/nav_manager_approvals"
        tools:layout="@layout/fragment_manager_approval" />

    <!-- Tab 3: Lịch trình & Quản lý ca làm (Shift Management) -->
    <fragment
        android:id="@+id/managerScheduleFragment"
        android:name="com.example.attendanceapp.ui.manager.schedule.ManagerScheduleFragment"
        android:label="@string/nav_manager_schedule"
        tools:layout="@layout/fragment_manager_schedule" >

        <action
            android:id="@+id/action_managerScheduleFragment_to_selectEmployee"
            app:destination="@id/selectEmployeeFragment" />

    </fragment>

    <fragment
        android:id="@+id/selectEmployeeFragment"
        android:name="com.example.attendanceapp.ui.manager.schedule.select_employee.SelectEmployeeFragment"
        android:label="Chọn nhân viên"
        tools:layout="@layout/fragment_select_employee" >

        <action
            android:id="@+id/action_selectEmployeeFragment_to_assignShiftFragment"
            app:destination="@id/assignShiftFragment" />
    </fragment>

    <fragment
        android:id="@+id/assignShiftFragment"
        android:name="com.example.attendanceapp.ui.manager.schedule.assign.AssignShiftFragment"
        android:label="Thiết lập ca làm việc"
        tools:layout="@layout/fragment_manager_assign_shift" >

        <action
            android:id="@+id/action_assignShiftFragment_to_assignShiftSuccessFragment"
            app:destination="@id/assignShiftSuccessFragment" />
    </fragment>

    <fragment
        android:id="@+id/assignShiftSuccessFragment"
        android:name="com.example.attendanceapp.ui.manager.schedule.assign.AssignShiftSuccessFragment"
        android:label="Thiết lập ca làm việc"
        tools:layout="@layout/fragment_assign_shift_success" />



    <!-- Tab 4: Nhân sự (Employee Management) -->
    <fragment
        android:id="@+id/managerHumanFragment"
        android:name="com.example.attendanceapp.ui.manager.human.ManagerHumanFragment"
        android:label="@string/nav_manager_employees"
        tools:layout="@layout/fragment_manager_human">

        <action
            android:id="@+id/action_managerHumanFragment_to_managerJoinRequestFragment"
            app:destination="@id/managerJoinRequestFragment" />

    </fragment>

    <fragment
        android:id="@+id/managerJoinRequestFragment"
        android:name="com.example.attendanceapp.ui.manager.human.ManagerJoinRequestFragment"
        android:label="Yêu cầu gia nhập"
        tools:layout="@layout/fragment_manager_join_request">

    </fragment>



    <!-- Tab 5: Hồ sơ cá nhân (Profile) -->
    <fragment
        android:id="@+id/managerProfileFragment"
        android:name="com.example.attendanceapp.ui.manager.profile.ManagerProfileFragment"
        android:label="@string/nav_profile"
        tools:layout="@layout/fragment_manager_profile">
        
        <action
            android:id="@+id/action_managerProfileFragment_to_managerStatisticFragment"
            app:destination="@id/managerStatisticFragment" />
        <action
            android:id="@+id/action_managerProfileFragment_to_managerEditProfileFragment"
            app:destination="@id/managerEditProfileFragment" />
        <action
            android:id="@+id/action_managerProfileFragment_to_managerChangePasswordFragment"
            app:destination="@id/managerChangePasswordFragment" />
        <action
            android:id="@+id/action_managerProfileFragment_to_managerHelpCenterFragment"
            app:destination="@id/managerHelpCenterFragment" />
        <action
            android:id="@+id/action_managerProfileFragment_to_managerAboutFragment"
            app:destination="@id/managerAboutFragment" />
        <action
            android:id="@+id/action_managerProfileFragment_to_managerSalaryConfigFragment"
            app:destination="@id/managerSalaryConfigFragment" />
    </fragment>


    <!-- ================================================================= -->
    <!-- 2. NHÓM MÀN HÌNH CHI TIẾT & CHỨC NĂNG PHỤ (FULLSCREEN DESTINATIONS) -->
    <!-- ================================================================= -->

    <!-- Quản lý Tiền Lương -->
    <fragment
        android:id="@+id/managerPayrollFragment"
        android:name="com.example.attendanceapp.ui.manager.payroll.ManagerPayrollFragment"
        android:label="Quản lý tiền lương"
        tools:layout="@layout/fragment_manager_payroll">
        <action
            android:id="@+id/action_managerPayrollFragment_to_managerPayrollDetailFragment"
            app:destination="@id/managerPayrollDetailFragment" />
    </fragment>

    <!-- Thiết lập đơn giá ca -->
    <fragment
        android:id="@+id/managerSalaryConfigFragment"
        android:name="com.example.attendanceapp.ui.manager.profile.ManagerSalaryConfigFragment"
        android:label="Thiết lập đơn giá ca"
        tools:layout="@layout/fragment_manager_salary_config" />

    <!-- Chi tiết tính lương nhân sự -->
    <fragment
        android:id="@+id/managerPayrollDetailFragment"
        android:name="com.example.attendanceapp.ui.manager.payroll.ManagerPayrollDetailFragment"
        android:label="Chi tiết tính lương"
        tools:layout="@layout/fragment_manager_payroll_detail" />

    <!-- Ghi nhận Thưởng Phạt -->
    <fragment
        android:id="@+id/managerRewardPunishFragment"
        android:name="com.example.attendanceapp.ui.manager.reward.ManagerRewardPunishFragment"
        android:label="Quyết định thưởng phạt"
        tools:layout="@layout/fragment_manager_reward_punish" />

    <!-- Danh sách phê duyệt yêu cầu tham gia công ty -->
    <fragment
        android:id="@+id/managerJoinRequestFragment"
        android:name="com.example.attendanceapp.ui.manager.human.ManagerJoinRequestFragment"
        android:label="Yêu cầu tham gia"
        tools:layout="@layout/fragment_manager_join_request" />

    <!-- Báo cáo Thống kê đồ thị -->
    <fragment
        android:id="@+id/managerStatisticFragment"
        android:name="com.example.attendanceapp.ui.manager.statistic.ManagerStatisticFragment"
        android:label="Báo cáo thống kê"
        tools:layout="@layout/fragment_manager_statistic" />

    <!-- Chỉnh sửa hồ sơ Quản lý -->
    <fragment
        android:id="@+id/managerEditProfileFragment"
        android:name="com.example.attendanceapp.ui.manager.profile.ManagerEditProfileFragment"
        android:label="Chỉnh sửa hồ sơ"
        tools:layout="@layout/fragment_edit_profile">
        <action
            android:id="@+id/action_managerEditProfileFragment_to_managerEditBasicInfoFragment"
            app:destination="@id/managerEditBasicInfoFragment" />
    </fragment>

    <fragment
        android:id="@+id/managerEditBasicInfoFragment"
        android:name="com.example.attendanceapp.ui.manager.profile.ManagerEditBasicInfoFragment"
        android:label="Thông tin cá nhân"
        tools:layout="@layout/fragment_edit_basic_info" />

    <!-- Đổi mật khẩu Quản lý -->
    <fragment
        android:id="@+id/managerChangePasswordFragment"
        android:name="com.example.attendanceapp.ui.manager.profile.ManagerChangePasswordFragment"
        android:label="Đổi mật khẩu"
        tools:layout="@layout/fragment_change_password" />

    <!-- Trung tâm trợ giúp & Câu hỏi thường gặp -->
    <fragment
        android:id="@+id/managerHelpCenterFragment"
        android:name="com.example.attendanceapp.ui.manager.profile.ManagerHelpCenterFragment"
        android:label="Trung tâm trợ giúp"
        tools:layout="@layout/fragment_help_center" />

    <!-- Màn hình Giới thiệu ứng dụng -->
    <fragment
        android:id="@+id/managerAboutFragment"
        android:name="com.example.attendanceapp.ui.manager.profile.ManagerAboutFragment"
        android:label="Giới thiệu ứng dụng"
        tools:layout="@layout/fragment_about">
        <action
            android:id="@+id/action_managerAboutFragment_to_managerPolicyFragment"
            app:destination="@id/managerPolicyFragment" />
    </fragment>

    <!-- Chính sách bảo mật & Điều khoản sử dụng -->
    <fragment
        android:id="@+id/managerPolicyFragment"
        android:name="com.example.attendanceapp.ui.employee.profile.EmployeePolicyFragment"
        android:label="Chính sách &amp; Điều khoản"
        tools:layout="@layout/fragment_policy" />

</navigation>
