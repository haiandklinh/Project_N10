        <item name="colorAttendancePresentContainer">@color/attendance_present_container_dark</item>

        <item name="colorAttendanceLate">@color/attendance_late_dark</item>
        <item name="colorAttendanceLateContainer">@color/attendance_late_container_dark</item>

        <item name="colorAttendanceAbsent">@color/attendance_absent_dark</item>
        <item name="colorAttendanceAbsentContainer">@color/attendance_absent_container_dark</item>

        <item name="colorAttendanceLeave">@color/attendance_leave_dark</item>
        <item name="colorAttendanceLeaveContainer">@color/attendance_leave_container_dark</item>

        <item name="colorAttendanceNotChecked">@color/attendance_not_checked_dark</item>
        <item name="colorAttendanceNotCheckedContainer">@color/attendance_not_checked_container_dark</item>

        <item name="colorAttendanceWeekend">@color/attendance_weekend_dark</item>
        <item name="colorAttendanceWeekendContainer">@color/attendance_weekend_container_dark</item>

        <item name="colorAttendanceEarlyLeave">@color/attendance_early_leave_dark</item>
        <item name="colorAttendanceEarlyLeaveContainer">@color/attendance_early_leave_container_dark</item>

        <!-- Card Background Colors -->
        <item name="colorAttendancePresentCard">@color/attendance_present_card_dark</item>
        <item name="colorAttendanceLateCard">@color/attendance_late_card_dark</item>
        <item name="colorAttendanceAbsentCard">@color/attendance_absent_card_dark</item>
        <item name="colorAttendanceLeaveCard">@color/attendance_leave_card_dark</item>
        <item name="colorAttendanceNotCheckedCard">@color/attendance_not_checked_card_dark</item>
        <item name="colorAttendanceWeekendCard">@color/attendance_weekend_card_dark</item>
        <item name="colorAttendanceEarlyLeaveCard">@color/attendance_early_leave_card_dark</item>
