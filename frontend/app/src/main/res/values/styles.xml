<?xml version="1.0" encoding="utf-8"?>
<resources>

    <!-- ==================== SHAPE STYLES (CẤU HÌNH BO GÓC) ==================== -->

    <style name="ShapeAppearance.App.SmallComponent" parent="ShapeAppearance.Material3.Corner.Small">
        <item name="cornerSize">@dimen/radius_s</item>
    </style>

    <style name="ShapeAppearance.App.MediumComponent" parent="ShapeAppearance.Material3.Corner.Medium">
        <item name="cornerSize">@dimen/radius_m</item>
    </style>

    <style name="ShapeAppearance.App.LargeComponent" parent="ShapeAppearance.Material3.Corner.Large">
        <item name="cornerSize">@dimen/radius_l</item>
    </style>

    <style name="ShapeAppearance.App.Circle" parent="ShapeAppearance.Material3.Corner.Full">
        <item name="cornerSize">50%</item>
    </style>


    <!-- ==================== CARDS WITH STATES (Normal, Selected, Disabled, Loading) ==================== -->

    <!-- Card chính / Container tổng -->
    <style name="MainCard">
        <item name="cardBackgroundColor">?attr/colorSurface</item>
        <item name="cardCornerRadius">@dimen/radius_l</item>
        <item name="cardElevation">@dimen/elevation_none</item>
        <item name="strokeWidth">0dp</item>
    </style>

    <!-- Card Item có State (Normal, Selected/Checked, Disabled) -->
    <style name="ItemCard" parent="Widget.Material3.CardView.Filled">
        <item name="cardBackgroundColor">?attr/colorSurface</item>
        <item name="cardCornerRadius">@dimen/radius_m</item>
        <item name="cardElevation">@dimen/elevation_none</item>
        <item name="strokeColor">@color/card_stroke_selector</item>
        <item name="strokeWidth">@dimen/border_none</item>
        <item name="android:clickable">true</item>
        <item name="android:focusable">true</item>
    </style>

    <!-- Card Trong suot -->
    <style name="WaterCard" parent="Widget.Material3.CardView.Filled">
        <item name="cardBackgroundColor">#25FFFFFF</item>
        <item name="cardCornerRadius">@dimen/radius_m</item>
        <item name="cardElevation">@dimen/elevation_none</item>
        <item name="strokeColor">@color/card_stroke_selector</item>
        <item name="strokeWidth">@dimen/border_none</item>
        <item name="android:clickable">false</item>
        <item name="android:focusable">false</item>
    </style>

    <!-- Card Danh mục (Category / Quick Action) -->
    <style name="CategoryCard" parent="Widget.Material3.CardView.Filled">
        <item name="cardBackgroundColor">?attr/colorSurfaceVariant</item>
        <item name="cardCornerRadius">@dimen/radius_l</item>
        <item name="cardElevation">@dimen/elevation_none</item>
        <item name="strokeWidth">0dp</item>
        <item name="android:clickable">true</item>
        <item name="android:focusable">true</item>
    </style>

    <!-- Card View Icon bo góc  -->
    <style name="IconViewCard" parent="Widget.Material3.CardView.Filled">
        <item name="cardBackgroundColor">?attr/colorSurfaceVariant</item>
        <item name="cardCornerRadius">@dimen/radius_m</item>
        <item name="cardElevation">@dimen/elevation_none</item>
        <item name="strokeWidth">0dp</item>
        <item name="android:clickable">false</item>
        <item name="android:focusable">false</item>
    </style>

    <!-- Card Icon tròn -->
    <style name="RadiusItemCard" parent="Widget.Material3.CardView.Filled">
        <item name="cardBackgroundColor">?attr/colorPrimaryContainer</item>
        <item name="cardCornerRadius">@dimen/radius_full</item>
        <item name="cardElevation">@dimen/elevation_none</item>
        <item name="strokeWidth">0dp</item>
        <item name="android:clickable">true</item>
        <item name="android:focusable">true</item>
    </style>

    <style name="CircleIconCardStyle" parent="Widget.Material3.CardView.Filled">
        <item name="cardBackgroundColor">?attr/colorPrimaryContainer</item>
        <item name="cardCornerRadius">22dp</item>
        <item name="cardElevation">0dp</item>
        <item name="strokeWidth">0dp</item>
        <item name="android:clickable">true</item>
        <item name="android:focusable">true</item>
        <item name="android:foreground">?attr/selectableItemBackground</item>
    </style>



    <!-- ==================== EDITTEXT / INPUT / SEARCH WITH STATES ==================== -->

    <!-- Ô tìm kiếm (Search Field: Empty, Typing, Has Result, Loading) -->
    <style name="SearchStyle" parent="@style/AppTextInputLayout">
        <item name="boxCornerRadiusTopStart">@dimen/radius_full</item>
        <item name="boxCornerRadiusTopEnd">@dimen/radius_full</item>
        <item name="boxCornerRadiusBottomStart">@dimen/radius_full</item>
        <item name="boxCornerRadiusBottomEnd">@dimen/radius_full</item>
        <item name="startIconDrawable">@drawable/ic_search</item>
        <item name="startIconTint">?attr/colorOnSurfaceVariant</item>
        <item name="endIconMode">clear_text</item> <!-- Bật nút xóa chữ khi typing -->
        <item name="endIconTint">?attr/colorOnSurfaceVariant</item>

        <!-- Tắt đẩy chữ -->
        <item name="hintEnabled">false</item>
        <item name="expandedHintEnabled">false</item>
    </style>

    <style name="AppTextInputLayout" parent="Widget.MaterialComponents.TextInputLayout.OutlinedBox">
        <item name="boxBackgroundMode">outline</item>
        <item name="boxCornerRadiusTopStart">16dp</item>
        <item name="boxCornerRadiusTopEnd">16dp</item>
        <item name="boxCornerRadiusBottomStart">16dp</item>
        <item name="boxCornerRadiusBottomEnd">16dp</item>
        <item name="boxBackgroundColor">?attr/colorSurfaceVariant</item>
        <!-- Áp dụng Color State List -->
        <item name="boxStrokeColor">@color/sl_text_input_stroke</item>
        <!-- Màu Start Icon -->
        <item name="startIconTint">@color/sl_text_input_stroke</item>
        <item name="endIconTint">@color/sl_text_input_stroke</item>
        <item name="hintTextColor">?attr/colorPrimary</item>
        <item name="errorIconTint">?attr/colorError</item>
        <item name="errorTextColor">?attr/colorError</item>
        <item name="boxStrokeErrorColor">?attr/colorError</item>
    </style>

    <style name="AppTextInputEditText">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:textSize">14sp</item>
        <item name="android:textColor">?attr/colorPrimary</item>
    </style>

    <!-- Spinner (Exposed Dropdown Menu) - Đã đồng bộ với TextInputLayoutStyle -->
    <style name="SpinnerStyle" parent="Widget.Material3.TextInputLayout.OutlinedBox.ExposedDropdownMenu">
        <item name="boxBackgroundMode">outline</item>
        <item name="shapeAppearanceOverlay">@style/ShapeAppearance.App.MediumComponent</item>
        <item name="boxBackgroundColor">?attr/colorSurfaceVariant</item>
        <item name="boxStrokeColor">@color/sl_text_input_stroke</item>
        <item name="boxStrokeWidth">1dp</item>
        <item name="boxStrokeWidthFocused">2dp</item>
        <!-- Tint Icons -->
        <item name="startIconTint">@color/sl_text_input_stroke</item>
        <item name="endIconTint">@color/sl_text_input_stroke</item>
        <item name="errorIconTint">?attr/colorError</item>
        <!-- Text Colors -->
        <item name="hintTextColor">?attr/colorPrimary</item>
        <item name="android:textColorHint">?attr/colorOnSurfaceVariant</item>
        <item name="errorTextColor">?attr/colorError</item>
        <item name="boxStrokeErrorColor">?attr/colorError</item>
        <item name="counterTextColor">?attr/colorOnSurfaceVariant</item>
        <item name="counterOverflowTextColor">?attr/colorError</item>
    </style>

    <!-- 1. Style cho TextInputLayout (Khung bên ngoài) -->
    <style name="AppTextInputLayout.Otp">
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_height">56dp</item>
        <item name="android:layout_weight">1</item>
        <item name="boxCornerRadiusTopStart">12dp</item>
        <item name="boxCornerRadiusTopEnd">12dp</item>
        <item name="boxCornerRadiusBottomStart">12dp</item>
        <item name="boxCornerRadiusBottomEnd">12dp</item>

        <!-- Tắt đẩy chữ -->
        <item name="hintEnabled">false</item>
        <item name="expandedHintEnabled">false</item>

        <!-- BẬT SẴN ERROR CỦA MATERIAL -->
        <item name="errorEnabled">true</item>
        <item name="errorIconDrawable">@null</item> <!-- Bỏ icon chấm cảm đỏ bên trong ô cho đỡ chật -->
        <item name="boxStrokeErrorColor">?attr/colorError</item>
    </style>

    <!-- 2. Style cho TextInputEditText (Chữ/Số nhập bên trong) -->
    <style name="OtpEditTextStyle">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">match_parent</item>
        <item name="android:gravity">center</item>
        <item name="android:inputType">number</item>
        <item name="android:maxLength">1</item>
        <item name="android:padding">0dp</item> <!-- Căn giữa tuyệt đối -->
        <item name="android:textSize">20sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textColor">?attr/colorOnSurface</item>
    </style>

    <!-- ==================== BUTTONS WITH STATES ==================== -->

    <style name="ButtonMaxWidthStyle" parent="Widget.Material3.Button">
        <!-- Cấu hình độ cao và bỏ lề ẩn (Inset) -->
        <item name="android:minHeight">@dimen/button_height_default</item>
        <item name="android:insetTop">0dp</item>
        <item name="android:insetBottom">0dp</item>
        <item name="android:insetLeft">0dp</item>
        <item name="android:insetRight">0dp</item>
        <item name="cornerRadius">@dimen/radius_m</item>
        <item name="rippleColor">?attr/colorPrimaryContainer</item>
        <item name="strokeWidth">0dp</item>
        <item name="android:textColor">?attr/colorOnPrimary</item>
        <item name="android:textSize">@dimen/text_size_label_large</item>
        <item name="android:textStyle">bold</item>
        <item name="android:paddingStart">@dimen/spacing_l</item>
        <item name="android:paddingEnd">@dimen/spacing_l</item>
        <item name="android:paddingTop">0dp</item>
        <item name="android:paddingBottom">0dp</item>
        <item name="android:elevation">@dimen/elevation_s</item>
    </style>


    <!-- ==================== BASE ==================== -->

    <style name="ButtonFilledSmallStyle" parent="Widget.Material3.Button">
        <item name="android:minWidth">0dp</item>
        <item name="android:minHeight">@dimen/button_height_m</item>
        <item name="android:insetTop">0dp</item>
        <item name="android:insetBottom">0dp</item>
        <item name="android:insetLeft">0dp</item>
        <item name="android:insetRight">0dp</item>
        <item name="cornerRadius">@dimen/radius_s</item>
        <item name="strokeWidth">0dp</item>
        <item name="rippleColor">?attr/colorPrimaryContainer</item>
        <item name="android:textColor">?attr/colorOnPrimary</item>
        <item name="android:textSize">@dimen/text_size_label_medium</item>
        <item name="android:textStyle">bold</item>
        <item name="android:paddingStart">@dimen/spacing_m</item>
        <item name="android:paddingEnd">@dimen/spacing_m</item>
        <item name="android:paddingTop">0dp</item>
        <item name="android:paddingBottom">0dp</item>
        <item name="android:elevation">@dimen/elevation_s</item>
    </style>


    <style name="ButtonOutlinedSmallStyle" parent="Widget.Material3.Button.OutlinedButton">
        <item name="android:minWidth">0dp</item>
        <item name="android:minHeight">@dimen/button_height_m</item>

        <!-- Bỏ khoảng lề thừa mặc định của Material Button -->
        <item name="android:insetTop">0dp</item>
        <item name="android:insetBottom">0dp</item>
        <item name="android:insetLeft">0dp</item>
        <item name="android:insetRight">0dp</item>

        <!-- Các thuộc tính Material Design chuẩn -->
        <item name="cornerRadius">@dimen/radius_s</item>
        <item name="strokeWidth">1dp</item>
        <item name="strokeColor">?attr/colorPrimary</item>

        <!-- Kích thước & Kiểu chữ -->
        <item name="android:textSize">@dimen/text_size_label_medium</item>
        <item name="android:textStyle">bold</item>

        <!-- Padding bên trong nút -->
        <item name="android:paddingStart">@dimen/spacing_m</item>
        <item name="android:paddingEnd">@dimen/spacing_m</item>
        <item name="android:paddingTop">0dp</item>
        <item name="android:paddingBottom">0dp</item>

        <!-- Thuộc tính hỗ trợ tương tác -->
        <item name="android:clickable">true</item>
        <item name="android:focusable">true</item>
    </style>


    <!-- ==================== IMAGE VIEWS ==================== -->

    <style name="ImageLargeStyle">
        <item name="shapeAppearanceOverlay">@style/ShapeAppearance.App.LargeComponent</item>
        <item name="android:scaleType">centerCrop</item>
    </style>

    <style name="ImageSmallStyle">
        <item name="shapeAppearanceOverlay">@style/ShapeAppearance.App.SmallComponent</item>
        <item name="android:scaleType">centerCrop</item>
    </style>

    <style name="ImageCircleStyle"
        parent="ShapeAppearance.Material3.Corner.Full">
        <item name="cornerSize">50%</item>
    </style>

    <!-- Style bo tròn nền viên thuốc chọn -->
    <style name="CustomActiveIndicator" parent="Widget.Material3.BottomNavigationView.ActiveIndicator">
        <item name="android:drawable">@drawable/bg_bottom_item_selected</item>
        <item name="android:width">80dp</item>
        <item name="android:height">54dp</item>
    </style>

    <!-- ==================== EXTRA COMMON STYLES ==================== -->
    <style name="ChipFilterStyle" parent="Widget.Material3.Chip.Filter">
        <item name="chipCornerRadius">@dimen/radius_full</item>
        <item name="android:textSize">@dimen/text_size_label_medium</item>
        <item name="android:textColor">@color/filter_chip_text_selector</item>
        <item name="chipBackgroundColor">@color/filter_chip_bg_selector</item>
        <item name="chipStrokeColor">?attr/colorSecondary</item>
        <item name="chipStrokeWidth">1dp</item>
        <item name="showMotionSpec">@null</item>
        <item name="hideMotionSpec">@null</item>
        <item name="checkedIconVisible">false</item>
    </style>

    <style name="ChipStatusStyle" parent="Widget.Material3.Chip.Assist">
        <item name="chipCornerRadius">@dimen/radius_full</item>
        <item name="android:textSize">@dimen/text_size_label_small</item>
        <item name="android:textStyle">bold</item>
        <item name="chipStrokeWidth">0dp</item>
        <item name="chipBackgroundColor">?attr/colorPrimaryContainer</item>
        <item name="android:textColor">?attr/colorPrimary</item>
        <item name="chipIconVisible">false</item>
        <item name="android:clickable">false</item>
        <item name="android:focusable">false</item>
        <item name="chipMinTouchTargetSize">0dp</item>
        <!-- 2. Bỏ chiều cao tối thiểu mặc định (32dp/48dp) -->
        <item name="chipMinHeight">26dp</item>
        <!-- 3. Triệt tiêu toàn bộ inset & margin nội bộ -->
        <item name="chipStartPadding">8dp</item>
        <item name="chipEndPadding">8dp</item>
        <item name="android:insetTop">0dp</item>
        <item name="android:insetBottom">0dp</item>
        <item name="android:insetLeft">0dp</item>
        <item name="android:insetRight">0dp</item>
    </style>

    <!--Divider-->
    <style name="DividerStyle">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">@dimen/divider_height</item>
        <item name="android:background">?attr/colorOutline</item>
    </style>

    <!-- SWITCH-->
    <style name="SwitchStyle" parent="Widget.Material3.CompoundButton.MaterialSwitch">
        <!-- Track khi bật / tắt -->
        <item name="trackTint">@color/filter_chip_bg_selector</item>
        <!-- Thumb (nút tròn) khi bật / tắt -->
        <item name="thumbTint">@color/filter_chip_text_selector</item>
        <item name="trackHeight">22dp</item>
        <item name="thumbIconSize">14dp</item>

        <!-- Bỏ vùng touch-target ẩn khiến row bị cao hơn -->
        <item name="android:minHeight">0dp</item>
        <item name="android:minWidth">0dp</item>
        <item name="switchMinWidth">0dp</item>
        <item name="switchPadding">0dp</item>
    </style>

    <!--FAB-->
    <style name="FabStyle">
        <item name="android:layout_width">56dp</item>
        <item name="android:layout_height">56dp</item>
        <item name="backgroundTint">?attr/colorPrimary</item>
        <item name="tint">?attr/colorOnPrimary</item>
        <item name="shapeAppearanceOverlay">@style/ImageCircleStyle</item>
        <item name="elevation">@dimen/elevation_none</item>
        <item name="rippleColor">?attr/colorPrimaryContainer</item>
        <item name="strokeWidth">0dp</item>
    </style>


    <!-- ==================== TYPOGRAPHY STYLES (6 LOẠI CHUẨN M3) ==================== -->

    <!-- 1. Tiêu đề lớn nhất màn hình (Screen Title, Header chính) -->
    <style name="TitleTextLargeStyle">
        <item name="android:textSize">@dimen/text_size_title_large</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textColor">?attr/colorOnSurface</item>
    </style>

    <!-- 2. Tiêu đề vừa (Section Header, Card Title) -->
    <style name="TitleTextMediumStyle">
        <item name="android:textSize">@dimen/text_size_title_medium</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textColor">?attr/colorOnSurface</item>
    </style>

    <style name="TitleTextSmallStyle">
        <item name="android:textSize">@dimen/text_size_title_small</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textColor">?attr/colorOnSurface</item>
    </style>


    <!-- 3. Nội dung chính / Tên item trong danh sách -->
    <style name="BodyTextLargeStyle">
        <item name="android:textSize">@dimen/text_size_body_large</item>
        <item name="android:textStyle">normal</item>
        <item name="android:textColor">?attr/colorOnSurface</item>
    </style>

    <!-- 4. Nội dung vừa (Item Subtitle, Check-in / Check-out Label) -->
    <style name="BodyTextMediumStyle">
        <item name="android:textSize">@dimen/text_size_body_medium</item>
        <item name="android:textStyle">normal</item>
        <item name="android:textColor">?attr/colorOnSurfaceVariant</item>
    </style>

    <!-- 5. Chữ chú thích nhỏ / Mô tả phụ / Ngày tháng phụ -->
    <style name="BodyTextSmallStyle">
        <item name="android:textSize">@dimen/text_size_body_small</item>
        <item name="android:textStyle">normal</item>
        <item name="android:textColor">?attr/colorOnSurfaceVariant</item>
    </style>

</resources>