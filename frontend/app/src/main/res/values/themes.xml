    <!-- BASE THEME: Chứa cấu hình dùng chung (Chấm công, Error, Status Bar) -->
    <style name="Base.Theme.AttendanceApp" parent="Theme.Material3.DayNight.NoActionBar">
        <!-- Status bar configuration -->
        <item name="android:statusBarColor">?android:attr/colorBackground</item>
        <item name="android:windowLightStatusBar">true</item>

        <!-- Outline & Error (Dùng chung) -->
        <item name="colorError">@color/md_theme_light_error</item>
        <item name="colorOnError">@color/md_theme_light_onError</item>
        <item name="colorErrorContainer">@color/md_theme_light_errorContainer</item>
        <item name="colorOnErrorContainer">@color/md_theme_light_onErrorContainer</item>

        <!-- ==================== ATTENDANCE STATUS (DÙNG CHUNG) ==================== -->
        <item name="colorAttendancePresent">@color/attendance_present</item>
        <item name="colorAttendancePresentContainer">@color/attendance_present_container</item>

        <item name="colorAttendanceLate">@color/attendance_late</item>
        <item name="colorAttendanceLateContainer">@color/attendance_late_container</item>

        <item name="colorAttendanceAbsent">@color/attendance_absent</item>
        <item name="colorAttendanceAbsentContainer">@color/attendance_absent_container</item>

        <item name="colorAttendanceLeave">@color/attendance_leave</item>
        <item name="colorAttendanceLeaveContainer">@color/attendance_leave_container</item>

        <item name="colorAttendanceNotChecked">@color/attendance_not_checked</item>
        <item name="colorAttendanceNotCheckedContainer">@color/attendance_not_checked_container</item>

        <item name="colorAttendanceWeekend">@color/attendance_weekend</item>
        <item name="colorAttendanceWeekendContainer">@color/attendance_weekend_container</item>

        <item name="colorAttendanceEarlyLeave">@color/attendance_early_leave</item>
        <item name="colorAttendanceEarlyLeaveContainer">@color/attendance_early_leave_container</item>

        <!-- Card Background Colors -->
        <item name="colorAttendancePresentCard">@color/attendance_present_card</item>
        <item name="colorAttendanceLateCard">@color/attendance_late_card</item>
        <item name="colorAttendanceAbsentCard">@color/attendance_absent_card</item>
        <item name="colorAttendanceLeaveCard">@color/attendance_leave_card</item>
        <item name="colorAttendanceNotCheckedCard">@color/attendance_not_checked_card</item>
        <item name="colorAttendanceWeekendCard">@color/attendance_weekend_card</item>
        <item name="colorAttendanceEarlyLeaveCard">@color/attendance_early_leave_card</item>
    </style>

